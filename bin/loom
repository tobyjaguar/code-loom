#!/usr/bin/env bash
# loom — the Loom agent harness dispatcher.
#
# One task = one worktree = one branch = one reviewable diff.
# Your working tree is never touched by an agent.
#
#   loom plan  "streaming resampler"   architect session (Claude sub via `claude`)
#   loom plan -p "topic"               headless plan (falls back to cheap providers)
#   loom scout "where is decode_flac"  one-shot cheap read-only lookup
#   loom new   0007-c                  create worktree + branch for a task
#   loom run   0007-c                  run the implementer in that worktree
#   loom check 0007-c                  cheap cross-provider review of the diff
#   loom loop  0007-c                  run, review, feed REVISE back, review again
#   loom diff  0007-c                  write the task diff, then show it (pager, or $LOOM_DIFF_CMD)
#   loom land  0007-c                  gate, merge, clean up, tick the checkbox
#   loom land  0007-c --pr             gate, push agent/0007-c, print PR next steps
#   loom drop  0007-c [--keep-branch]  discard worktree (and branch, unless kept)
#   loom rebase 0007-c                 rebase the branch onto origin/main; re-point its diff base
#   loom rebase 0007-c --accept-upstream   ... even when what arrives under the
#                                    base touches a fenced or hand-zone path
#   loom ls                            list active agent worktrees
#   loom gate                          run the gate here
#   loom pin-config [--accept-config]  record (or re-record) the REPOSITORY's
#                                    git config baseline — the one `loom plan`
#                                    and `loom scout` are judged against, since
#                                    neither has a task record. `loom new`
#                                    writes it too; this is the command for a
#                                    repository with no tasks, and for saying
#                                    "that change is mine" deliberately.
#   loom zone  <path>                  which zone a path belongs to
#   loom tier  lean|standard|deep      print export line for the model tier
#   loom doctor                        verify binaries, keys, and MODEL IDS
#   loom guard                         pre-commit zone check (used by the hook)
#   loom install-hooks                 install the hand-zone commit guard
#
#   --fence-profile <name>           REQUIRED on new, run, check, loop, diff,
#                                    rebase and land for a task under a fence
#                                    profile, every time. The patterns the
#                                    profile releases stay in the worktree, and
#                                    every model that runs there must be one
#                                    the profile allows. Its worktree lives
#                                    under a separate root ($LOOM_WORKTREES
#                                    with "-profiled" appended). The operator
#                                    record only checks your flag; it never
#                                    replaces it, and a missing record is a
#                                    refusal, not something loom infers from the
#                                    worktree. (README § Fence profiles)
#
# Env:
#   LOOM_TIER=lean|standard|deep   model tier            (default standard)
#   LOOM_SKIP="zai deepseek"       providers to skip     (claude|zai|moonshotai|deepseek)
#   LOOM_MAX_ATTEMPTS=3            implementer gate retries
#   LOOM_LOOP_ROUNDS=2             review rounds in `loom loop`
#   LOOM_MODELS_<role>="m1 m2"     replace one role's chain outright
#   LOOM_CLAUDE_ALLOWED_TOOLS=...  what an implementer on claude-sub may run
#                                  in a shell (default: the gate script only)
#   LOOM_WORKTREES=/path           where worktrees live
#   LOOM_LAND=merge|pr             land by merging here, or by pushing a branch
#                                  for review (--pr / --merge win over this)
#   LOOM_DIFF_CMD="delta"          how `loom diff` shows a patch; the patch path
#                                  is appended. Default: the patch streams,
#                                  UNPAGED (`core.pager` is a program git runs,
#                                  and it lives in the shared .git/config — set
#                                  LOOM_DIFF_CMD="less -R" for a pager). Split
#                                  on whitespace, no quoting — wrap a path with
#                                  spaces in a one-line script.
#   LOOM_ENV=<file>                provider keys, sourced if present
#                                  (default ~/.config/loom/env)
#
# Operator task state — outside every repo and outside the shared .git, because
# everything under .git/ (config AND refs) is writable from any linked worktree:
#
#   ${XDG_CONFIG_HOME:-~/.config}/loom/repos/<sha256 of the repo's real path>/
#       repo                       the repo path, so the directory is readable
#       tasks/<task>               base=<commit> profile=<name> branch=<br>
#                                  created=<iso> reviewed=<sha> origin=<url>
#                                  fetch=<remote.origin.fetch>
#                                  pushurl=<the push URL of origin>
#                                  config=<sha256 of the repo's git config: the
#                                  local scope, BOTH worktree scopes, and every
#                                  file their include.path/includeIf pull in>
#       tasks/<task>.gitconfig     that config in full — one NUL-terminated
#                                  record per entry, each tagged with the scope
#                                  it came from (local: / worktree-main: /
#                                  worktree-task:) plus one
#                                  `include:<path>:<sha256>` line per included
#                                  file — so a mismatch can be shown as a diff
#                                  rather than two digests
#
# `loom new` writes it, `loom rebase` re-points its base, `loom check` stamps the tip
# it had reviewed, `loom drop` deletes it, and every security check (and `loom ls`)
# reads it. Mode 0700/0600.
#
#   --accept-config                  accepted by run, check, loop, diff, rebase
#                                    and land; REFUSED by `new`, which is the
#                                    command that pins and so has nothing to
#                                    accept. The repository's git config — the
#                                    local scope, both worktree scopes and the
#                                    include closure — is pinned at `loom new`
#                                    and re-checked BEFORE the first fence
#                                    operation of every command, and again
#                                    before every model launch, fetch, push,
#                                    merge, replay and review patch; a change is
#                                    a refusal, and this flag prints what changed
#                                    and re-records it as the new baseline. loom
#                                    itself never writes config on your behalf
#                                    beyond its own sparse-checkout setup and
#                                    `land --pr`'s upstream, so an agent's
#                                    `git config user.name` in its worktree WILL
#                                    trip this. That is the intended shape:
#                                    .git/config is shared. `loom drop` does not
#                                    check it — see the pin's own comment.
#
# Anthropic policy: subscription only, on purpose. The architect runs through
# the `claude` CLI (your Claude Code login). There is no ANTHROPIC_API_KEY
# anywhere in this system. When the subscription is rate-limited, roles fall
# back to cheap providers instead of an expensive API bill.

set -euo pipefail

# This script's own path, resolved BEFORE the cd below: `loom help` prints the
# header block by reading the file back, and a relative `$0` ("./bin/loom",
# "../bin/loom") stops resolving the moment we cd to $ROOT — which now happens
# whenever the command is typed anywhere but the main checkout's root.
SELF="$0"
case "$SELF" in
  /*)  ;;
  */*) SELF="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd -P)/$(basename "$SELF")" ;;
  *)   SELF="$(command -v "$SELF" 2>/dev/null || printf '%s' "$SELF")" ;;
esac

# ------------------------------------------------- the root is the MAIN checkout
# Every file this dispatcher reads POLICY from — .agents/zones.toml (the zones,
# the fence and its profiles), .agents/loom.env, .agents/gate.sh, .opencode/ —
# comes from the MAIN checkout, and never from the tree the command happened to
# be typed in. An agent worktree carries its own copy of all of them, and every
# one of those copies is a file the agent writes: `cd $WT_ROOT/0007-c && loom new
# t5` would otherwise fence the new task with the agent's zones.toml (i.e. not
# at all) and source the agent's loom.env as shell, in your environment.
#
# `git rev-parse --git-common-dir` answers `.git` from the main checkout and the
# ABSOLUTE path of the main `.git` from a linked worktree, so its parent is the
# main checkout either way. That is the same derivation the operator record is
# keyed by, which is what lets the pre-commit guard — running inside an agent's
# worktree — read the record `loom new` wrote.
#
# One thing does still come from the invoking tree, and only one:
# `loom guard`'s subject. The guard judges the commit that is happening HERE, so
# it reads the staged files and the tree of $INVOKED_ROOT while reading the
# policy it judges them by from $ROOT. That is the whole of the split.
INVOKED_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "loom: not inside a git repository" >&2; exit 1; }
cd "$INVOKED_ROOT"
INVOKED_ROOT="$(pwd -P)"
_common="$(git rev-parse --git-common-dir 2>/dev/null)" || {
  echo "loom: cannot resolve this repository's git directory" >&2; exit 1; }
[ -n "$_common" ] || {
  echo "loom: cannot resolve this repository's git directory" >&2; exit 1; }
ROOT="$(cd "$(dirname "$_common")" 2>/dev/null && pwd -P)" || {
  echo "loom: cannot resolve this repository's main checkout — refusing to guess where
the zones, the fence and the operator record live" >&2; exit 1; }
# The SHARED git directory itself, absolute. It is where the config FILES that
# the pin reads live: `$GITCOMMON/config` (the `--local` scope) and
# `$GITCOMMON/config.worktree` (the `--worktree` scope of the MAIN checkout,
# read whenever `extensions.worktreeConfig` is on — which loom's own
# `git sparse-checkout init` turns on). A linked worktree's own
# `config.worktree` lives under `$GITCOMMON/worktrees/<name>/`, and is reached
# through `git -C <worktree>` rather than by spelling that path out.
GITCOMMON="$(cd "$(dirname "$_common")" 2>/dev/null && pwd -P)/$(basename "$_common")" || {
  echo "loom: cannot resolve this repository's shared git directory" >&2; exit 1; }
unset _common
cd "$ROOT"
# The repo's PHYSICAL path, for comparing against the worktree roots below.
# $ROOT came out of `pwd -P`, so this is the same string; it is kept as its own
# name because that is what the worktree-root checks read.
ROOT_REAL="$ROOT"
# Said out loud rather than silently: a command typed inside an agent worktree
# is answered from the main checkout, which is not where the operator is
# looking.
if [ "$INVOKED_ROOT" != "$ROOT" ]; then
  echo "loom: invoked inside $INVOKED_ROOT — reading zones, fence and env from the main checkout $ROOT" >&2
fi

AGENTS_DIR="$ROOT/.agents"
PROMPTS_DIR="$ROOT/.opencode/prompts"
# The two worktree roots are derived and VERIFIED further down, after
# .agents/loom.env has been sourced (it may set LOOM_WORKTREES) and after die()
# exists.
TIER="${LOOM_TIER:-standard}"
MAX_ATTEMPTS="${LOOM_MAX_ATTEMPTS:-3}"
SKIP="${LOOM_SKIP:-}"

# --- git's own environment, as it reaches a HOOK ---------------------------
# Snapshotted HERE, before either env file is sourced, and restored after the
# blanket `unset GIT_*` further down. Same carve-out shape as $OC_VARS: what
# was in the environment when `loom` started survives; what a file in the tree
# sets does not.
#
# The reason is `loom guard`, which git runs as a pre-commit hook. For
# `git commit -a`, `git commit -- <path>`, `--only` and `--include`, git builds
# a TEMPORARY index for the commit and hands the hook its path in
# $GIT_INDEX_FILE — the staged content of that commit lives there and NOWHERE
# else. Round 6 unset that variable along with the rest, so `cmd_guard`'s
# `git diff --cached` read the standard index instead, found nothing staged,
# and exited 0: a `git commit -a` touching a hand-zone path walked straight
# through a guard that printed no complaint. Measured with git 2.34 —
# `GIT_INDEX_FILE=<repo>/.git/index.lock` for `commit -a` in the main
# checkout, and `<gitdir>/next-index-<pid>.lock` plus a $GIT_DIR naming the
# worktree's git dir for a path-limited commit in a LINKED worktree.
#
# So: $GIT_INDEX_FILE, and the variables git sets alongside it in one layout or
# another ($GIT_DIR, $GIT_WORK_TREE, $GIT_PREFIX and the $GIT_AUTHOR_*/
# $GIT_COMMITTER_* identity), are restored to whatever they held on entry.
# $ROOT and $INVOKED_ROOT are resolved BEFORE this and never re-read, so a
# restored $GIT_DIR cannot move them.
#
# What this does NOT claim: a caller that exports $GIT_DIR itself is
# indistinguishable from git doing it, and wins — exactly as a caller that
# exports $OPENCODE_CONFIG wins. The hook runs in the agent's own session
# (KNOWN-GAPS 1's residual already concedes that $XDG_CONFIG_HOME there is the
# agent's), and the whole hook is dominated by `git commit --no-verify`. The
# guard is a seatbelt; `loom land`'s check of the COMMITS is the lock.
GIT_HOOK_VARS="GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_PREFIX \
GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE \
GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE"
GIT_SNAP=()
for _v in $GIT_HOOK_VARS; do
  if [ -n "${!_v+x}" ]; then GIT_SNAP+=("1" "${!_v}"); else GIT_SNAP+=("0" ""); fi
done
unset _v

# Provider keys live in one file outside every repo (chmod 600). Sourced here
# so loom and everything it launches (opencode included) see them without the
# keys ever entering a repo or a shell profile.
LOOM_ENV="${LOOM_ENV:-$HOME/.config/loom/env}"
if [ -f "$LOOM_ENV" ]; then set -a; . "$LOOM_ENV"; set +a; fi
# Project-scoped model chains and keys, checked into or ignored by the project
# as it prefers. Sourced second, so a project overrides the global file.
#
# Nothing a security check reads comes from here. The base every history check
# is measured from is the OPERATOR RECORD (see the state directory below), a
# file outside every repo; this file only ever picks models and keys.
#
# Two carve-outs, both because this file is `.`-sourced shell from a tracked
# path an agent can write (KNOWN-GAPS 3). The first is $WT_ROOT_PROFILED, dealt
# with further down. The second is the OPENCODE_* set, snapshotted here and
# restored immediately after: those five variables decide which config opencode
# loads, and the config decides `provider.<name>.options.baseURL` — the provider
# IDENTITY a fence profile's `providers` list is built on — and the role prompt.
# A caller that exports them wins untouched (that rule is unchanged); a file in
# the tree does not get to.
OC_VARS="OPENCODE_CONFIG OPENCODE_CONFIG_DIR OPENCODE_CONFIG_CONTENT OPENCODE_PERMISSION OPENCODE_DISABLE_PROJECT_CONFIG"
OC_SNAP=()
for _v in $OC_VARS; do
  if [ -n "${!_v+x}" ]; then OC_SNAP+=("1" "${!_v}"); else OC_SNAP+=("0" ""); fi
done
unset _v
if [ -f "$ROOT/.agents/loom.env" ]; then set -a; . "$ROOT/.agents/loom.env"; set +a; fi
_oc_i=0
for _v in $OC_VARS; do
  _oc_was="${OC_SNAP[$_oc_i]}"; _oc_val="${OC_SNAP[$((_oc_i + 1))]}"
  _oc_i=$((_oc_i + 2))
  if [ "$_oc_was" = 1 ]; then
    [ "${!_v-}" = "$_oc_val" ] || echo "loom: WARN: .agents/loom.env set $_v — ignored (it decides which config opencode loads); the value you exported is kept" >&2
    export "$_v=$_oc_val"
  else
    [ -z "${!_v+x}" ] || echo "loom: WARN: .agents/loom.env set $_v — ignored (it decides which config opencode loads, and this file is agent-writable)" >&2
    unset "$_v"
  fi
done
unset _v _oc_i _oc_was _oc_val OC_SNAP
# git's own environment, cleared once BOTH env files have been sourced. Every
# one of these re-aims a git subprocess at a different repository, index or
# object store — GIT_DIR and GIT_WORK_TREE obviously, GIT_INDEX_FILE and
# GIT_OBJECT_DIRECTORY* more quietly — and `.agents/loom.env` is `.`-sourced as
# shell from a tracked path an agent can write (KNOWN-GAPS 3), under `set -a`,
# so one line in a landed loom.env would point every check, every worktree add
# and every merge at a repo of its choosing. $ROOT and $INVOKED_ROOT were
# resolved before that file was read; from here on nothing in the environment
# moves them.
#
# The second half of the list is the CONFIG channel, and it is a code channel
# rather than a location one: $GIT_CONFIG_PARAMETERS (and the
# $GIT_CONFIG_COUNT/$GIT_CONFIG_KEY_n/$GIT_CONFIG_VALUE_n form) inject config at
# the highest precedence git has, $GIT_CONFIG_GLOBAL/$GIT_CONFIG_SYSTEM
# re-aim whole config files, and the rest name PROGRAMS git runs
# ($GIT_SSH_COMMAND, $GIT_PROXY_COMMAND, $GIT_EXTERNAL_DIFF, $GIT_PAGER,
# $GIT_EDITOR, $GIT_SEQUENCE_EDITOR, $GIT_ASKPASS/$SSH_ASKPASS). One line in a
# landed loom.env is a shell of the agent's choosing, running as you, the next
# time you type any loom command.
unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_CEILING_DIRECTORIES \
      GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE \
      GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE \
      GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM \
      GIT_SSH_COMMAND GIT_PROXY_COMMAND GIT_EXTERNAL_DIFF GIT_PAGER GIT_EDITOR \
      GIT_SEQUENCE_EDITOR GIT_ASKPASS SSH_ASKPASS
# $GIT_CONFIG_COUNT is gone, but the numbered pairs it counted are separate
# variables and survive it — and git reads them whenever the count is set, so a
# later `GIT_CONFIG_COUNT=2` from anywhere would pick up whatever is still
# standing. Remove every one of them by name.
while IFS= read -r _k; do
  [ -n "$_k" ] && unset "$_k"
done < <(compgen -v 2>/dev/null | grep -E '^GIT_CONFIG_(KEY|VALUE)_[0-9]+$' || true)
unset _k

# git's environment as a HOOK gets it back — only the values that were there
# when loom started, never one a file in the tree wrote. See $GIT_HOOK_VARS.
_g_i=0
for _v in $GIT_HOOK_VARS; do
  _g_was="${GIT_SNAP[$_g_i]}"; _g_val="${GIT_SNAP[$((_g_i + 1))]}"
  _g_i=$((_g_i + 2))
  [ "$_g_was" = 1 ] && export "$_v=$_g_val"
done
unset _v _g_i _g_was _g_val GIT_SNAP GIT_HOOK_VARS

# ------------------------------------------- loom's OWN git config, on top
# `.git/config` is in the SHARED git directory, so every linked worktree can
# write it — `git -C <worktree> config core.pager /tmp/x` is one command from
# inside an agent's tree. Several of its keys name a PROGRAM git then runs, in
# YOUR session, the next time loom touches this repository: core.pager,
# core.fsmonitor, core.sshCommand, remote.<n>.uploadpack/receivepack,
# diff.external, core.editor, sequence.editor. That is repo-local config as a
# code channel, and it is a shorter path than anything KNOWN-GAPS 3 describes.
#
# $GIT_CONFIG_PARAMETERS is what `git -c` uses internally, and it outranks every
# config FILE, so this is the highest-precedence answer for every git subprocess
# loom spawns — including `git -C "$wt" …`, the operator's `.agents/gate.sh`
# (which inherits this environment), and any hook git runs underneath them.
#
# What is deliberately NOT here:
#   core.hooksPath   the operator's hooks MUST run — `loom install-hooks` puts
#                    the hand-zone guard in one. Overriding it would disarm the
#                    guard from inside loom. It stays trusted, and
#                    ARCHITECTURE.md § 5 / KNOWN-GAPS 6 say what that is worth.
#   protocol.allow   already defaults to `user`, which is what we want.
#   credential.helper  yours; a push has to be able to authenticate.
#   diff.external    MEASURED, and it is the one entry that cannot go here: an
#                    empty value is not "unset", it is a command named "", and
#                    `git -c diff.external= diff` dies with "cannot run : No
#                    such file or directory" on every hunk. `--no-ext-diff` on
#                    each diff-producing command is the lever that works, and it
#                    covers the per-attribute `diff.<driver>.command` too.
#   remote.*.uploadpack / receivepack — they ARE below, as a floor, but they do
#                    not win: git collects those into a list and keeps the
#                    FIRST ("more than one receivepack given, using the first"),
#                    and a config file is read before this variable. The lock is
#                    `--upload-pack=` / `--receive-pack=` on the fetch and the
#                    push, which do win. Measured, both ways.
#
# `pager.<cmd>`, and why `core.pager=cat` alone was not enough. MEASURED, git
# 2.34.1, in a pty (git only pages on a tty):
#
#   pager.log=<script>  in .git/config, core.pager=cat via this variable  -> the
#                       script RAN. git_pager() reads $GIT_PAGER, then
#                       `pager_program`, then core.pager — and check_pager_config
#                       has ALREADY set pager_program from pager.<cmd>, so
#                       core.pager is never consulted.
#   GIT_PAGER=cat                                                        -> not run
#   pager.<cmd>=cat via this variable                                    -> not run
#   git --no-pager <cmd>                                                 -> not run
#
# and `pager.<cmd>` with a STRING value also turns paging ON for a subcommand
# that never pages by default. Measured across everything loom invokes: status,
# remote, branch, worktree, ls-files, show-ref, merge-base, rev-list,
# update-ref, add, commit, checkout, reset, diff, log, show, ls-remote,
# symbolic-ref, sparse-checkout and patch-id all ran the planted pager; only
# `rev-parse` did not. `git config` splits: `config --get` does NOT page, but
# `config --list` DOES (measured in a pty, git 2.34.1) — which is the form the
# config pin reads with, so `pager.config=cat` below is load-bearing rather than
# belt-and-braces. Either way a `pager.update-ref=<script>` planted from a
# worktree is a program run in your session by a plumbing command.
#
# Both levers are used, and they are not redundant:
#   * $GIT_PAGER=cat below is the COMPLETE one — it beats pager.<cmd> for every
#     subcommand, including ones loom does not invoke today;
#   * the 'pager.<cmd>=cat' entries here are the FLOOR, one per subcommand loom
#     actually runs, so the pin survives an edit that drops the export.
# `--no-pager` on every call site was the third option and was rejected: it is
# ~100 sites, and a site added later silently has no pin.
#
# core.sshCommand is pinned to the operator's own GLOBAL/SYSTEM value when they
# have one, rather than to a bare `ssh`: the repo-local key is the attack, an
# `~/.gitconfig` that names an identity file is not, and a plain `ssh` would
# break that operator's push for nothing.
_ssh="$(git config --global --get core.sshCommand 2>/dev/null || true)"
[ -n "$_ssh" ] || _ssh="$(git config --system --get core.sshCommand 2>/dev/null || true)"
[ -n "$_ssh" ] || _ssh="ssh"
# GIT_CONFIG_PARAMETERS is a list of sq-quoted `key=value` words, so a literal
# quote inside a value has to be escaped the way the shell escapes one.
_ssh="${_ssh//\'/\'\\\'\'}"
# One 'pager.<cmd>=cat' per subcommand `loom` runs. Keep this list in step with
# the git commands in this file; $GIT_PAGER below covers anything missed.
_pagers=""
for _c in add branch checkout commit config diff fetch log ls-files ls-remote \
          merge merge-base patch-id push rebase remote reset rev-list rev-parse \
          show show-ref sparse-checkout status symbolic-ref update-ref worktree; do
  _pagers="$_pagers 'pager.$_c=cat'"
done
export GIT_CONFIG_PARAMETERS="'core.pager=cat' 'core.fsmonitor=false' \
'protocol.ext.allow=never' 'core.sshCommand=$_ssh' \
'remote.origin.uploadpack=git-upload-pack' 'remote.origin.receivepack=git-receive-pack' \
'core.editor=true' 'sequence.editor=true'${_pagers}"
# The complete lever: $GIT_PAGER outranks pager.<cmd> AND core.pager for every
# subcommand there is. It is exported AFTER the blanket `unset GIT_*` above, so
# a value from `.agents/loom.env` is overwritten rather than honoured — the same
# shape as `core.pager=cat`, not a new channel. A caller that wanted a pager for
# loom's own git calls has already lost it to core.pager=cat; LOOM_DIFF_CMD is
# where an operator pager goes.
export GIT_PAGER=cat
unset _ssh _c _pagers

for _k in ZHIPU_API_KEY ZAI_API_KEY DEEPSEEK_API_KEY MOONSHOT_API_KEY; do
  case "$(eval "echo \"\${$_k:-}\"")" in *PASTE-YOUR*) unset "$_k" ;; esac
done

# opencode's built-in zai provider reads ZHIPU_API_KEY; accept ZAI_API_KEY too.
if [ -n "${ZAI_API_KEY:-}" ] && [ -z "${ZHIPU_API_KEY:-}" ]; then
  export ZHIPU_API_KEY="$ZAI_API_KEY"
fi

die()  { echo "loom: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# Two ways for $ROOT to be a directory loom must not treat as a checkout, both
# of which used to end in "nothing is fenced, nothing is hand, carry on" rather
# than a refusal.
#
# A SUBMODULE has its git dir at <superproject>/.git/modules/<name>, so
# `git rev-parse --git-common-dir` from inside one answers that path and $ROOT
# becomes <superproject>/.git/modules — a directory with no .agents, no zones
# and no relationship to the operator record, where every path resolves to
# "assist" and `loom guard` exits 0. Run loom in the superproject.
case "$ROOT" in
  */.git|*/.git/*)
    die "the main checkout resolves to
  $ROOT
which is inside a '.git' directory — the shape a git SUBMODULE has (its git dir
lives at <superproject>/.git/modules/<name>). loom's zones, its fence and its
operator record are keyed to a CHECKOUT, and a module directory has none of
them: every path there resolves to 'assist' and every guard passes. Run loom
from the superproject." ;;
esac
# And a repo with no .agents/ at all has no policy to apply. Silence there is
# indistinguishable from "everything is permitted", so say it instead.
[ -d "$AGENTS_DIR" ] || die "no .agents directory in the main checkout
  $ROOT
That is where the zones, the fence and the gate live, so without it loom would
fence nothing, guard nothing and gate nothing — which is not a default it will
pick for you. Create it (README § Setup), or run loom from the repo that has
one."

# --------------------------------------------------- operator task state
# One file per task, OUTSIDE every repository and outside the shared `.git`.
#
# That location is the whole point. A linked worktree shares `.git` with the
# main checkout, so everything under it is writable by anything running in an
# agent's worktree: `.git/config` (which is where `branch.<br>.loombase` and
# `branch.<br>.fenceprofile` used to live) and the refs too —
# `refs/remotes/origin/main`, `refs/heads/main`, `refs/heads/agent/*` are one
# `git update-ref` away from whatever the agent wants them to say. None of it
# can carry a security input. The operator's record can, because `loom new`
# writes it and nothing in a worktree has a reason to touch it.
#
#   ${XDG_CONFIG_HOME:-$HOME/.config}/loom/repos/<key>/repo        <- the path
#   ${XDG_CONFIG_HOME:-$HOME/.config}/loom/repos/<key>/tasks/<task>
#
# <key> is the sha256 of the MAIN checkout's real path (a linked worktree
# resolves to the same key, which is what lets the pre-commit guard read the
# record), and the `repo` file records that path so a human can tell the
# directories apart. Dir 0700, files 0600.
#
# Be exact about what this is worth: it is OPERATOR INTEGRITY, not
# tamper-proofing. An unsandboxed agent can write $HOME — the capability
# KNOWN-GAPS 3 already concedes — and this file is in it. What it removes is
# the whole class of "a worktree rewrites the input to its own security check
# with one git command", which is a different and much cheaper attack.
# The MAIN checkout, never the worktree a command was typed in — which is what
# $ROOT already is (see the derivation at the top of this file, which used to
# live here). It keeps its own name because the messages, the operator record's
# key and the gate-script lookup all read as statements about the main checkout
# rather than about "the root".
STATE_MAIN_ROOT="$ROOT"
STATE_KEY="$(printf '%s' "$STATE_MAIN_ROOT" | python3 -c 'import hashlib,sys; sys.stdout.write(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())')" \
  || die "cannot compute the operator state key for $STATE_MAIN_ROOT"
[ -n "$STATE_KEY" ] || die "cannot compute the operator state key for $STATE_MAIN_ROOT"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/loom/repos/$STATE_KEY"

state_file() { # state_file <task>  -> the path of that task's record
  case "$1" in
    ""|.|..|*/*) die "'$1' is not a usable task id (no '/', '.' or '..')" ;;
    # The pinned git config lives beside the record as `<task>.gitconfig`, so a
    # task literally called `x.gitconfig` would have its record written over
    # task `x`'s config sidecar (and read back as one). Refuse the name.
    *.gitconfig) die "'$1' is not a usable task id: a task's pinned git config is
recorded beside its operator record as '<task>.gitconfig', so an id ending in
'.gitconfig' would collide with another task's. Rename the task." ;;
  esac
  printf '%s\n' "$STATE_DIR/tasks/$1"
}

# --- the record's shape, and both sides of it -------------------------------
# A record is one field per line, `<key>=<value>`, and both halves are checked
# on the way in AND on the way out. The reason is `origin=` and `fetch=`: their
# values come from `.git/config` via `git remote get-url` / `git config`, which
# every linked worktree can write, and git stores a newline inside a config
# value perfectly happily. A URL of
#
#   https://example.invalid/x
#   reviewed=<the tip the agent wants landed>
#
# is therefore a way to write a SECOND field into the operator's own record —
# the one file in this system that is not supposed to be writable from a
# worktree. state_put refuses the value; state_read refuses the file.
#
# STATE_KEYS is the allowlist. STATE_ORDER is the order fields are WRITTEN in,
# and it is not the same list by accident: `reviewed` deliberately precedes
# every config-derived field — `origin`, `fetch`, `pushurl` and `config`, all
# four of which are read out of .git/config — so that even a reader which took
# the first match for a duplicated key would take the honest one.
STATE_KEYS="base profile branch created origin fetch pushurl config reviewed"
STATE_ORDER="base profile branch created reviewed origin fetch pushurl config"

# One field of a task's record, or "". A missing record is "" here on purpose:
# the callers that must refuse it say so themselves, with their own message.
#
# A record that is not one `loom` wrote is NOT "": a duplicated field, an
# unknown key or a line with no '=' is a dead stop. "Take the first match and
# carry on" is exactly how a forged second `reviewed=` would have been read as
# a plausible record with a plausible answer.
state_read() { # state_read <task> <key>
  local f out rc=0
  f="$(state_file "$1")"
  [ -f "$f" ] || return 0
  # awk, not sed: the whole file has to be judged before any line of it is
  # believed, and the complaint comes back on stdout so the refusal below is
  # the shell's rather than a message from a subprocess nobody reads.
  out="$(awk -v want="$2" -v keys=" $STATE_KEYS " '
      { p = index($0, "=")
        if (p < 2) {
          printf "line %d is not <key>=<value>: %s", NR, $0; bad = 1; exit 2 }
        k = substr($0, 1, p - 1)
        if (index(keys, " " k " ") == 0) {
          printf "line %d names \"%s\", which is not a field a record has", NR, k
          bad = 1; exit 2 }
        if (k in seen) {
          printf "field \"%s\" appears twice (lines %d and %d)", k, seen[k], NR
          bad = 1; exit 2 }
        seen[k] = NR
        if (k == want) v = substr($0, p + 1) }
      END { if (!bad) printf "%s", v }
    ' "$f")" || rc=$?
  [ "$rc" -eq 0 ] || die "the operator record for task $1 is not one loom wrote: $out
  $f
One field per line, each field once. A record loom cannot read as one fact per
field is not a record it will guess at — a forged duplicate is the whole reason
this is checked. Start clean:
  loom drop $1 && loom new $1"
  printf '%s\n' "$out"
}

# The record's shape, asserted in the CURRENT shell. state_read dies on a
# malformed record too, but nearly every caller reads it inside `$(…)`, where a
# die exits the subshell and hands back "" — which reads as "no record". Every
# command that names a task asks this first, as a plain statement, so that the
# refusal is the command's own.
require_sane_record() { # require_sane_record <task>
  state_read "$1" base > /dev/null
}

# A record field is ONE line. Checked before `loom new` creates anything, and
# again in state_put for every writer.
require_one_line() { # require_one_line <what> <value>
  case "$2" in
    *[[:cntrl:]]*) ;;
    *) return 0 ;;
  esac
  die "$1 contains a control character:
  $(printf '%s' "$2" | cat -v | sed 's/^/  /' | head -4)
The operator record is one field per line, so a value carrying a newline is a
way to write a field loom did not — and this one comes out of .git/config, which
every linked worktree can write. Put it back to a single line first:
  git config --get-regexp '^remote\.origin\.'"
}

# The value state_put was given for one key, or "". First match wins, which is
# what lets state_update put its overrides in front of the current record.
state_arg() { # state_arg <key> <key>=<value>...
  local want="$1" a
  shift
  for a in "$@"; do
    case "$a" in "$want="*) printf '%s' "${a#"$want"=}"; return 0 ;; esac
  done
  return 0
}

# The only writer, and the only validator of what goes in. Arguments are
# `<key>=<value>`, in any order: threading eight positional fields through three
# call sites is how a field gets silently dropped, and a key that is not a field
# is now a refusal rather than an eighth positional argument nobody notices.
#
# The fields beyond the base and the profile all exist to pin something an agent
# could otherwise move under the operator:
#
#   origin=<url>    `remote.origin.url` as it was at `loom new`. `loom rebase` and
#                   `loom land --pr` refuse when the current URL differs: the
#                   remote config is in the shared .git, so one `git remote
#                   set-url` inside a worktree re-aims the fetch a rebase
#                   replays onto, and the push a --pr landing performs.
#   fetch=<spec>    `remote.origin.fetch`, the refspec that decides which local
#                   ref a plain `git fetch origin` updates. Same shared config,
#                   same treatment: pointed at `refs/remotes/decoy/*` it leaves
#                   a forged `refs/remotes/origin/main` standing through a
#                   fetch that looks like it worked.
#   pushurl=<url>   where a push actually GOES, which is not `origin` above:
#                   `remote.origin.pushurl` overrides the URL for pushes only,
#                   and a `url.<decoy>.pushInsteadOf = <the real origin>`
#                   rewrite does the same with the pushurl key left empty. Both
#                   live in the shared .git/config, both leave `git remote
#                   get-url origin` answering the honest URL, and `loom land
#                   --pr` is the one command in this system that publishes an
#                   agent's commits to a host. Recorded as
#                   `git remote get-url --push origin`, which is the effective
#                   answer after both.
#   config=<sha256> the whole of the repository's LOCAL git config, digested.
#                   `.git/config` is in the shared git directory, so every
#                   linked worktree can write it, and the keys that matter are
#                   not ones loom can name in advance: `filter.<d>.clean`,
#                   `merge.<d>.driver`, `credential.helper`, `core.askPass`,
#                   `gpg.program`, `pager.<cmd>`, `core.hooksPath`,
#                   `include.path` / `includeIf.*` all name a PROGRAM (or a
#                   whole further config file) that git runs in your session.
#                   Pinning the individual keys is a losing game; pinning the
#                   config is not. Recomputed and compared before every model
#                   launch, before a fetch, a push, a merge, a replay and every
#                   review patch. `--accept-config` is the one escape.
#   reviewed=<sha>  the branch tip `loom check` last handed to a reviewer.
#                   `loom land` refuses a tip that is not this one.
state_put() { # state_put <task> <key>=<value>...
  local task="$1" f tmp a k v kk ok
  shift
  f="$(state_file "$task")"
  for a in "$@"; do
    case "$a" in
      *=*) ;;
      *) die "internal error: state_put argument '$a' is not <key>=<value>" ;;
    esac
    k="${a%%=*}"; v="${a#*=}"
    ok=""
    for kk in $STATE_KEYS; do [ "$k" = "$kk" ] && ok=yes; done
    [ -n "$ok" ] || die "refusing to write the operator record for $task: '$k' is not one
of the fields a record has ($STATE_KEYS)."
    require_one_line "the '$k' field of task $task's operator record" "$v"
  done
  ( umask 077; mkdir -p "$STATE_DIR/tasks" ) \
    || die "cannot create the operator state directory $STATE_DIR/tasks"
  chmod 700 "$STATE_DIR" "$STATE_DIR/tasks" 2>/dev/null || true
  ( umask 077; printf '%s\n' "$STATE_MAIN_ROOT" > "$STATE_DIR/repo" ) || true
  tmp="$f.tmp.$$"
  ( umask 077; : > "$tmp" ) || die "cannot write the operator record $f"
  for k in $STATE_ORDER; do
    printf '%s=%s\n' "$k" "$(state_arg "$k" "$@")" >> "$tmp" \
      || die "cannot write the operator record $f"
  done
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$f" || die "cannot write the operator record $f"
}

# Re-write a record, keeping every field it already has except the ones named
# here. `loom check` (which stamps `reviewed`) and `loom rebase` (which
# re-points `base` and clears `reviewed`) are its only callers.
state_update() { # state_update <task> <key>=<value>...
  local task="$1" k
  shift
  local -a args=("$@")            # the overrides go FIRST: first match wins
  for k in $STATE_KEYS; do
    args+=("$k=$(state_read "$task" "$k")")
  done
  state_put "$task" "${args[@]}"
}

# `remote.origin.url` as git answers it NOW, or "" when there is no origin.
# Never a failure: a repo without a remote is ordinary, and the comparison
# against the recorded value is what refuses.
origin_url() { git remote get-url origin 2>/dev/null || true; }

# `remote.origin.fetch` as git answers it NOW, or "" when there is no origin.
# Multi-valued config is ordinary (a second refspec for tags, say), and the
# values are read NUL-delimited so that a newline INSIDE one is preserved into
# the joined string rather than flattened into the join — require_one_line is
# what has to see it.
#
# Each value is written `<length>:<value>`, and the join is a space. A plain
# space-join is not INJECTIVE: the two-value list ["a", "b c"] and the two-value
# list ["a b", "c"] both flatten to "a b c", so one could be swapped for the
# other under a comparison that is supposed to refuse exactly that. The record
# is one line per field (a NUL cannot go in it — require_one_line refuses every
# control character), so length-prefixing is the shape that fits: a reader takes
# the count, then that many characters, then expects a space or the end.
origin_fetch() {
  local v out=""
  while IFS= read -r -d '' v; do out="${out:+$out }${#v}:$v"; done \
    < <(git config --get-all --null remote.origin.fetch 2>/dev/null || true)
  printf '%s' "$out"
}

# Where a push to `origin` actually goes, as git resolves it NOW, or "" when
# there is no origin. `--push` is the whole point: it applies
# `remote.origin.pushurl` AND any `url.<x>.pushInsteadOf` rewrite, so it answers
# the question `git remote get-url origin` cannot — both of those redirect a
# push while leaving the fetch URL reading exactly as it was recorded.
origin_pushurl() { git remote get-url --push origin 2>/dev/null || true; }

# The origin a task was created against must still be the origin it lands
# against — the URL AND the refspec. Called by `loom rebase` (before the fetch it
# would replay onto) and by `loom land --pr` (before the push).
require_recorded_origin() { # require_recorded_origin <task> <command-name>
  local task="$1" cmd="$2" field rec now what
  # THREE facts, not one, and each of them is separately writable from a
  # worktree while the other two keep reading exactly as they were recorded.
  for field in url fetch pushurl; do
    case "$field" in
      url)     what="'remote.origin.url'"
               rec="$(state_read "$task" origin)";  now="$(origin_url)" ;;
      fetch)   what="'remote.origin.fetch'"
               rec="$(state_read "$task" fetch)";   now="$(origin_fetch)" ;;
      pushurl) what="the PUSH url of 'origin' ('remote.origin.pushurl', or a 'url.<x>.pushInsteadOf' rewrite)"
               rec="$(state_read "$task" pushurl)"; now="$(origin_pushurl)" ;;
    esac
    [ "$rec" = "$now" ] && continue
    die "the 'origin' remote is not the one task $task was created against:
  $what recorded at loom new: ${rec:-(none)}
  $what configured now:       ${now:-(none)}
All three live in the shared .git/config, which every linked worktree can write.
The URL re-aims the fetch a rebase replays onto; the refspec decides which local
ref a fetch updates at all, so one pointed at refs/remotes/decoy/* leaves a
forged refs/remotes/origin/<branch> standing through a fetch that looks like it
worked; and the PUSH url is where 'loom land --pr' actually publishes this
branch — 'remote.origin.pushurl' and 'url.<decoy>.pushInsteadOf' both redirect
it while 'git remote get-url origin' goes on answering the honest URL. loom will
not $cmd against a remote it cannot vouch for. Put it back, or start clean:
  loom drop $task && loom new $task"
  done
  return 0
}

# ----------------------------------------------- the repository's git config
# `.git/config` is in the SHARED git directory, so `git -C <worktree> config
# <anything> <anything>` is one command from inside an agent's tree — and that
# file is not a preferences file. Keys in it name a PROGRAM git runs, in YOUR
# session, the next time you type a `loom` command:
#
#   core.hooksPath            which hooks run — including in your checkout,
#                             during `loom land`'s merge
#   filter.<d>.clean/.smudge  run on checkout, `git add` and commit, selected by
#   merge.<d>.driver          a tracked .gitattributes (a [hand] path, but the
#   diff.<d>.textconv         guard is a seatbelt and history is what lands)
#   credential.helper         `!<shell>` — and it is handed your credentials to
#                             store, so it harvests as well as executes
#   core.askPass              the same, for the interactive prompt
#   gpg.program               under commit.gpgsign
#   pager.<cmd>               a program for any subcommand, plumbing included
#   include.path / includeIf.*  a whole further config file of the writer's
#                             choosing, which brings all of the above with it
#   core.attributesFile / core.excludesFile
#
# $GIT_CONFIG_PARAMETERS pins the keys `loom` can name in advance. It cannot pin
# these, because for several of them the NAME is the attack (`filter.<anything>`,
# `pager.<anything>`, `includeIf.<anything>`) — there is no finite list to
# override. So the whole config is PINNED instead: `loom new` records a digest
# of it, plus the full list in a sidecar so a mismatch can be shown as a diff,
# and every command that runs a model, fetches, pushes, merges, replays or
# writes a review patch recomputes it and refuses a change.
#
# "The whole config" is THREE SCOPES and an INCLUDE CLOSURE, because
# `git config --local --list` is not the whole of what git reads:
#
#   local          `.git/config`, shared by every worktree.
#   worktree-main  `$GIT_COMMON_DIR/config.worktree` — the MAIN checkout's own
#                  scope. A `core.hooksPath` there runs YOUR hooks, in YOUR
#                  checkout, during `loom land`'s merge.
#   worktree-task  `$GIT_COMMON_DIR/worktrees/<wt>/config.worktree` — the task
#                  worktree's own scope, one `git config --worktree <k> <v>`
#                  away from inside the agent's tree.
#   include        every file an `include.path` / `includeIf.<cond>.path` in any
#                  of those three pulls in, recursively, digested by its raw
#                  bytes. `--list` prints those directives as POINTERS and never
#                  the keys they bring, so pinning the listing alone pins the
#                  pointer and nothing behind it.
#
# The two worktree scopes are live whenever `extensions.worktreeConfig` is on —
# which loom's own `git sparse-checkout init` turns on (measured, git 2.34) —
# and NEITHER shows up in `git config --local --list`.
#
# Be exact about what that is and is not:
#   * it is a CHANGE check. Whatever the config already said at `loom new` is
#     the baseline and is trusted — see ARCHITECTURE.md § 5 and KNOWN-GAPS 6;
#   * `loom` never writes config on your behalf except where it says so
#     (`loom new`'s own sparse-checkout setup, which writes `core.sparseCheckout`
#     at worktree scope and `extensions.worktreeConfig` at local scope, and
#     `loom land --pr`'s `--set-upstream-to`), and both re-record. Everything
#     else that changes it is you or an agent — an agent's `git config user.name`
#     in its worktree trips this, and that is intended, because
#     `git config user.name` and `git config credential.helper '!sh -c …'` are
#     the same command;
#   * `--accept-config` is the escape, and it is an operator act with the same
#     weight as `--fence-profile`: it prints what changed and re-records.
#   * `loom drop` deliberately does NOT check it: dropping a task removes the
#     worktree, the branch and the record, runs no model and publishes nothing,
#     so refusing to clean up a repository because its config moved would leave
#     the released paths on disk — the opposite of what the check is for.
# --- the dumps, and cleaning them up ---------------------------------------
# Every config path in this file goes through a temp FILE, because a NUL stream
# cannot survive a command substitution. Each caller removes its own dump on
# the way out — and each caller also has a dozen ways to `die` in between, and
# `loom new` in particular has an EXIT trap that unwinds a half-built task and
# used to leave the dump behind every single time it fired (measured: one
# `loom-gitconfig.XXXXXX` per test run, from (ap)'s deliberately-failed add).
#
# So the dumps are tracked and swept at exit as well. The list is only ever
# APPENDED to: `rm -f` on a file a caller already removed is free, and an
# untrack step is one more thing to forget. `config_snapshot` cannot do the
# tracking itself — it answers through `$(…)`, i.e. from a subshell, where an
# assignment to this array would be discarded — so tracking is the caller's,
# one line under each call.
CFG_TMPS=()
cfg_track()   { CFG_TMPS+=("$1"); }
cfg_cleanup() {
  local p
  for p in ${CFG_TMPS[0]+"${CFG_TMPS[@]}"}; do rm -f "$p"; done
}
trap 'cfg_cleanup' EXIT

config_sidecar() { # config_sidecar <task> -> the path of that task's pinned config
  printf '%s\n' "$(state_file "$1").gitconfig"
}

# The dump, the digest and the diff. python3 (already required, for zones) so
# that the NUL-delimited form git writes is handled exactly: `--list --null`
# emits "<key>\n<value>" per record, NUL-terminated, and a config VALUE may
# itself contain a newline — which is precisely why the digest is taken over the
# NUL form and not over the human-readable `--list`.
#
# A record in a loom dump is one of two shapes, and both are NUL-terminated:
#
#   <scope>:<key>\n<value>      one config entry, tagged with the SCOPE it was
#                               read from — `local`, `worktree-main` or
#                               `worktree-task` (see config_snapshot). The tag
#                               is what lets a refusal say WHICH file gained the
#                               key, which is not a detail: the three live in
#                               three different files with three different
#                               writers.
#   include:<path>:<sha256>\n<bytes>
#                               one file pulled into the config by an
#                               `include.path` / `includeIf.<cond>.path`
#                               directive: its resolved path, the sha256 of its
#                               raw bytes, and THE BYTES THEMSELVES. `<sha256>`
#                               is `(missing)` when the target does not exist —
#                               and then there is no value half — because "the
#                               include target appeared" is exactly as much of a
#                               change as "its contents changed".
#
#                               The bytes are there so that a change to an
#                               included file shows up as a `-`/`+` CONTENT
#                               diff. A digest alone said only "this file is
#                               not the file it was", which is a refusal the
#                               operator cannot read: the whole point of the
#                               sidecar is that a mismatch is shown rather than
#                               asserted, and an include was the one entry that
#                               could not be.
#
#                               The path AND the bytes are escaped ON THE WAY
#                               IN (the same escaping `show` renders values
#                               with), not on the way out. That is what keeps
#                               the framing unambiguous: a NUL in an included
#                               file would otherwise split one record into two,
#                               and a newline in either half would move the
#                               boundary between them.
#
# A record's SHAPE is judged by its scope tag and nothing else: a record whose
# key half does not begin with one of `local:` / `worktree-main:` /
# `worktree-task:` is an include record. Keying off "does it contain a newline"
# was wrong in exactly the case that matters — an include path (or now its
# content) carrying one.
config_py() { # config_py digest <dump> | diff <recorded> <dump>
              #         | snapshot <out> <dump> <file> <dump> <file> <dump> <file>
              #         | summary <dump> | programs <dump>
  python3 - "$@" << 'PY'
import collections, hashlib, os, subprocess, sys

# The order is the order the sidecar is written in, and the order a diff names.
SCOPES = ("local", "worktree-main", "worktree-task")

def records(raw):
    return [r for r in raw.split(b"\0") if r != b""]

def read(path):
    with open(path, "rb") as fh:
        return records(fh.read())

def esc(s):
    """One line, printable, and reversible enough to read. Used on a config
    VALUE at render time, and on an include record's path and bytes at WRITE
    time — the same escaping either way, so what a diff prints for an include
    is what it prints for anything else."""
    s = s.replace("\\", "\\\\").replace("\n", "\\n").replace("\t", "\\t")
    return "".join(c if c >= " " and c != "\x7f" else "\\x%02x" % ord(c) for c in s)

def scope_of(k):
    """The scope tag a record's key half carries, and the key without it.
    ("", k) means NO tag, which is what an include record is — judged by the
    tag's absence and never by the record's shape, because an include path or
    an included file's bytes may contain anything at all."""
    for s in SCOPES:
        if k.startswith(s + ":"):
            return s, k[len(s) + 1:]
    return "", k

def program_key(k):
    """Keys whose value names a PROGRAM git runs in your session — or a file
    that can name one. git lower-cases the section and the final key in its
    listings, so the comparison is against that form. Keep in step with the
    list in `loom new`'s WARN block and ARCHITECTURE.md § 5."""
    if k in ("core.hookspath", "core.askpass", "gpg.program",
             "core.attributesfile", "core.sshcommand"):
        return True
    for p in ("credential.", "filter.", "pager.", "include.", "includeif."):
        if k.startswith(p):
            return True
    if k.startswith("merge.") and k.endswith(".driver"):
        return True
    if k.startswith("diff.") and (k.endswith(".textconv") or k.endswith(".command")):
        return True
    return False

def show(rec):
    key, sep, val = rec.partition(b"\n")
    k = key.decode("utf-8", "replace")
    scope, k = scope_of(k)
    if not scope:
        # An include record: `include:<escaped path>:<sha256>`, and after it the
        # target's own bytes, ALREADY escaped when the record was written. Both
        # halves go out as they are — escaping them again here would double
        # every backslash the file happens to contain.
        return k + ("=" + val.decode("utf-8", "replace") if sep else "")
    out = k
    if sep:
        out += "=" + esc(val.decode("utf-8", "replace"))
    # AFTER the key=value, deliberately: a reader (and a test) looking for the
    # key it planted finds "+ <key>=" where it always did, and the scope is the
    # extra fact rather than a prefix that moves it.
    out += "   [%s]" % scope
    return out

# --- the include closure ---------------------------------------------------
# `git config --list` prints `include.path=<file>` and
# `includeIf.<cond>.path=<file>` as POINTERS — the keys of the included file do
# not appear in the `--local` / `--worktree` listings at all (measured, git
# 2.34.1: `git config --local --list` shows the pointer, `git config --list`
# shows the pulled-in `core.hookspath`). So digesting the listings alone pins
# the pointer and nothing it points at, and an agent who plants one benign
# include once can edit the TARGET afterwards for free.
#
# The closure is therefore walked here: every pointer in the three config files,
# resolved (relative to the directory of the file that names it, `~` expanded),
# digested by its raw bytes, and followed recursively — an included file may
# include another. A cycle terminates on the visited set.
def include_values(recs):
    out = []
    for r in recs:
        key, sep, val = r.partition(b"\n")
        k = key.decode("utf-8", "replace").lower()
        if k == "include.path" or (k.startswith("includeif.") and k.endswith(".path")):
            out.append(val.decode("utf-8", "surrogateescape") if sep else "")
    return out

def resolve(base_dir, value):
    p = os.path.expanduser(value)
    if not os.path.isabs(p):
        p = os.path.join(base_dir, p)
    return os.path.normpath(p)

def file_records(path):
    # `git config --file <f> --list` does NOT expand that file's own includes
    # (measured), which is what makes the recursion ours and deterministic.
    try:
        r = subprocess.run(["git", "config", "--file", path, "--list", "--null"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None
    if r.returncode != 0:
        return None
    return records(r.stdout)

def closure(seeds):
    # seeds: [(directory of the file that named it, the raw value)]
    out, seen, queue = [], set(), list(seeds)
    while queue:
        base, value = queue.pop(0)
        if value == "":
            continue
        path = resolve(base, value)
        if path in seen:
            continue
        seen.add(path)
        try:
            with open(path, "rb") as fh:
                raw = fh.read()
        except OSError:
            # No value half at all: "(missing)" is the whole of what is known,
            # and an empty one would read as "present and empty".
            out.append(("include:%s:(missing)" % esc(path)).encode("utf-8"))
            continue
        # path, sha256 AND the bytes — so a later edit of the target is a
        # content diff and not a pair of digests nobody can compare. Escaped
        # here rather than at render time: the record is NUL-framed with a
        # newline between its halves, and an included file may contain both.
        out.append(("include:%s:%s\n%s"
                    % (esc(path), hashlib.sha256(raw).hexdigest(),
                       esc(raw.decode("utf-8", "replace")))).encode("utf-8"))
        sub = file_records(path)
        if sub is None:            # git cannot parse it, so git honours no
            continue               # include of its either; the digest above
        for v in include_values(sub):          # is the whole of the check
            queue.append((os.path.dirname(path), v))
    return out

mode = sys.argv[1]
try:
    if mode == "digest":
        recs = sorted(read(sys.argv[2]))
        sys.stdout.write(hashlib.sha256(b"\0".join(recs)).hexdigest())
    elif mode == "diff":
        old = collections.Counter(read(sys.argv[2]))
        new = collections.Counter(read(sys.argv[3]))
        for r in sorted((old - new).elements()):
            print("  - " + show(r))
        for r in sorted((new - old).elements()):
            print("  + " + show(r))
    elif mode == "snapshot":
        out_path = sys.argv[2]
        tagged, seeds = [], []
        for i, scope in enumerate(SCOPES):
            dump = sys.argv[3 + i * 2]
            cfg = sys.argv[4 + i * 2]
            recs = read(dump)
            for r in recs:
                tagged.append(scope.encode() + b":" + r)
            # The pointers are read out of the SCOPE's listing, and resolved
            # against the directory of the file that scope is; an empty path
            # means loom could not name a file for that scope (no task
            # worktree yet), so there is nothing to resolve against.
            if cfg:
                base = os.path.dirname(os.path.abspath(cfg))
                for v in include_values(recs):
                    seeds.append((base, v))
        tagged.extend(closure(seeds))
        with open(out_path, "wb") as fh:
            for r in tagged:
                fh.write(r)
                fh.write(b"\0")
    elif mode == "summary":
        n_local = n_wt = 0
        targets = []
        for r in read(sys.argv[2]):
            scope, k = scope_of(r.partition(b"\n")[0].decode("utf-8", "replace"))
            if scope == "local":
                n_local += 1
            elif scope:
                n_wt += 1
            else:
                # No scope tag, so an include record. The path is already
                # escaped (one line, printable), which is why it can be printed
                # into a WARN block without checking it first.
                if k.startswith("include:"):
                    k = k[len("include:"):]
                targets.append(k.rsplit(":", 1)[0])
        print(n_local)
        print(n_wt)
        for t in targets:
            print(t)
    elif mode == "programs":
        # Every pinned key that names a program git runs, tagged with its
        # scope. `loom new` and `loom pin-config` print these once, out loud:
        # the pin is a CHANGE check, so whatever is here is being adopted as
        # the baseline, and the operator should meet that fact at the moment of
        # pinning rather than never.
        for r in read(sys.argv[2]):
            key, sep, val = r.partition(b"\n")
            scope, k = scope_of(key.decode("utf-8", "replace"))
            if not scope:
                continue          # an include record; `summary` names those
            if not program_key(k.lower()):
                continue
            print("[%s] %s=%s"
                  % (scope, k, esc(val.decode("utf-8", "replace")) if sep else ""))
    else:
        sys.stderr.write("loom: internal error: unknown config mode '%s'\n" % mode)
        raise SystemExit(2)
except OSError as e:
    sys.stderr.write("loom: cannot read a recorded git config: %s\n" % e)
    raise SystemExit(2)
PY
}

# The repository's git config as it is NOW, NUL-delimited, in a temp file the
# caller removes. A NUL stream cannot survive a command substitution, so it goes
# through a file — the same reason history_paths uses one.
#
# THREE scopes, not one, because git reads three files and a linked worktree can
# write two of them:
#
#   local          $GITCOMMON/config — `.git/config`, shared by every worktree.
#   worktree-main  $GITCOMMON/config.worktree — the MAIN checkout's own scope.
#   worktree-task  $GITCOMMON/worktrees/<wt>/config.worktree — the task
#                  worktree's own scope, read through `git -C <worktree>`.
#
# The last two are live whenever `extensions.worktreeConfig` is on, and loom
# turns it on itself: the first `git sparse-checkout init` in a repository adds
# it (measured, git 2.34). `git config --local --list` NEVER shows a key from
# either of them, and a `core.hooksPath` in the MAIN checkout's `config.worktree`
# is honoured for every command run in your checkout — a merge included. So all
# three are read, and each entry is tagged with the scope it came from.
#
# The only key loom itself writes at worktree scope is `core.sparseCheckout`
# (via `fence_apply`'s `sparse-checkout init`), and `loom new` re-pins after
# that has run, exactly as it re-pins the local scope after the same command
# adds `extensions.worktreeConfig`.
#
# `git config --list` exits 1 when it finds nothing, and `--worktree --list`
# exits 128 when the scope's file does not exist at all — both are
# indistinguishable from a failure, so neither is treated as fatal here. It
# stays fail-CLOSED either way: an empty dump at `loom new` and a real one later
# is a mismatch, and a real one at `loom new` and an empty one later is a
# mismatch too. Only a git that fails identically at both ends makes the pin
# inert, and that is a repository in which nothing else works either.
config_snapshot() { # config_snapshot [<task-worktree>] -> the path of a temp dump
  local wt="${1:-}" f d taskgd="" wtcfg=""
  f="$(mktemp "${TMPDIR:-/tmp}/loom-gitconfig.XXXXXX")" \
    || die "cannot create a temporary file to read this repository's git config"
  d="$(mktemp -d "${TMPDIR:-/tmp}/loom-gitconfig-scopes.XXXXXX")" \
    || die "cannot create a temporary directory to read this repository's git config"
  git -C "$ROOT" config --local    --list --null > "$d/local"         2>/dev/null || true
  : > "$d/worktree-main"
  : > "$d/worktree-task"
  # `git config --worktree` is an ALIAS FOR `--local` when
  # `extensions.worktreeConfig` is off — git says so, and it means a repository
  # where the extension has not been turned on yet dumps every local key a
  # second time under a scope tag that is a lie, and reports "N local + N
  # worktree entries" for a repository with no worktree scope at all.
  #
  # So the two worktree scopes are read only when git would READ them. That is
  # fail-closed rather than a relaxation: turning the extension on is itself a
  # write to the LOCAL scope (`extensions.worktreeconfig=true`), which this
  # same pin refuses — a dormant `config.worktree` cannot be brought to life
  # without the change that does it being caught.
  wtcfg="$(git -C "$ROOT" config --local --get extensions.worktreeConfig 2>/dev/null || true)"
  case "$wtcfg" in
    true|yes|on|1) wtcfg=yes ;;
    *)             wtcfg="" ;;
  esac
  [ -z "$wtcfg" ] \
    || git -C "$ROOT" config --worktree --list --null > "$d/worktree-main" 2>/dev/null || true
  if [ -n "$wtcfg" ] && [ -n "$wt" ] && [ -d "$wt" ]; then
    git -C "$wt" config --worktree --list --null > "$d/worktree-task" 2>/dev/null || true
    # Where that worktree's own config.worktree lives, asked of git rather than
    # spelled out: the directory name under worktrees/ is git's, not the task's.
    taskgd="$(git -C "$wt" rev-parse --git-dir 2>/dev/null || true)"
    case "$taskgd" in ""|/*) ;; *) taskgd="$wt/$taskgd" ;; esac
  fi
  # The include closure is seeded from the SCOPE FILES, and a scope that was
  # not read has no file to resolve a relative include against.
  config_py snapshot "$f" \
    "$d/local"         "$GITCOMMON/config" \
    "$d/worktree-main" "${wtcfg:+$GITCOMMON/config.worktree}" \
    "$d/worktree-task" "${taskgd:+$taskgd/config.worktree}" \
    || { rm -rf "$d"; die "cannot read this repository's git config — refusing to guess what it says"; }
  rm -rf "$d"
  printf '%s\n' "$f"
}

# The task worktree whose worktree-scope config belongs in this task's pin, or
# "" when it does not exist yet (`loom new`'s first pin, before the add) or at
# all. wt_path follows the profile flag, which is the same answer every other
# command in this file gets.
config_wt() { # config_wt <task>
  local wt; wt="$(wt_path "$1")"
  [ -d "$wt" ] || return 0
  printf '%s\n' "$wt"
}

config_digest_of() { # config_digest_of <dump> -> its sha256
  local out
  out="$(config_py digest "$1")" \
    || die "cannot digest this repository's local git config — refusing to guess what it says"
  [ -n "$out" ] || die "cannot digest this repository's local git config — refusing to guess what it says"
  printf '%s\n' "$out"
}

config_write_sidecar() { # config_write_sidecar <task> <dump>
  local sc; sc="$(config_sidecar "$1")"
  ( umask 077; mkdir -p "$STATE_DIR/tasks" ) \
    || die "cannot create the operator state directory $STATE_DIR/tasks"
  ( umask 077; cp "$2" "$sc.tmp.$$" ) || die "cannot write the pinned git config $sc"
  chmod 600 "$sc.tmp.$$" 2>/dev/null || true
  mv "$sc.tmp.$$" "$sc" || die "cannot write the pinned git config $sc"
}

# What was pinned, said out loud, once, at `loom new`. The counts are there so
# that "loom pinned nothing" is visible rather than silent, and the WARN is
# there because an include is the one entry in a config that is not itself the
# thing being pinned: it names a file somewhere else, whose bytes are now part
# of this task's baseline and whose next edit is a refusal. The operator should
# know that file exists before they meet the refusal.
config_summary() { # config_summary <dump>
  local out n m targets
  out="$(config_py summary "$1" 2>/dev/null)" || return 0
  n="$(printf '%s\n' "$out" | sed -n 1p)"
  m="$(printf '%s\n' "$out" | sed -n 2p)"
  echo "loom: pinned ${n:-0} local + ${m:-0} worktree config entries" >&2
  targets="$(printf '%s\n' "$out" | sed -n '3,$p')"
  [ -n "$targets" ] || return 0
  echo "loom: WARN: this repository's git config pulls in other files (include.path /" >&2
  echo "loom: WARN: includeIf.<cond>.path). Their bytes are pinned to this task too, so" >&2
  echo "loom: WARN: an edit to one is a refusal — and an included file can carry every" >&2
  echo "loom: WARN: key .git/config can, core.hooksPath and credential.helper included:" >&2
  printf '%s\n' "$targets" | sed 's|^|loom: WARN:   |' >&2
}

# The keys in the pin that name a PROGRAM git runs, said out loud at the moment
# they are adopted — because that is the moment, and there is no other one.
#
# The pin is a CHANGE check: whatever `core.hooksPath`, `credential.helper`,
# `filter.<d>.clean`, `merge.<d>.driver`, `diff.<d>.textconv`/`.command`,
# `gpg.program`, `pager.<cmd>`, `core.attributesFile`, `core.sshCommand` or
# `include.path`/`includeIf.*` the repository ALREADY carried is the baseline
# and is trusted from here on (ARCHITECTURE.md § 5, residual 1). An operator
# who never sees that list has no way to know they accepted it. Printed per
# SCOPE, with the values escaped, because the three scopes have three different
# writers and "which file is this in" is the actionable half.
config_programs() { # config_programs <dump>
  local out
  out="$(config_py programs "$1" 2>/dev/null)" || return 0
  if [ -z "$out" ]; then
    echo "loom: the pinned config names no program for git to run" >&2
    return 0
  fi
  echo "loom: WARN: the pinned config names PROGRAMS git runs in YOUR session — on" >&2
  echo "loom: WARN: checkout, 'git add', commit, a merge, a fetch, a push or any" >&2
  echo "loom: WARN: subcommand at all. They are the BASELINE now: loom refuses a" >&2
  echo "loom: WARN: change to them and vouches for none of them." >&2
  printf '%s\n' "$out" | sed 's|^|loom: WARN:   |' >&2
}

# Re-pin: the config as it is NOW becomes task <task>'s baseline. Called by
# `--accept-config`, by `loom new` once its own worktree setup has run, and by
# `loom land --pr` after the `--set-upstream-to` it writes itself. Never called
# from a path an agent reaches.
config_repin() { # config_repin <task>
  local f d
  f="$(config_snapshot "$(config_wt "$1")")"; cfg_track "$f"
  d="$(config_digest_of "$f")" || { rm -f "$f"; return 1; }
  config_write_sidecar "$1" "$f"
  rm -f "$f"
  state_update "$1" "config=$d"
  # ... and the REPOSITORY's own baseline, which is what the roles with no task
  # are judged against. Pinning a task and baselining the repository are the
  # same operator act — `loom new`, `--accept-config`, and `land --pr`'s re-pin
  # after its own `--set-upstream-to` — so they happen in the same place. If
  # they did not, `land --pr` would leave `branch.<br>.remote` in the local
  # scope and the next `loom scout` would refuse a change loom itself made.
  repo_config_repin
}

# The git config a task was created against — all three scopes and the include
# closure — must still be the git config it runs, fetches, pushes, merges and
# lands against.
#
# WHERE THIS IS CALLED FROM IS PART OF THE CHECK. Every command puts it BEFORE
# its first fence operation, because `fence_reconcile` -> `fence_apply` ->
# `git sparse-checkout set` is a WORKING-TREE UPDATE: git materialises every
# path the new pattern list admits, and materialising a path runs the SMUDGE
# side of whatever `filter.<d>` a `.gitattributes` in that worktree selects.
# The `.gitattributes` is a file the agent writes (uncommitted is enough) and
# `filter.<d>.smudge` is one `git config` away — so with the check one line
# later the planted program ran, as the operator, before the pin that exists to
# refuse it ever spoke. It is called AGAIN at each of the old sites (per model
# attempt, before the push, before the merge, before the fetch and the replay);
# those are re-checks, not the first one.
require_recorded_config() { # require_recorded_config <task> <command-name>
  local task="$1" cmd="$2" rec now f changed
  rec="$(state_read "$task" config)"
  # No record AT ALL is a different fact from "a record that pins no config",
  # and it now reaches this line first (the pin is checked before the fence
  # operations, ahead of everything that used to speak for a missing record).
  # Say the thing that is actually wrong, in the words written for it.
  [ -f "$(state_file "$task")" ] || require_record "$task"
  [ -n "$rec" ] || die "the operator record for task $task pins no git config.
That record was written by a loom from before the git config was pinned, so
there is nothing to compare this repository's config against — and loom will not
run, fetch, push or merge against a config it cannot vouch for. Start clean:
  loom drop $task && loom new $task"
  f="$(config_snapshot "$(config_wt "$task")")"; cfg_track "$f"
  now="$(config_digest_of "$f")"
  if [ "$rec" = "$now" ]; then rm -f "$f"; return 0; fi
  changed="$(config_py diff "$(config_sidecar "$task")" "$f" 2>&1)" \
    || changed="  (the pinned list is unreadable: $(config_sidecar "$task"))"
  rm -f "$f"
  if [ -n "$FLAG_ACCEPT_CONFIG" ]; then
    {
      echo "loom: --accept-config: this repository's git config is not the one task"
      echo "loom: $task was created against. What changed:"
      printf '%s\n' "$changed"
      echo "loom: re-recording it as the baseline. loom vouches for none of it — you do."
    } >&2
    config_repin "$task" || die "cannot re-record the git config for task $task"
    return 0
  fi
  die "this repository's git config is not the one task $task was created against:
$changed
Each line names the SCOPE it came from. '.git/config' ([local]) is in the SHARED
git directory, so every linked worktree can write it with one command;
'.git/config.worktree' ([worktree-main]) is the MAIN checkout's own scope, and
'.git/worktrees/<wt>/config.worktree' ([worktree-task]) is the agent worktree's,
one 'git config --worktree' away from inside it. An 'include:<path>:<sha256>'
line is a file the config PULLS IN — '--list' shows those directives as pointers
and never the keys behind them, so the target's bytes are pinned too.
None of these keys are preferences. core.hooksPath decides which hooks run (in
YOUR checkout, during a merge); filter.<d>.clean, merge.<d>.driver and
diff.<d>.textconv are programs run on checkout, 'git add', commit and a
conflicted merge; credential.helper and core.askPass are programs that are ALSO
handed your credentials; gpg.program, pager.<cmd> (any subcommand, plumbing
included) and include.path/includeIf.* are more of the same. loom will not $cmd
against a config it cannot vouch for.
If that change is YOURS — or an agent ran 'git config user.name', which loom
never does for you — re-record it and carry on:
  loom $cmd $task${FLAG_PROFILE:+ --fence-profile $FLAG_PROFILE} --accept-config
Otherwise put it back:
  git config --local --list                    # the [local] lines
  git config --worktree --list                 # the [worktree-main] lines
  git -C <the task worktree> config --worktree --list   # the [worktree-task] ones
or start clean:  loom drop $task && loom new $task"
}

# ------------------------------------ the REPOSITORY's own config baseline
# The pin above answers "has this repository's config moved under task <t>".
# Two roles never got to ask, because they have no task: `loom plan`'s
# architect, which runs in $ROOT — YOUR checkout — and `loom scout`, which runs
# in the shared `$WT_ROOT/_scout` mirror. Both are model launches, and the
# scout's is a WORKTREE OPERATION as well: `fence_apply` -> `sparse-checkout
# set`, the `reset --hard` and the `checkout` beside it are all working-tree
# updates, and a working-tree update runs the SMUDGE side of whatever
# `filter.<d>` a `.gitattributes` there selects. The driver is read out of the
# SHARED `.git/config` — one `git config` from inside ANY agent's worktree — so
# `loom scout` ran a planted program as the operator with no pin anywhere in
# the path. `loom plan` is the same launch without the tree.
#
# So the REPOSITORY gets a baseline of its own, beside the task records and
# never inside one:
#
#   $STATE_DIR/config            the digest, one sha256, mode 0600
#   $STATE_DIR/config.gitconfig  the dump it was taken over, mode 0600, so a
#                                mismatch is a diff and not two digests
#
# It covers the scopes that belong to the REPOSITORY — `local` and
# `worktree-main` — and the include closure of both. The `worktree-task` scope
# is deliberately absent: there is no task here, and folding one in would make
# the baseline move every time any task's worktree gained a sparse rule, which
# is a refusal per `loom new` for a change loom itself made.
#
# It is written wherever a task is pinned (config_repin: `loom new`,
# `--accept-config`, `land --pr`'s re-pin) and by `loom pin-config`, which is
# the explicit operator command — and the answer for a repository that has no
# tasks at all. It is NOT removed by `loom drop`: it is a fact about the
# repository, not about a task, and a `loom scout` after the last task was
# dropped must still have something to be judged against.
repo_config_file()    { printf '%s\n' "$STATE_DIR/config"; }
repo_config_sidecar() { printf '%s\n' "$STATE_DIR/config.gitconfig"; }

# The recorded digest, or "" when there is none. A file that is not one loom
# wrote is a dead stop rather than a "" that reads as "never baselined" — the
# same rule state_read applies to a task record, and for the same reason: this
# is the one input the task-less roles have.
repo_config_read() {
  local f v
  f="$(repo_config_file)"
  [ -f "$f" ] || return 0
  v="$(cat "$f")" || die "cannot read the repository git config baseline $f"
  # One line of 64 hex digits. A second line, or anything else, is refused
  # here — a newline is not a hex digit, so the pattern catches it.
  case "$v" in
    ""|*[!0-9a-f]*)
      die "the repository git config baseline is not one loom wrote:
  $f
It holds one sha256 and nothing else. Re-record it deliberately, having looked
at what the config now says:
  loom pin-config --accept-config" ;;
  esac
  [ "${#v}" -eq 64 ] || die "the repository git config baseline is not one loom wrote:
  $f
It holds one sha256 (64 hex digits) and nothing else. Re-record it deliberately:
  loom pin-config --accept-config"
  printf '%s\n' "$v"
}

repo_config_write() { # repo_config_write <dump>
  local f sc d
  f="$(repo_config_file)"; sc="$(repo_config_sidecar)"
  d="$(config_digest_of "$1")"
  ( umask 077; mkdir -p "$STATE_DIR" ) \
    || die "cannot create the operator state directory $STATE_DIR"
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  ( umask 077; printf '%s\n' "$STATE_MAIN_ROOT" > "$STATE_DIR/repo" ) || true
  # The dump first, the digest second. A crash between the two leaves a digest
  # that no longer matches the dump beside it, which is a REFUSAL — the
  # fail-closed half of the pair. The other order would leave a digest that
  # matches the live config with a stale dump beside it, i.e. a pass.
  ( umask 077; cp "$1" "$sc.tmp.$$" ) || die "cannot write the repository git config baseline $sc"
  chmod 600 "$sc.tmp.$$" 2>/dev/null || true
  mv "$sc.tmp.$$" "$sc" || die "cannot write the repository git config baseline $sc"
  ( umask 077; printf '%s\n' "$d" > "$f.tmp.$$" ) || die "cannot write the repository git config baseline $f"
  chmod 600 "$f.tmp.$$" 2>/dev/null || true
  mv "$f.tmp.$$" "$f" || die "cannot write the repository git config baseline $f"
}

# The config as it is NOW becomes the repository's baseline. No worktree
# argument: the task scope is not the repository's.
repo_config_repin() {
  local f
  f="$(config_snapshot)"; cfg_track "$f"
  repo_config_write "$f"
  rm -f "$f"
}

# The repository's config must still be the config its baseline was recorded
# against. Called by `loom scout` (in scout_root, BEFORE the first thing that
# touches the mirror) and by `loom plan` (before the architect runs), and again
# by run_role before every task-less model launch — per attempt, for the same
# reason the task pin is re-read per attempt.
require_recorded_config_repo() { # require_recorded_config_repo <command-name>
  local cmd="$1" rec now f changed
  repo_config_read > /dev/null          # judge the file's shape in THIS shell
  rec="$(repo_config_read)"
  [ -n "$rec" ] || die "no repository config baseline — run \`loom new\` for any task, or \`loom pin-config\`.
This command runs a model with no task behind it, so there is no task record to
compare this repository's git config against — and the config is where
core.hooksPath, filter.<d>.smudge, credential.helper and include.path live, all
of which name a program git runs in YOUR session. \`loom scout\` in particular
updates a working tree (the shared _scout mirror), which is what runs a planted
smudge filter. loom will not $cmd against a config it cannot vouch for:
  loom pin-config          # record what this repository's config says now"
  f="$(config_snapshot)"; cfg_track "$f"
  now="$(config_digest_of "$f")"
  if [ "$rec" = "$now" ]; then rm -f "$f"; return 0; fi
  changed="$(config_py diff "$(repo_config_sidecar)" "$f" 2>&1)" \
    || changed="  (the recorded list is unreadable: $(repo_config_sidecar))"
  [ -n "$changed" ] \
    || changed="  (the digest moved but the recorded list did not — the baseline was
  written half-way. Re-record it: loom pin-config --accept-config)"
  rm -f "$f"
  die "this repository's git config is not the one its baseline was recorded against:
$changed
Each line names the SCOPE it came from. '.git/config' ([local]) is in the SHARED
git directory, so every linked worktree can write it with one command, and
'.git/config.worktree' ([worktree-main]) is your own checkout's scope. An
'include:<path>:<sha256>=<bytes>' line is a file the config PULLS IN.
None of these keys are preferences: core.hooksPath decides which hooks run,
filter.<d>.smudge runs on every working-tree update — which is exactly what
'loom scout' does to its mirror — and credential.helper and core.askPass are
handed your credentials as well as being run. loom will not $cmd against a
config it cannot vouch for.
If that change is YOURS, record it and carry on:
  loom pin-config --accept-config
Otherwise put it back:
  git config --local --list                    # the [local] lines
  git config --worktree --list                 # the [worktree-main] lines"
}

# The record AND its config sidecar: the two are one fact, and a sidecar left
# behind for a dropped task would be read as the baseline of the NEXT task with
# that id if `loom new` ever failed between writing the record and writing it.
#
# The REPOSITORY baseline ($STATE_DIR/config) is deliberately not touched here:
# it is not this task's.
state_rm() { rm -f "$(state_file "$1")" "$(config_sidecar "$1")"; }

# ------------------------------------------------------------ worktree roots
# Two roots, and `loom` must be able to say where each one physically IS before
# it puts anything in them. A task under a fence profile holds paths the fence
# normally removes, so its worktree lives under a SEPARATE root: nothing that
# runs unprofiled — no unprofiled role, and not the shared `_scout` mirror,
# which stays under $WT_ROOT — is ever handed a directory that CONTAINS a
# profiled worktree.
#
# The profiled root is DERIVED, never taken: "$WT_ROOT-profiled", from the
# normalised $WT_ROOT and nothing else, so LOOM_WORKTREES stays the one knob
# and a preset WT_ROOT_PROFILED cannot aim released content somewhere else. It
# is deliberately a SIBLING, not a child ("$WT_ROOT-profiled" is not under
# "$WT_ROOT/"), which is why the normalisation below strips both "/" and "/."
# — with LOOM_WORKTREES=/x/wt/ or /x/wt/. the naive concatenation would produce
# "/x/wt/-profiled" or "/x/wt/.-profiled", both CHILDREN of the unprofiled root.
#
# Then each root is resolved and refused if the resolved path is not the
# literal one. A root that is a symlink is not the directory the operator
# named: an agent that plants "$WT_ROOT-profiled -> $WT_ROOT/T5" would
# otherwise have every released path checked out inside a directory an
# unprofiled run is pointed at.
#
# The PARENT chain is resolved on both sides of the comparison, so it cancels
# out: a repo under a symlinked /tmp is ordinary and not an attack, while a
# symlink AT the root is caught. Resolution goes through python3 (already
# required, for zones) rather than `cd && pwd -P`, so that a root which does
# not exist yet can still be resolved — `loom doctor`, `loom zone` and the
# pre-commit guard must not create directories as a side effect of starting up.
resolve_root() { # resolve_root <literal-dir>  -> its physical path
  local lit="$1" out want real
  out="$(python3 - "$lit" << 'RESOLVE'
import os, sys
lit = sys.argv[1]
print(os.path.join(os.path.realpath(os.path.dirname(lit)), os.path.basename(lit)))
print(os.path.realpath(lit))
RESOLVE
  )" || die "cannot resolve the worktree root $lit"
  want="$(printf '%s\n' "$out" | sed -n 1p)"
  real="$(printf '%s\n' "$out" | sed -n 2p)"
  [ -n "$want" ] && [ -n "$real" ] || die "cannot resolve the worktree root $lit"
  [ "$real" = "$want" ] || die "worktree root $lit resolves to $real, which is not
where its name says it is — a '..' component in the path, or something that
replaced the root itself with a symlink. Inspect it, do not re-run."
  printf '%s\n' "$want"
}

# Captured AFTER both env files have been sourced, because .agents/loom.env is
# exactly the place a preset would come from: it is a file in the tree an agent
# writes, and it is `.`-sourced (KNOWN-GAPS 3).
WT_ROOT_PRESET="${WT_ROOT_PROFILED:-}"
WT_ROOT="${LOOM_WORKTREES:-$(dirname "$ROOT")/.loom-worktrees/$(basename "$ROOT")}"
case "$WT_ROOT" in /*) ;; *) die "LOOM_WORKTREES must be an absolute path (got '$WT_ROOT')" ;; esac
while :; do
  case "$WT_ROOT" in
    /|"") break ;;
    */)   WT_ROOT="${WT_ROOT%/}" ;;
    */.)  WT_ROOT="${WT_ROOT%/.}" ;;
    *)    break ;;
  esac
done
[ -n "$WT_ROOT" ] && [ "$WT_ROOT" != / ] \
  || die "LOOM_WORKTREES normalises to '$WT_ROOT', which is not a usable worktree root"
WT_ROOT="$(resolve_root "$WT_ROOT")"
WT_ROOT_PROFILED="${WT_ROOT}-profiled"
if [ -n "$WT_ROOT_PRESET" ] && [ "$WT_ROOT_PRESET" != "$WT_ROOT_PROFILED" ]; then
  die "WT_ROOT_PROFILED is preset to '$WT_ROOT_PRESET', but it is DERIVED from
LOOM_WORKTREES and must be '$WT_ROOT_PROFILED'. A profiled worktree holds paths
the fence normally removes; where it lands is not something the environment or
.agents/loom.env gets to redirect. Unset it, or set LOOM_WORKTREES instead."
fi
WT_ROOT_PROFILED="$(resolve_root "$WT_ROOT_PROFILED")"
# Neither root may contain the other, and neither may sit inside the repo: a
# released path under $ROOT is in YOUR checkout, and a profiled worktree under
# $WT_ROOT is exactly what the split root exists to prevent.
case "$WT_ROOT_PROFILED" in
  "$WT_ROOT"|"$WT_ROOT"/*) die "the profiled worktree root $WT_ROOT_PROFILED is inside $WT_ROOT" ;;
esac
case "$WT_ROOT" in
  "$WT_ROOT_PROFILED"|"$WT_ROOT_PROFILED"/*) die "the worktree root $WT_ROOT is inside $WT_ROOT_PROFILED" ;;
esac
for _r in "$WT_ROOT" "$WT_ROOT_PROFILED"; do
  case "$_r" in
    "$ROOT_REAL"|"$ROOT_REAL"/*) die "worktree root $_r is inside the repository $ROOT_REAL — \
agent worktrees must live outside your checkout (set LOOM_WORKTREES)" ;;
  esac
done
unset _r

# Every `git worktree add` in this file is bracketed by these two. The roots
# were verified at startup, but a directory is not a promise: the parent of the
# path about to be created is re-resolved immediately before the add, and the
# created worktree immediately after.
assert_wt_parent() { # assert_wt_parent <worktree-path> <expected-root>
  local wt="$1" want="$2" got
  got="$(cd "$(dirname "$wt")" 2>/dev/null && pwd -P)" \
    || die "cannot resolve $(dirname "$wt") — refusing to create a worktree there"
  [ "$got" = "$want" ] || die "refusing to create the worktree $wt: its parent resolves to
  $got
but this command's worktree root is
  $want
Something moved or re-linked the root; inspect it, do not re-run."
}
assert_wt_under() { # assert_wt_under <worktree-path> <expected-root>
  local wt="$1" want="$2" got
  got="$(cd "$wt" 2>/dev/null && pwd -P)" \
    || die "the worktree $wt was created but cannot be resolved"
  case "$got" in
    "$want"/*) ;;
    *) die "the worktree $wt resolved to $got, which is not under $want — \
remove it by hand and inspect the root" ;;
  esac
}

# ------------------------------------------ is this worktree OURS at all?
# `$wt/.git` in a linked worktree is a FILE — one line, `gitdir: <path>` — and
# it is an ordinary file in a directory the agent owns. Rewrite it and the
# directory stops being this repository's worktree: every `git -C "$wt" …`
# after that reads a git directory of the writer's choosing — ITS config
# (`filter.<d>.clean`, `core.hooksPath`, `credential.helper`), its refs, its
# objects, its hooks — while the path, the task id and the branch name all go
# on reading exactly as they did.
#
# Nothing downstream noticed, and the reason is worth spelling out: a decoy
# repository built with the SAME BRANCH NAME answers
# `git -C "$wt" symbolic-ref HEAD` with `refs/heads/agent/<task>` (measured),
# so `require_wt_on_branch` — the check whose whole job is "is this tree the
# branch's tree" — passed it. `loom drop` then could not clean up either: git
# refuses to remove a worktree it does not own, and the removal was written
# `|| true`, so the command printed "dropped" over a directory that was still
# there with the released paths still in it.
#
# THREE facts, each of them asked of git and compared against a path this
# process resolved at startup, before any worktree was touched:
#
#   1. the worktree's COMMON dir is this repository's shared .git ($GITCOMMON).
#      This is the one that catches the rewritten `.git` file outright.
#   2. its top level is the directory we asked about — not a tree somewhere
#      else that a `core.worktree` or a moved gitdir re-aimed it at.
#   3. its own git dir is under `$GITCOMMON/worktrees/`, i.e. git knows it as a
#      LINKED WORKTREE OF THIS REPO, and not as a main checkout that happens to
#      share objects or as another repository's linked worktree.
#
# Every path is realpath'd on BOTH sides, so a repo under a symlinked /tmp
# cancels out (ordinary, not an attack) while a symlink planted at one of them
# does not. git may answer relatively (`--git-common-dir` is `.git` in a main
# checkout), so a relative answer is resolved against $wt — which is the
# directory `git -C` was run in.
require_wt_is_ours() { # require_wt_is_ours <worktree>
  local wt="$1" common gd top out bad="" r_common r_gd r_top r_wt r_git
  [ -d "$wt" ] || die "no worktree at $wt — refusing to judge a directory that is not there"
  common="$(git -C "$wt" rev-parse --git-common-dir 2>/dev/null || true)"
  gd="$(git -C "$wt" rev-parse --git-dir 2>/dev/null || true)"
  top="$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$common" ] || [ -z "$gd" ] || [ -z "$top" ]; then
    die "worktree $wt does not belong to this repository — git cannot resolve it as a
worktree at all (its .git file, or the git directory it names, is gone or
unreadable). An agent rewrote it: 'loom drop' will not remove it either, because
git refuses to remove a worktree it does not own. Inspect it by hand:
  cat $wt/.git
  git worktree list"
  fi
  out="$(python3 - "$wt" "$GITCOMMON" "$common" "$gd" "$top" "$wt" << 'REAL'
import os, sys
wt = sys.argv[1]
for p in sys.argv[2:]:
    if not os.path.isabs(p):
        p = os.path.join(wt, p)
    print(os.path.realpath(p))
REAL
  )" || die "cannot resolve the git directory of $wt — refusing to judge it"
  r_git="$(printf '%s\n' "$out" | sed -n 1p)"
  r_common="$(printf '%s\n' "$out" | sed -n 2p)"
  r_gd="$(printf '%s\n' "$out" | sed -n 3p)"
  r_top="$(printf '%s\n' "$out" | sed -n 4p)"
  r_wt="$(printf '%s\n' "$out" | sed -n 5p)"
  [ -n "$r_git" ] && [ -n "$r_common" ] && [ -n "$r_gd" ] && [ -n "$r_top" ] && [ -n "$r_wt" ] \
    || die "cannot resolve the git directory of $wt — refusing to judge it"
  [ "$r_common" = "$r_git" ] || bad="$r_common"
  [ -n "$bad" ] || [ "$r_top" = "$r_wt" ] || bad="$r_top"
  if [ -z "$bad" ]; then
    case "$r_gd" in "$r_git"/worktrees/*) ;; *) bad="$r_gd" ;; esac
  fi
  [ -z "$bad" ] || die "worktree $wt does not belong to this repository — its .git points at $bad;
an agent rewrote it: loom drop $wt will not remove it; inspect by hand.
What git answers for that directory, against what this repository is:
  --git-common-dir  $r_common
  --git-dir         $r_gd
  --show-toplevel   $r_top
  this repository   $r_git
  this directory    $r_wt
Every command loom would run there — the fence, the gate, the review patch, the
merge — would read that repository's config, its hooks and its refs instead of
this one's. Nothing is done to it automatically:
  cat $wt/.git
  git worktree list"
  return 0
}

# Which root a given worktree path belongs to. Used to name the root an add is
# expected to land under, without re-deriving it from the path being checked.
root_of_wt() { # root_of_wt <worktree-path>
  case "$1" in
    "$WT_ROOT_PROFILED"/*) printf '%s\n' "$WT_ROOT_PROFILED" ;;
    "$WT_ROOT"/*)          printf '%s\n' "$WT_ROOT" ;;
    *) die "internal error: $1 is under neither worktree root" ;;
  esac
}

# Portable in-place sed (BSD sed on macOS needs -i '').
sedi() {
  local expr="$1" file="$2"
  if sed --version >/dev/null 2>&1; then sed -i -e "$expr" "$file"
  else sed -i '' -e "$expr" "$file"; fi
}

relpath() { # relpath <path> [<base>]
  python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' \
    "$1" "${2:-$ROOT}"
}

# ---------------------------------------------------------------- model tiers
# Ordered fallback chains. "claude-sub" means the `claude` CLI on your
# subscription and "codex-sub" the `codex` CLI on your ChatGPT one; everything
# else is opencode's built-in provider/model IDs.
# Verify IDs with: loom doctor   (they move fast)
models_for() {
  local role="$1" override
  # LOOM_MODELS_reviewer="codex-sub deepseek/deepseek-v4-pro" replaces the whole
  # chain for one role. printenv, not eval: the value is data, not shell.
  override="$(printenv "LOOM_MODELS_$role" 2>/dev/null || true)"
  if [ -n "$override" ]; then echo "$override"; return 0; fi
  case "$TIER:$role" in
    deep:architect|standard:architect)
                         echo "claude-sub zai-coding-plan/glm-5.3 moonshotai/kimi-k2.5" ;;
    lean:architect)      echo "zai-coding-plan/glm-5.3 moonshotai/kimi-k2.5 deepseek/deepseek-v4-pro" ;;

    deep:implementer)    echo "zai-coding-plan/glm-5.3 moonshotai/kimi-k2.7-code deepseek/deepseek-v4-pro" ;;
    standard:implementer|lean:implementer)
                         echo "zai-coding-plan/glm-5.3 deepseek/deepseek-v4-pro moonshotai/kimi-k2.5" ;;

    deep:reviewer)       echo "codex-sub claude-sub moonshotai/kimi-k2.5 deepseek/deepseek-v4-pro" ;;
    standard:reviewer)   echo "codex-sub moonshotai/kimi-k2.5 deepseek/deepseek-v4-pro zai-coding-plan/glm-5.3" ;;
    lean:reviewer)       echo "deepseek/deepseek-v4-flash zai-coding-plan/glm-5.3-flash" ;;

    *:scout)             echo "zai-coding-plan/glm-5.3-flash deepseek/deepseek-v4-flash" ;;
    *)                   echo "zai-coding-plan/glm-5.3" ;;
  esac
}

key_for_provider() {
  case "$1" in
    zai|zai-coding-plan)
                echo "${ZHIPU_API_KEY:-}" ;;
    moonshotai) echo "${MOONSHOT_API_KEY:-}" ;;
    deepseek)   echo "${DEEPSEEK_API_KEY:-}" ;;
    *)          echo "" ;;
  esac
}

provider_of() { case "$1" in claude-sub) echo "claude" ;; codex-sub) echo "codex" ;; *) echo "${1%%/*}" ;; esac; }

# Roles that EDIT their working directory. `build` runs under your eye in your
# own tree; `implementer` (which `loom loop`'s auto-fix rounds also go through)
# owns one worktree. Everything else — reviewer, scout, architect — reads.
writes_role() { case "$1" in implementer|build) return 0 ;; *) return 1 ;; esac; }

skipped() { # skipped <provider>
  local p
  for p in $SKIP; do
    case "$1" in "$p"*) return 0 ;; esac
    [ "$p" = anthropic ] && [ "$1" = claude ] && return 0
  done
  return 1
}

usable() { # usable <model-token>
  local prov; prov="$(provider_of "$1")"
  skipped "$prov" && return 1
  if [ "$1" = claude-sub ]; then have claude
  elif [ "$1" = codex-sub ]; then
    # A ChatGPT login writes ~/.codex/auth.json; an API key is the other way in.
    have codex && { [ -f "${CODEX_HOME:-$HOME/.codex}/auth.json" ] \
                 || [ -n "${CODEX_API_KEY:-}${OPENAI_API_KEY:-}" ]; }
  else [ -n "$(key_for_provider "$prov")" ] && have opencode; fi
}

# `set -f`: a chain is a space-separated list and $LOOM_MODELS_<role> is data,
# so the split is deliberate and the globbing is not (same bracket as
# profile_provider_guard). Runs in a subshell at every call site anyway.
candidates() {
  local m out=""
  set -f
  # shellcheck disable=SC2086  # deliberate word split; globbing is disabled
  for m in $(models_for "$1"); do usable "$m" && out="$out $m"; done
  set +f
  echo "$out"
}
pick_model() {
  local c; c="$(candidates "$1")"
  [ -n "${c// /}" ] || die "no usable model for role '$1' at tier '$TIER' (skip='$SKIP') — set an API key or install claude/opencode"
  echo "$c" | awk '{print $1}'
}

looks_rate_limited() { # looks_rate_limited <logfile>
  grep -qiE '429|rate[ _-]?limit|too many request|quota|overloaded|exhaust|usage limit|insufficient[ _-]?(balance|quota|credit)' "$1" 2>/dev/null
}

# Headless model calls read stdin for appended message input when it is a
# non-TTY stream; a caller that keeps stdin open (CI, cron, another agent's
# shell) therefore hangs the run forever in poll. Found live: `loom run` from a
# backgrounded shell sat 100 minutes in ep_poll before the first model call.
# /dev/null guarantees EOF for both legs.
run_headless() { # run_headless <role> <model> <workdir> <prompt> <logfile>
  local role="$1" model="$2" wd="$3" prompt="$4" log="$5" rc=0 last=""
  # Resolve the workdir through its symlinks ONCE, and use the resolved path
  # everywhere below: it is what the sandbox roots are computed from, and a
  # sandbox root that is a symlink is not the directory the caller meant.
  wd="$(cd "$wd" 2>/dev/null && pwd -P)" || die "workdir does not exist: $3"
  # The edit permission is granted per ROLE, never per model. A reviewer keeps
  # the most read-only shape each CLI offers — `codex exec --sandbox read-only`
  # and a bare `claude -p`, which denies every permission prompt because nobody
  # is there to answer it. The opencode leg has NO OS sandbox at all: an
  # opencode reviewer is held by the role prompt, the fence, and the profile's
  # provider rule, not by the process. An implementer-class role gets a
  # write-capable sandbox, rooted at $wd.
  local -a claude_flags=(-p)
  local -a cflags=(--sandbox read-only)
  if writes_role "$role"; then
    claude_flags+=(--permission-mode acceptEdits)
    # acceptEdits pre-approves file edits, but a Bash call still asks — and a
    # `-p` run has nobody to answer, so it is denied. Measured: the implementer
    # wrote its files and then reported "every attempt to run the gate script
    # was denied by the session's permission mode". The gate is allowlisted by
    # name so the implementer protocol can run at all.
    #
    # This is a CONVENIENCE BOUNDARY, not a sandbox: the allowlist names the
    # gate SCRIPT, and .agents/gate.sh is a file the implementer can edit. An
    # agent that wants a shell writes one into the gate. What actually confines
    # the claude leg is the worktree it runs in and the fence applied to it.
    # Widen deliberately with LOOM_CLAUDE_ALLOWED_TOOLS (same syntax as
    # `claude --allowedTools`) if a repo's implementer needs more shell.
    claude_flags+=(--allowedTools "${LOOM_CLAUDE_ALLOWED_TOOLS:-Bash(./.agents/gate.sh),Bash(./.agents/gate.sh:*),Bash(bash ./.agents/gate.sh:*),Bash(.agents/gate.sh:*)}")
    cflags=(--sandbox workspace-write)
    # codex's workspace-write sandbox keeps the workspace's dot-directories
    # read-only, so without this the implementer cannot write its done/blocked
    # notes — measured: "Could not write `.agents/reviews/<task>-done.md`
    # because `.agents` is read-only in this workspace".
    #
    # --add-dir names a writable ROOT, so it must not be handed a path that
    # resolves outside the worktree. `.agents` is a tracked directory an agent
    # can replace with a symlink; resolve it and refuse anything that leaves
    # $wd, rather than granting write access to wherever it points.
    if [ -d "$wd/.agents" ]; then
      local adir
      adir="$(cd "$wd/.agents" 2>/dev/null && pwd -P)" \
        || die "cannot resolve $wd/.agents — refusing to open a sandbox root"
      case "$adir" in
        "$wd"/*) cflags+=(--add-dir "$adir") ;;
        *) die "refusing to run $role in $wd: .agents resolves to $adir, outside the
worktree. Something replaced it with a link out of the tree — inspect it, do
not re-run." ;;
      esac
    fi
  fi
  if [ "$model" = claude-sub ]; then
    ( cd "$wd" && claude "${claude_flags[@]}" \
        --append-system-prompt "$(cat "$PROMPTS_DIR/$role.md")" \
        "$prompt" ) < /dev/null > "$log" 2>&1 || rc=$?
  elif [ "$model" = codex-sub ]; then
    # `codex exec` has no --append-system-prompt, so the role prompt is
    # prepended to the message instead. --skip-git-repo-check because a worktree parked
    # under $WT_ROOT can read as "outside a repository"; harmless in one.
    # The transcript is banner + answer + "tokens used", but cmd_check copies
    # the log verbatim into the review file, so the final message goes to a
    # sidecar and replaces the log on success. A failed run keeps the
    # transcript: looks_rate_limited reads it.
    last="$(mktemp "${TMPDIR:-/tmp}/loom-codex.XXXXXX")"
    ( cd "$wd" && codex exec "${cflags[@]}" --skip-git-repo-check \
        --output-last-message "$last" \
        "$(cat "$PROMPTS_DIR/$role.md")

$prompt" ) < /dev/null > "$log" 2>&1 || rc=$?
    if [ "$rc" -eq 0 ] && [ -s "$last" ]; then cat "$last" > "$log"; fi
    rm -f "$last"
  else
    # opencode's `external_directory` permission defaults to "ask", and a
    # headless run auto-REJECTS every ask — a `cd <subdir> && perl -pi …`
    # edit inside the worktree died on it (the parser reported the worktree
    # parent). This used to be granted for the whole worktree ROOT, which with
    # fence profiles is too much: another task's worktree under the same root
    # may hold paths a profile released to a provider THIS run is not allowed
    # to be. The grant is now THIS role's own resolved workdir and nothing
    # else; a profiled worktree lives under a different root entirely
    # ($WT_ROOT_PROFILED), so it is not even a sibling of an unprofiled one.
    # If a live opencode ever rejects an in-worktree edit again, see
    # docs/KNOWN-GAPS.md § 4 for the exact symptom. A caller-provided
    # OPENCODE_PERMISSION wins untouched.
    local perm="${OPENCODE_PERMISSION:-}"
    if [ -z "$perm" ]; then
      perm="$(printf '{"external_directory":{"%s/*":"allow","%s/**":"allow"}}' "$wd" "$wd")"
    fi
    # opencode resolves its project config from the CWD: <worktree>/opencode.json
    # and <worktree>/.opencode/opencode.json, both tracked files an agent in
    # that worktree can rewrite. Everything the profile's provider rule is built
    # on lives there — `provider.<name>.options.baseURL` repoints a provider at
    # any endpoint, and the agent definitions carry the role prompts — so an
    # agent could answer as "deepseek" from a host of its choosing, or hand
    # itself a different role prompt, without `loom` seeing anything change.
    #
    # opencode 1.x has the two knobs this needs, and BOTH are required:
    #   OPENCODE_CONFIG=<file>            load this config explicitly, and
    #   OPENCODE_DISABLE_PROJECT_CONFIG=1 do not load the project's own.
    # The first alone is not a fix: it is merged BEFORE the project files, so
    # the worktree's copy would still win key by key.
    #
    # The disable is UNCONDITIONAL — it does not depend on the operator having
    # a config of their own. It used to, and that was backwards: a repo with no
    # $ROOT/.opencode/opencode.json is exactly the repo where the worktree's
    # copy is the ONLY config, so it is where an agent-written opencode.json
    # would have been read in full. `loom` names the operator's config when one
    # exists and turns the project's off either way; a repo that needs agent
    # definitions must keep them in the operator's copy.
    #
    # The cost, stated plainly: with the project config off, opencode no longer
    # reads the worktree's AGENTS.md/CLAUDE.md or any project-local plugin —
    # the role prompt now comes from $ROOT/.opencode (via `{file:./prompts/…}`
    # in the operator's config), which is the same copy the claude and codex
    # legs already use. A caller that sets OPENCODE_CONFIG/OPENCODE_CONFIG_DIR
    # itself wins untouched, exactly like OPENCODE_PERMISSION — the disable is
    # the one thing no caller turns off.
    local -a ocenv=("OPENCODE_PERMISSION=$perm" "OPENCODE_DISABLE_PROJECT_CONFIG=1")
    if [ -n "${OPENCODE_CONFIG:-}" ]; then
      ocenv+=("OPENCODE_CONFIG=$OPENCODE_CONFIG")
    elif [ -f "$ROOT/.opencode/opencode.json" ]; then
      ocenv+=("OPENCODE_CONFIG=$ROOT/.opencode/opencode.json")
    fi
    if [ -n "${OPENCODE_CONFIG_DIR:-}" ]; then
      ocenv+=("OPENCODE_CONFIG_DIR=$OPENCODE_CONFIG_DIR")
    elif [ -d "$ROOT/.opencode" ]; then
      ocenv+=("OPENCODE_CONFIG_DIR=$ROOT/.opencode")
    fi
    # OPENCODE_CONFIG_CONTENT is an INLINE config: a whole opencode.json in an
    # environment variable, and therefore a way to hand opencode a provider
    # baseURL and a set of role prompts without any file `loom` looks at. It is
    # stripped from every launch — no caller wins this one, because there is no
    # way to tell the operator's inline config from an inherited one.
    ( cd "$wd" && env -u OPENCODE_CONFIG_CONTENT "${ocenv[@]}" \
        opencode run --agent "$role" --model "$model" "$prompt" ) \
      < /dev/null > "$log" 2>&1 || rc=$?
  fi
  cat "$log"
  return $rc
}

# 0 = this workdir is one of `loom`'s own task worktrees (either root).
in_task_worktree() { # in_task_worktree <dir>
  [ "${1#"$WT_ROOT"/}" != "$1" ] || [ "${1#"$WT_ROOT_PROFILED"/}" != "$1" ]
}

run_role() { # run_role <role> <workdir> <prompt> [<logfile>]
  local role="$1" wd="$2" prompt="$3"
  local log="${4:-$(mktemp "${TMPDIR:-/tmp}/loom-$role.XXXXXX")}"
  local m tried=""
  local -a chain=()
  # A chain is a space-separated list, and $LOOM_MODELS_<role> is operator
  # data: expand it with globbing OFF, into an array, once.
  set -f
  # shellcheck disable=SC2086  # deliberate word split; globbing is disabled
  for m in $(candidates "$role"); do chain+=("$m"); done
  set +f
  for m in ${chain[0]+"${chain[@]}"}; do
    # Defence in depth, and it runs PER ATTEMPT, not once. Attempt 1 can widen
    # the tree it was handed — `git sparse-checkout disable` costs one command —
    # and then hit a rate limit; attempt 2 would otherwise inherit that tree on
    # a different provider. Measured in round 2: GLM relaxed the sparse checkout
    # and returned 429, and DeepSeek saw core/. So: any workdir under either
    # worktree root is re-checked against the tree, and the chain of THIS role
    # against the profile the operator asserted, before every single launch.
    #
    # Be exact about what that catches: fenced PATHS that came back, whether
    # attempt 1 re-materialised them (sparse-checkout, `git checkout <ref> --`)
    # or simply wrote them. It does NOT catch content COPIED to a path the
    # fence does not name — `git show HEAD:core/lib.rs > backend/notes.txt` is
    # invisible here, and always will be: that is the exfiltration class, and
    # the answer to it is a separate repository, not a check (ARCHITECTURE.md
    # § 5, caveat 1).
    #
    # The config comes FIRST, above the reconcile, and the order is the point:
    # `fence_reconcile` calls `fence_apply`, whose `git sparse-checkout set` is
    # a WORKING-TREE UPDATE. That runs the smudge side of every `filter.<d>`
    # a `.gitattributes` in the worktree selects — so a `filter.<d>.smudge`
    # planted by attempt 1 (or by anything else in that tree) executed as the
    # operator while loom was still deciding whether to refuse. The same
    # argument as the reconcile, one line earlier: the git config is in the
    # shared .git and in the worktree's own config.worktree, both writable from
    # the tree attempt 1 just ran in, and a `git config filter.x.clean
    # '!sh -c …'` planted there is a program running in your session before
    # attempt 2 (or the operator's next command). Re-read per attempt, not once
    # per command, and NOT gated on in_task_worktree: the config is the
    # REPOSITORY's, whatever directory this role runs in.
    if [ -n "$CONFIG_TASK" ]; then
      require_recorded_config "$CONFIG_TASK" "$CONFIG_CMD"
    else
      # A role with no task — `loom plan`'s architect, `loom scout`. It has no
      # task record to be compared against, and it used to be compared against
      # nothing at all. The REPOSITORY's baseline answers for it, per attempt,
      # for the same reason the task pin is re-read per attempt: attempt 1 can
      # plant a config and hit a rate limit.
      require_recorded_config_repo "${CONFIG_CMD:-run a model}"
    fi
    if in_task_worktree "$wd"; then
      fence_reconcile "$wd" "$FENCE_PROFILE"
      profile_provider_guard "$role"
    fi
    tried="yes"
    echo "loom: [$role] running on $m (tier $TIER)"
    if run_headless "$role" "$m" "$wd" "$prompt" "$log"; then
      return 0
    elif looks_rate_limited "$log"; then
      echo "loom: [$role] $m looks rate-limited — falling back" >&2
    else
      echo "loom: [$role] $m failed (not a rate limit) — see output above" >&2
      return 1
    fi
  done
  [ -n "$tried" ] && die "every model in the $role chain is rate-limited — try later or widen LOOM_SKIP"
  die "no usable model for role '$role' at tier '$TIER' (skip='$SKIP')"
}

# ---------------------------------------------------------------------- zones
# hand > assist > auto, first match wins. Parsing is real TOML via python3:
# tomllib on 3.11+, the `tomli` backport below that. One reader, several modes,
# so the import dance lives in exactly one place.
zones_py() { # zones_py <mode> [arg]
  #   parse | zone <path> | fenced <path> | fence-paths
  #   fence-orphans | fence-shape | fence-present <worktree>
  #   fence-present-full <worktree>   (both answer from the index AND the disk)
  #   history-fence <path>... | history-hand <path>...
  #   profiles | profile-release | profile-providers | profile-released <path>
  #   profile-tracked <worktree>
  # The fence modes answer with the EFFECTIVE fence: [fence] minus the
  # release list of $LOOM_FENCE_PROFILE, when one is set. `fence-present-full`
  # is the exception, and the one the reconciler uses: the FULL fence, always.
  # `history-*` take a list of paths (a branch's diff) instead of a worktree.
  python3 - "$AGENTS_DIR/zones.toml" "$@" << 'PY'
import sys, os, re, fnmatch, subprocess

def die(msg):                        # exit 2 = "cannot answer", never "no"
    sys.stderr.write("loom: %s\n" % msg)
    raise SystemExit(2)

try:
    import tomllib
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        die("python >=3.11 or 'pip install tomli' required for zones")

zf, mode, args = sys.argv[1], sys.argv[2], sys.argv[3:]
data = {}
if os.path.exists(zf):
    try:
        with open(zf, "rb") as f:
            data = tomllib.load(f)
    except Exception as e:
        die("cannot read %s: %s" % (zf, e))
def globs(section):
    v = data.get(section, {}).get("paths", [])
    if not isinstance(v, list):
        die("%s: [%s].paths must be a list of glob strings" % (zf, section))
    return v

# Validate every pattern before answering anything: a bad entry hiding behind
# an earlier match would otherwise surface as a wrong answer, not an error.
for _sec in ("hand", "assist", "auto", "fence"):
    for _g in globs(_sec):
        if not isinstance(_g, str):
            die("bad pattern in %s: [%s].paths contains %r, which is not a string"
                % (zf, _sec, _g))

fence = globs("fence")

def hit(p, g):
    if fnmatch.fnmatch(p, g): return True
    if g.endswith("/**"):
        base = g[:-3]
        return p == base or fnmatch.fnmatch(p, base + "/*")
    return False

def probes(g):
    """Sample paths a fence pattern stands for. Used to compare one pattern
    against another (a release against the patterns that stay fenced), where
    there is no file list to compare through."""
    if g.endswith("/**"):
        base = g[:-3]
        return [base, base + "/__loom_probe__"]
    return [g]

# ---------------------------------------------------------- fence profiles
# [fence_profiles.<name>] release = [...]  providers = [...]
#
# A task that opts into <name> gets a worktree fenced by [fence] MINUS
# `release`, and `loom` refuses to run any role there whose model chain reaches
# a provider outside `providers`. Parsing is fail-closed like everything else
# here, with one extra rule: every released pattern must appear VERBATIM in
# [fence].paths. A release that matched nothing would look like it worked and
# quietly leave the path fenced (or, worse, read as a release of something
# else under the two glob dialects).
# The providers this harness can ever name. Kept deliberately small and
# honest — it is exactly what provider_of() can return:
#   * its two special cases, `claude` (claude-sub) and `codex` (codex-sub),
#     the subscription CLIs;
#   * the opencode providers `loom` carries a key for (key_for_provider):
#     zai, zai-coding-plan, moonshotai, deepseek — the prefixes of every model
#     ID in the built-in chains;
#   * plus every provider this repo declares under `provider` in
#     .opencode/opencode.json, which is how a project adds one.
# Anything else in a `providers` list can never match a running model, so it is
# a typo with the shape of a policy. Keep in sync with provider_of() and
# key_for_provider() in bin/loom.
known_providers = {"claude", "codex", "zai", "zai-coding-plan",
                   "moonshotai", "deepseek"}
_ocjson = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(zf))),
                       ".opencode", "opencode.json")
if os.path.exists(_ocjson):
    try:
        import json
        with open(_ocjson) as _f:
            _oc = json.load(_f)
        if isinstance(_oc, dict) and isinstance(_oc.get("provider"), dict):
            known_providers |= set(str(k) for k in _oc["provider"])
    except Exception:
        pass          # a broken opencode.json is `loom doctor`'s business

profiles = data.get("fence_profiles", {})
if not isinstance(profiles, dict):
    die("%s: [fence_profiles] must be a table of profiles" % zf)
for _name, _p in profiles.items():
    if not re.match(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$", _name):
        die("%s: bad fence profile name %r — letters, digits, '_', '.', '-' only" % (zf, _name))
    if not isinstance(_p, dict):
        die("%s: [fence_profiles.%s] must be a table" % (zf, _name))
    _unknown = sorted(set(_p) - {"release", "providers", "reason"})
    if _unknown:
        die("%s: [fence_profiles.%s] has unknown key(s) %s — expected release, providers, reason"
            % (zf, _name, ", ".join(_unknown)))
    for _key in ("release", "providers"):
        _v = _p.get(_key)
        if not isinstance(_v, list) or not _v or any(not isinstance(x, str) for x in _v):
            die("%s: [fence_profiles.%s].%s must be a non-empty list of strings"
                % (zf, _name, _key))
    # A provider name is compared against provider_of() output and is expanded
    # unquoted in more than one shell loop upstream. Whitespace or a glob
    # character here is not a typo, it is an escalation: providers = ["*"]
    # would match anything a `for p in $allowed` loop globbed out of $ROOT.
    for _x in _p["providers"]:
        if not re.match(r"^[A-Za-z0-9][A-Za-z0-9_.@-]*$", _x):
            die("%s: [fence_profiles.%s].providers contains %r — a provider name is "
                "letters, digits, '_', '.', '@' and '-' only: no spaces, no glob "
                "characters, not empty. Use provider_of() names, one per entry: %s"
                % (zf, _name, _x, ", ".join(sorted(known_providers))))
        # The character set is not enough. "Claude" and "claude-sub" both pass
        # it and neither can ever equal a provider_of() value, so a profile
        # written that way allows NOTHING while reading as though it allowed
        # something — the failure mode is a confused operator, not a refusal.
        if _x not in known_providers:
            _hint = ""
            if _x.endswith("-sub"):
                _hint = (" '%s' is a MODEL token; provider_of('%s') is '%s'."
                         % (_x, _x, _x[:-4]))
            elif _x.lower() in known_providers:
                _hint = " Provider names are lower case: did you mean '%s'?" % _x.lower()
            die("%s: [fence_profiles.%s].providers contains %r, which is not a provider "
                "this harness can ever produce.%s A provider is what provider_of() "
                "returns: %s — plus anything declared under `provider` in "
                ".opencode/opencode.json."
                % (zf, _name, _x, _hint, ", ".join(sorted(known_providers))))
    for _g in _p["release"]:
        if _g not in fence:
            die("%s: [fence_profiles.%s].release lists '%s', which is not one of "
                "[fence].paths — a profile may only release what the fence holds"
                % (zf, _name, _g))
    # A released pattern that another, still-fenced pattern also covers is a
    # trap in both directions: the path never arrives in the worktree (the
    # effective fence still hides it), while `loom guard` starts accepting
    # commits to it. Reject the configuration rather than half-release.
    _stay = [g for g in fence if g not in _p["release"]]
    for _g in _p["release"]:
        for _probe in probes(_g):
            for _h in _stay:
                if hit(_probe, _h):
                    die("%s: [fence_profiles.%s].release lists '%s', but [fence] pattern "
                        "'%s' still covers it — the release could not take effect, while "
                        "the commit guard would start accepting it. Release '%s' as well, "
                        "or narrow the fence." % (zf, _name, _g, _h, _h))
    # ... and the same trap the other way round, which the loop above cannot
    # see: fence = ["core/**", "core/wallet-sdk/**"], release = ["core/**"].
    # Nothing that stays fenced covers the RELEASED pattern, so the check above
    # is happy — but "core/wallet-sdk/**" stays in the effective fence, so those
    # files never arrive in the worktree, while `is_released` answers yes for
    # them and the commit guard starts accepting commits to a subsystem that is
    # not there. Probe every STAYING pattern against every released one.
    for _h in _stay:
        for _probe in probes(_h):
            for _g in _p["release"]:
                if hit(_probe, _g):
                    die("%s: [fence_profiles.%s].release lists '%s', which also covers "
                        "[fence] pattern '%s' — and that one stays fenced, so its paths "
                        "never reach the worktree while the commit guard would start "
                        "accepting commits to them. Release '%s' as well, or narrow the "
                        "release." % (zf, _name, _g, _h, _h))

prof = os.environ.get("LOOM_FENCE_PROFILE", "").strip()
if prof and prof not in profiles:
    die("unknown fence profile '%s' — %s defines: %s"
        % (prof, zf, ", ".join(sorted(profiles)) or "(none)"))
released = profiles[prof]["release"] if prof else []
eff = [g for g in fence if g not in released]   # the fence this run applies

def fence_sanity():
    """Fencing the contract layer would disable the very things that police
    the agent: no zones.toml in the worktree means every path resolves to
    "assist" and `loom guard` exits 0; no gate.sh means the gate exits 127
    and burns every attempt; no .agents/reviews/ means the gate log the
    dispatcher writes there sits outside the sparse-checkout definition, so
    `git add -A` fails after a green gate and nothing is committed; and
    .opencode/ carries the provider identity a fence profile's `providers`
    list is built on (`provider.<name>.options.baseURL`) together with every
    role prompt, all of which the harness has to be able to read. Refuse
    instead of silently disarming. A directory is checked by probing a file
    inside it, so `dir/*` patterns count too."""
    essentials = (
        (".agents/zones.toml", ".agents/zones.toml", "which disables the zone guard"),
        (".agents/gate.sh",    ".agents/gate.sh",    "which disables the gate"),
        (".agents/reviews/",   ".agents/reviews/0000-x-gate.log",
         "which the dispatcher writes the gate log, patch and review into"),
        (".opencode/",         ".opencode/prompts/implementer.md",
         "which carries every role prompt and the provider identity a fence "
         "profile is built on"),
    )
    for shown, probe, why in essentials:
        for g in fence:
            if hit(probe, g):
                die("fence pattern '%s' would remove %s from agent worktrees, "
                    "%s — narrow the pattern" % (g, shown, why))

def zone_of(path):
    for zone in ("hand", "assist", "auto"):
        for g in globs(zone):
            if hit(path, g):
                return zone
    return "assist"

def tracked_in(wt=None):
    cmd = ["git"] + (["-C", wt] if wt else []) + ["ls-files"]
    r = subprocess.run(cmd, stdout=subprocess.PIPE, universal_newlines=True)
    if r.returncode != 0:
        die("git ls-files failed in %s" % (wt or os.getcwd()))
    return r.stdout.splitlines()

def static_prefix(g):
    """The leading directory part of a pattern that contains no glob
    metacharacter — the place on disk a walk for it has to start.
    'core/**' -> 'core', 'crates/*/tests/**' -> 'crates', '*.key' -> ''.

    A pattern whose FIRST segment globs ('*.key', '*/secrets/**') therefore
    returns '', and present_on_disk then walks the whole worktree for it. That
    is correct and it is not free: it is the cost of a fence pattern that does
    not start with a literal directory. `loom doctor`'s fence-shape warning
    already flags every pattern that is not the plain 'subsystem/**' form."""
    out = []
    for seg in g.split("/"):
        if any(c in seg for c in "*?["):
            break
        out.append(seg)
    return "/".join(out)

def present_on_disk(wt, patterns):
    """Every path under <wt> that one of `patterns` covers and that is ACTUALLY
    ON DISK — tracked or not. `git ls-files` answers the index, and the index
    is not the tree: `git show HEAD:core/lib.rs > core/copy.rs` puts fenced
    content back into a fenced directory without touching the index at all,
    and a reconcile that only reads the index never sees it.

    Not covered, and never will be: content copied to a path the fence does
    NOT name (core/lib.rs -> backend/notes.txt). That is the exfiltration
    class — ARCHITECTURE.md § 5, caveat 1 — and the answer to it is a separate
    repository, not a check.

    A directory that a pattern covers WHOLE (the pattern also matches a probe
    path beneath it) is reported as itself and not descended into: hit() is
    prefix-shaped for those patterns, so every file under it would carry the
    same verdict from profile_releases, and a 60k-file build directory under a
    fenced path must not cost a walk on every model launch. The config
    validator has already refused a release that swallows a pattern which
    stays fenced, so 'same verdict' holds for the profile lookup too."""
    found = set()
    starts = set()
    for g in patterns:
        pre = static_prefix(g)
        starts.add(pre)
    for pre in sorted(starts):
        root = os.path.join(wt, pre) if pre else wt
        rel0 = pre
        if os.path.islink(root) or not os.path.exists(root):
            # A symlink standing where a fenced path should be is itself a
            # thing that is present.
            if os.path.islink(root) and any(hit(rel0, g) for g in patterns):
                found.add(rel0)
            continue
        if not os.path.isdir(root):
            if any(hit(rel0, g) for g in patterns):
                found.add(rel0)
            continue
        for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
            rel = os.path.relpath(dirpath, wt)
            rel = "" if rel == "." else rel.replace(os.sep, "/")
            keep = []
            for d in dirnames:
                sub = ("%s/%s" % (rel, d)) if rel else d
                if sub == ".git" or sub.endswith("/.git"):
                    continue
                whole = [g for g in patterns
                         if hit(sub, g) and hit(sub + "/__loom_probe__", g)]
                if whole:
                    found.add(sub)          # stands for everything beneath it
                    continue
                keep.append(d)
            dirnames[:] = keep
            for f in filenames:
                sub = ("%s/%s" % (rel, f)) if rel else f
                if any(hit(sub, g) for g in patterns):
                    found.add(sub)
    return found

if mode == "parse":                                    # exit 0 = readable TOML
    pass
elif mode == "zone":
    print(zone_of(args[0]))
elif mode == "fenced":         # 0 = fenced, 3 = not fenced, 2 = cannot tell.
    fence_sanity()
    raise SystemExit(0 if any(hit(args[0], g) for g in eff) else 3)
elif mode == "fence-paths":
    fence_sanity()
    for g in eff:
        print(g)
elif mode == "fence-orphans":                          # typo detection for doctor
    fence_sanity()
    tracked = tracked_in()
    for g in fence:
        if not any(hit(p, g) for p in tracked):
            print(g)
elif mode == "fence-shape":    # patterns where gitignore and fnmatch may differ
    fence_sanity()
    plain = re.compile(r"^[^*?\[\]!/][^*?\[\]!]*/\*\*$")
    for g in fence:
        if not plain.match(g):
            print(g)
elif mode in ("fence-present", "fence-present-full"):
    # Fenced paths still on disk in <worktree>: the EFFECTIVE fence for
    # `fence-present` (what `fence_verify` proves), the FULL [fence] for
    # `fence-present-full`, whatever profile is active. The full-fence form is
    # what `fence_reconcile` reconciles against: "which fenced paths are on
    # disk here" must not be answered by the very profile whose right to be
    # active is what we are deciding. (The answer can only ever REFUSE a
    # command — a tree is writable by whatever runs in it, so it vouches for
    # nothing. The operator's flag is the consent.)
    #
    # Two sources, unioned: the index (tracked files that survived the sparse
    # checkout) and the filesystem under each pattern's static prefix
    # (anything the index does not know about — see present_on_disk).
    fence_sanity()
    wt = args[0]
    pats = eff if mode == "fence-present" else fence
    out = set()
    for p in tracked_in(wt):
        if any(hit(p, g) for g in pats) and os.path.exists(os.path.join(wt, p)):
            out.add(p)
    out |= present_on_disk(wt, pats)
    for p in sorted(out):
        print(p)
elif mode in ("history-fence", "history-hand"):
    # The paths a BRANCH's commits touch, judged without looking at the tree.
    # A worktree can be re-fenced after the fact — `git sparse-checkout set`
    # costs one command — but the commits stay, and every `git diff`, patch
    # file and merge carries their content onward. Both answers are computed
    # against the FULL [fence] / the real [hand], minus what the ASSERTED
    # profile releases; with no profile asserted nothing is released.
    fence_sanity()
    _seen = set()
    for p in args:
        if p in _seen:
            continue
        _seen.add(p)
        if any(hit(p, g) for g in released):
            continue
        if mode == "history-fence":
            if any(hit(p, g) for g in fence):
                print(p)
        elif zone_of(p) == "hand":
            print(p)
elif mode == "profiles":       # doctor listing: name \t providers \t release
    for name in sorted(profiles):
        pr = profiles[name]
        print("%s\t%s\t%s" % (name, ",".join(pr["providers"]), ",".join(pr["release"])))
elif mode in ("profile-release", "profile-providers", "profile-released",
              "profile-tracked"):
    if not prof:
        die("internal error: mode '%s' needs LOOM_FENCE_PROFILE" % mode)
    pr = profiles[prof]
    if mode == "profile-release":
        for g in pr["release"]:
            print(g)
    elif mode == "profile-providers":
        for x in pr["providers"]:
            print(x)
    elif mode == "profile-tracked":
        # Tracked files this profile's release covers, in <worktree>. "None of
        # these is on disk" is how `loom` tells a worktree that was BUILT under
        # the profile from one a profile is being introduced into after the fact.
        for p in tracked_in(args[0] if args else None):
            if any(hit(p, g) for g in pr["release"]):
                print(p)
    else:                      # 0 = released by this profile, 3 = still fenced
        raise SystemExit(0 if any(hit(args[0], g) for g in pr["release"]) else 3)
else:
    die("internal error: unknown zones mode '%s'" % mode)
PY
}

zone_of() { # zone_of <repo-relative-path>   (fails loudly: callers gate commits)
  zones_py zone "$1"
}

# zones_py with NO profile active, whatever this command asserted. The subshell
# is the point: `LOOM_FENCE_PROFILE` is exported, and a caller must not have its
# own answer changed by asking this question. Used where a release list has no
# standing — `loom rebase`'s judgement of what arrives from upstream, which nobody
# released anything for.
zones_py_full() { ( unset LOOM_FENCE_PROFILE; zones_py "$@" ); }

# ------------------------------------------------------------ fence profiles
# A fence profile is a NAMED, per-provider relaxation of the read fence: the
# worktree of a task that opts into it is fenced by [fence] MINUS the profile's
# `release` list, and no role may run there on a provider the profile does not
# name.
#
# Two rules keep it honest, and they are the whole design:
#
#   1. The opt-in is a FRESH OPERATOR ACT on every command. `--fence-profile
#      <name>` must be passed to `loom new`, `run`, `check`, `loop`, `diff`,
#      `rebase` and `land` alike — `diff` included, because it writes the same
#      review patch `check` does. The operator record (the state file outside every repo)
#      keeps the name `loom new` was given, but ONLY as a consistency record: it
#      may refuse a command, never authorise one. A `Fence-profile:` line in
#      the task file is documentation of intent; the flag is the consent.
#   2. Enforcement is a CONSISTENCY CHECK against what is on disk and in the
#      branch's commits — never a second signature. See fence_reconcile and
#      fence_reconcile_history below: a tree (or a history) holding released
#      paths that nobody vouched for on this command line is a dead stop.
#      Neither can ever authorise a command: a worktree is a directory the
#      agent can write, and `git sparse-checkout disable` materialises the
#      released paths in one command. They refuse; the flag consents.
#
# The active profile is NEVER taken from the environment either: an inherited
# LOOM_FENCE_PROFILE would widen the fence for whoever exported it. `loom` sets it
# itself, from the operator's flag, and clears anything it inherited here. Both
# spellings are cleared: AW_FENCE_PROFILE is what this variable was called
# before the dispatcher was renamed, and a shell that still exports it is
# exactly the shell this rule exists for.
unset LOOM_FENCE_PROFILE AW_FENCE_PROFILE
FENCE_PROFILE=""      # active profile name; "" = the full fence, today's behaviour
FENCE_RELEASED=""     # its release patterns, space separated (for prompts/messages)

# Fence lookups fail CLOSED. If zones.toml cannot be read we do not know what is
# fenced, and "nothing is fenced" would hand a fenced tree to a third-party
# model. Parsed once per `loom` invocation and cached, so subshells inherit it.
FENCE_PATTERNS=""
FENCE_LOADED=""
load_fence() {
  [ -n "$FENCE_LOADED" ] && return 0
  FENCE_PATTERNS="$(zones_py fence-paths)" \
    || die "cannot determine the fence from .agents/zones.toml — refusing to guess"
  FENCE_LOADED=yes
}

has_fence() { load_fence; [ -n "$FENCE_PATTERNS" ]; }

# Turn a profile on for the rest of this `loom` invocation. Dies on an unknown or
# malformed profile — zones_py validates it — so every caller is fail-closed.
fence_profile_activate() { # fence_profile_activate <name>
  local name="$1"
  [ -n "$name" ] || return 0
  export LOOM_FENCE_PROFILE="$name"
  FENCE_RELEASED="$(zones_py profile-release | tr '\n' ' ')" \
    || die "fence profile '$name' is not usable — fix .agents/zones.toml"
  FENCE_RELEASED="${FENCE_RELEASED% }"
  FENCE_PROFILE="$name"
  FENCE_PATTERNS=""; FENCE_LOADED=""    # the effective fence just changed
  load_fence
}

# 0 = <profile> releases this path, 1 = it does not. Side-effect free: the
# lookup runs in a subshell, so it can be asked about a profile that is NOT the
# active one (the reconciler asks exactly that).
profile_releases() { # profile_releases <profile> <path>
  local rc=0
  [ -n "$1" ] || return 1
  ( export LOOM_FENCE_PROFILE="$1"; zones_py profile-released "$2" >/dev/null ) || rc=$?
  case "$rc" in
    0) return 0 ;;
    3) return 1 ;;
    *) die "cannot determine whether '$2' is released by profile '$1' — refusing to guess" ;;
  esac
}

# 0 = the active profile releases this path, 1 = it does not (or none is active).
is_released() { # is_released <path>
  [ -n "$FENCE_PROFILE" ] || return 1
  profile_releases "$FENCE_PROFILE" "$1"
}

# NOTE on what the tree is worth as evidence. `loom` checks the worktree against
# the asserted profile everywhere, and that check is a CONSISTENCY CHECK, not a
# second signature: an agent inside the worktree can `git sparse-checkout
# disable`, or simply write the files, so a tree that "looks like" a profile
# proves nothing about who asked for it. It can therefore refuse a command and
# never authorise one — exactly like the operator record. The operator's
# --fence-profile flag is the only consent in this system.

# Every model that could run against a profiled worktree must belong to a
# provider the profile names — the WHOLE chain, not just the first entry: a
# fallback fires on a rate limit without asking anyone.
#
# `set -f` around the loops on purpose: $allowed and a model chain are data,
# and an unquoted expansion of either would glob against $ROOT. zones_py also
# rejects a provider entry containing a glob character, so this is the second
# of two locks on the same door.
profile_provider_guard() { # profile_provider_guard <role>...
  [ -n "$FENCE_PROFILE" ] || return 0
  local allowed_raw allowed role m p a ok hint=""
  local -a allow=() chain=()
  allowed_raw="$(zones_py profile-providers)" \
    || die "cannot read the providers of fence profile '$FENCE_PROFILE'"
  while IFS= read -r a; do [ -n "$a" ] && allow+=("$a"); done <<< "$allowed_raw"
  allowed="${allow[*]}"
  for a in "${allow[@]}"; do
    case "$a" in claude) hint="$hint claude-sub" ;; codex) hint="$hint codex-sub" ;; esac
  done
  [ -n "$hint" ] || hint=" <a model from: $allowed>"
  for role in "$@"; do
    chain=()
    set -f
    # shellcheck disable=SC2086  # a chain is a space-separated list; globbing is off
    for m in $(models_for "$role"); do chain+=("$m"); done
    set +f
    for m in "${chain[@]}"; do
      p="$(provider_of "$m")"; ok=""
      for a in "${allow[@]}"; do [ "$a" = "$p" ] && ok=yes; done
      [ -n "$ok" ] && continue
      die "fence profile '$FENCE_PROFILE' releases fenced paths into this worktree,
but the $role chain would run '$m' (provider '$p'). The profile allows only: $allowed
Restrict the chain for this task, e.g.:
  LOOM_MODELS_$role=\"${hint# }\" loom ..."
    done
  done
}

is_fenced() { # is_fenced <path>   0 = fenced, 3 = not; anything else is an error
  local rc=0
  zones_py fenced "$1" >/dev/null || rc=$?      # stderr stays visible on purpose
  case "$rc" in
    0) return 0 ;;
    3) return 1 ;;
    *) die "cannot determine whether '$1' is fenced — refusing to guess" ;;
  esac
}

# One sentence appended to agent prompts when a fence is configured.
fence_note() {
  has_fence || return 0
  printf '%s' " Some paths are fenced off in .agents/zones.toml and are absent \
from this worktree by policy; work around them and do not try to recover them \
via git plumbing."
}

# Remove the fenced paths from a worktree with a non-cone sparse checkout:
# '/*' takes the whole tree, each '!<glob>' subtracts one fenced set.
# `sparse-checkout set --no-cone` only exists on git >= 2.36 (older git takes
# the flag as a literal pattern), so set the mode with `init --no-cone`
# (>= 2.25, worktree-scoped config) and let `set` inherit it.
fence_apply() { # fence_apply <worktree>
  local wt="$1" g
  local -a pats=()
  load_fence
  while IFS= read -r g; do [ -n "$g" ] && pats+=("!$g"); done <<< "$FENCE_PATTERNS"
  if [ "${#pats[@]}" -eq 0 ]; then
    # Nothing left to fence. With a profile active that can mean it released
    # every pattern, and a worktree built before the profile may still carry
    # sparse rules — drop them, or the released paths would stay missing.
    if [ -n "$FENCE_PROFILE" ]; then git -C "$wt" sparse-checkout disable >&2; fi
    return 0
  fi
  git -C "$wt" sparse-checkout init --no-cone >&2 \
    || die "cannot enable sparse checkout in $wt (git >= 2.25 required for [fence])"
  git -C "$wt" sparse-checkout set '/*' "${pats[@]}" >&2 \
    || die "sparse-checkout could not apply the fence patterns in $wt"
}

# Applying the patterns is not proof they took: git refuses to remove a file
# with local modifications and only warns, and a sparse checkout never touches
# an UNTRACKED file at all. Check the tree — the real one, on disk — not the
# config and not the index.
fence_verify() { # fence_verify <worktree>
  local wt="$1" left
  left="$(zones_py fence-present "$wt")" || die "cannot verify the fence in $wt"
  [ -z "$left" ] && return 0
  die "fenced paths are STILL present in $wt:
$(printf '%s\n' "$left" | sed 's/^/  /')
git will not drop a tracked file with local changes, and a sparse checkout
never removes an untracked one. Commit or discard the changes in the worktree,
delete the untracked files, or start clean with: loom drop <task-id>"
}

# (Re-)apply the fence to a worktree that may predate it, then prove it took.
# No-op when no fence is configured. Called on every `loom run` and `loom scout`,
# because a worktree created before a fence was added or widened would
# otherwise hand the fenced paths straight to the implementer.
fence_enforce() { # fence_enforce <worktree>
  # Runs with a profile active even when the effective fence is empty: the
  # worktree may still be carrying the sparse rules of the full fence.
  has_fence || [ -n "$FENCE_PROFILE" ] || return 0
  fence_apply "$1"
  fence_verify "$1"
}

# ---------------------------------------------------------------- reconcile
# THE gate between a worktree and a model. Driven by what is ON DISK — never by
# a recorded profile, and not by the index either: `git show HEAD:core/lib.rs >
# core/copy.rs` leaves the index untouched, so "present" is answered from the
# filesystem as well as from `git ls-files` (zones_py's present_on_disk).
#
#   present  = fenced paths (the FULL [fence]) actually in the worktree
#   asserted = the profile the OPERATOR named on this command line ("" = none)
#
# Five rules, and there is no sixth:
#   1. present, and a profile is asserted that releases every one of them:
#      re-apply that profile's effective fence, verify, run. (The caller has
#      already checked the chain of the role about to run.)
#   2. present, and the asserted profile does NOT release one of them: die.
#      Silently re-fencing here would be worse than useless — the tree's own
#      diff and patch file still carry the content into the next model.
#   3. a profile is asserted but NONE of what it releases is on disk: die.
#      That tree was not built under the profile, and a profile may not be
#      introduced after `loom new` — that is how a forged branch record would
#      otherwise cash out.
#   4. present, nothing asserted: DIE. Unconditionally.
#      This rule used to have an arm: if the record named a profile that would
#      have released exactly these paths, `loom` re-fenced to the full fence,
#      printed three warnings and ran. Back then the record was branch config,
#      so that arm let a `git config` in the worktree turn a refusal into a
#      warning. The record has moved out of the repo since, and the arm is
#      still gone: a record only ever refuses, whoever can write it. An
#      unprofiled tree holding fenced paths is a dead stop; `loom drop` is the
#      fix.
#   5. nothing present, nothing asserted: the ordinary path — apply and verify
#      the full fence, as `loom run` has always done. (Not a rule about a
#      release; it is the ordinary case, and it is numbered so that the count
#      above matches the list.)
fence_reconcile() { # fence_reconcile <worktree> <asserted-profile-or-empty>
  local wt="$1" asserted="${2:-}" present p stray=""
  [ -d "$wt" ] || return 0
  present="$(zones_py fence-present-full "$wt")" \
    || die "cannot tell which fenced paths are present in $wt — refusing to guess"

  if [ -n "$asserted" ]; then
    [ "$FENCE_PROFILE" = "$asserted" ] || fence_profile_activate "$asserted"
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      profile_releases "$asserted" "$p" || stray="$stray
  $p"
    done <<< "$present"
    if [ -n "$stray" ]; then
      die "fence profile '$asserted' does not release paths that are present in $wt:$stray
This worktree was built under a different fence. Start clean:
  loom drop <task-id> && loom new <task-id> --fence-profile $asserted"
    fi
    # Nothing released is on disk. If the profile releases nothing tracked there
    # is nothing to introduce and nothing to check; otherwise this tree predates
    # the profile and must not gain it now.
    #
    # The exit status is captured, not inferred from the output: `[ -n "$(…)" ]`
    # reads a zones_py that DIED as "this profile releases nothing tracked" and
    # walks straight past the refusal. Fail-closed by construction.
    local tracked=""
    tracked="$(zones_py profile-tracked "$wt")" \
      || die "cannot tell which of fence profile '$asserted's released paths are tracked in $wt — refusing to guess"
    if [ -z "$present" ] && [ -n "$tracked" ]; then
      die "worktree $wt holds none of the paths fence profile '$asserted' releases.
It was not created under that profile, and a profile cannot be introduced after
'loom new'. Start clean:
  loom drop <task-id> && loom new <task-id> --fence-profile $asserted"
    fi
    fence_apply "$wt"
    fence_verify "$wt"
    return 0
  fi

  # Nothing asserted, and the tree holds fenced paths. Every top-level command
  # has already refused this (require_fence_flag dies when a record exists and
  # the flag does not), so reaching here means either a fence that was widened
  # under an existing worktree — which dies, `loom drop` is the fix — or a caller
  # that skipped require_fence_flag, which is what run_role's second call is
  # here to catch. Either way it is a dead stop: the record is not consulted,
  # because a record that could turn this refusal into a warning would be a
  # record that authorises.
  if [ -n "$present" ]; then
    die "fenced paths are present in $wt and no fence profile is \
asserted for this command:
$(printf '%s\n' "$present" | sed 's/^/  /')
Refusing to run a model here. Either name the profile these paths belong to
(--fence-profile <name>, which must also be the profile the worktree was
created under), or start clean:  loom drop <task-id>"
  fi
  fence_enforce "$wt"
}

# ------------------------------------------------- reconcile, over HISTORY
# fence_reconcile answers "what is in this worktree NOW". That is not the whole
# question, because a worktree can be re-fenced after the fact: an agent (or an
# `loom` run) can materialise core/**, commit it, and put the sparse rules back,
# and the tree then looks clean while every `git diff`, every
# .agents/reviews/<task>.patch and every merge still carries the content. So
# the branch's COMMITS are judged too, wherever history is handed to a role or
# to the operator: loom check (before the patch is written), loom loop (each
# round), loom diff, loom land (before merge and before push) and loom rebase.
#
# BOTH ENDS of that range come from outside the worktree, and neither is the
# worktree's HEAD:
#   * the base is the OPERATOR RECORD (security_base), a file outside the repo;
#   * the endpoint is refs/heads/agent/<task>, read in $ROOT — the same ref
#     `loom land` merges and `loom land --pr` pushes. The worktree's HEAD is not
#     that: `git checkout --detach HEAD~1` inside the worktree leaves the
#     fenced commit on the branch while every check measured from HEAD sees a
#     clean history. (A worktree in that state is refused outright as well —
#     require_wt_on_branch — because it is not a state `loom` produces.)
#
# Every way of not knowing is a DEATH, never an empty answer. An unresolvable
# base used to `return 0` with no paths, which reads downstream as "this
# branch's commits touch nothing fenced" — fail-open, on exactly the input an
# agent controls.
HIST_PATHS=()
history_paths() { # history_paths <dir> <base> <rev>  -> fills $HIST_PATHS
  local d="$1" base="$2" rev="${3:-HEAD}" p
  HIST_PATHS=()
  [ -n "$base" ] || die "internal error: history_paths called with no base"
  git -C "$d" rev-parse --verify --quiet "$base^{commit}" >/dev/null 2>&1 \
    || die "the base commit '$base' does not resolve in $d, so loom cannot tell what this
branch's commits touch. Refusing to guess — a base that does not resolve is not
an empty diff."
  git -C "$d" rev-parse --verify --quiet "$rev^{commit}"  >/dev/null 2>&1 \
    || die "'$rev' does not resolve in $d — refusing to guess what it touches"
  # -z: a path with a space or a quote in it must not turn into two paths.
  # --no-renames: a rename must be judged on BOTH sides, and with rename
  # detection off git reports it as a delete plus an add, which is exactly
  # that. The --diff-filter=A pass adds nothing new after --no-renames; it is
  # there so the answer does not depend on that equivalence holding.
  # A NUL-delimited stream cannot survive a command substitution, and the exit
  # status of a process substitution cannot be read — so it goes through a
  # file, and a git that fails is a refusal rather than an empty path list.
  local out; out="$(mktemp "${TMPDIR:-/tmp}/loom-hist.XXXXXX")"
  if ! { git -C "$d" diff --no-ext-diff --no-textconv -z --no-renames --name-only "$base" "$rev" \
      && git -C "$d" diff --no-ext-diff --no-textconv -z --no-renames --name-only --diff-filter=A "$base" "$rev"
       } > "$out" 2>/dev/null; then
    rm -f "$out"
    die "git diff $base..$rev failed in $d — refusing to guess what those commits touch"
  fi
  while IFS= read -r -d '' p; do
    [ -n "$p" ] && HIST_PATHS+=("$p")
  done < "$out"
  rm -f "$out"
  return 0
}

# Fenced paths in the branch's commits that the asserted profile does not
# release. With nothing asserted, "released" is empty: any fenced path in the
# history is a violation.
#
# The endpoint is $PINNED_TIP — the sha this command resolved the branch ref to,
# once, before any of this — not the ref name and not the worktree's HEAD.
fence_reconcile_history() { # fence_reconcile_history <task> <base> <asserted>
  local task="$1" base="$2" asserted="${3:-}" bad
  if [ -n "$asserted" ] && [ "$FENCE_PROFILE" != "$asserted" ]; then
    fence_profile_activate "$asserted"
  fi
  require_pinned_tip
  history_paths "$ROOT" "$base" "$PINNED_TIP"
  [ "${#HIST_PATHS[@]}" -gt 0 ] || return 0
  bad="$(zones_py history-fence "${HIST_PATHS[@]}")" \
    || die "cannot tell which paths this branch's commits touch — refusing to guess"
  [ -n "$bad" ] || return 0
  die "this branch's commits touch fenced paths:
$(printf '%s\n' "$bad" | sed 's/^/  /')
The worktree may no longer show them, but the history does, and the diff, the
review patch and any merge carry their content onward.
If this task was created under a fence profile that releases these paths, name
it: --fence-profile <name>. Otherwise the branch is tainted — throw it away:
  loom drop <task-id>"
}

# [hand] paths in the branch's commits that the asserted profile does not
# release. The pre-commit guard is supposed to stop these, but it runs in the
# agent's own context where `git commit --no-verify` exists, so `loom land`
# checks the commits it is about to publish rather than trusting that it did.
hand_reconcile_history() { # hand_reconcile_history <dir> <base> <rev>
  local d="$1" base="$2" rev="$3" bad note=""
  history_paths "$d" "$base" "$rev"
  [ "${#HIST_PATHS[@]}" -gt 0 ] || return 0
  bad="$(zones_py history-hand "${HIST_PATHS[@]}")" \
    || die "cannot tell which zones this branch's commits touch — refusing to guess"
  [ -n "$bad" ] || return 0
  [ -n "$FENCE_PROFILE" ] && note="Fence profile '$FENCE_PROFILE' releases only: $FENCE_RELEASED
"
  die "this branch's commits touch hand-zone paths:
$(printf '%s\n' "$bad" | sed 's/^/  /')
${note}These are yours to write. The pre-commit guard is a seatbelt and 'git commit
--no-verify' skips it, so landing is where this is caught. Re-do the change by
hand, or reclassify the zone deliberately in .agents/zones.toml."
}

# One sentence for the implementer prompt when a profile is in force, so the
# agent knows the normally-fenced paths in front of it are deliberate.
profile_note() {
  [ -n "$FENCE_PROFILE" ] || return 0
  printf '%s' " This task runs under fence profile '$FENCE_PROFILE': the \
normally-fenced paths $FENCE_RELEASED are present in this worktree on purpose \
and are in scope for this task."
}

cmd_zone() {
  local p="${1:?usage: loom zone <path>}" z
  p="$(relpath "$p")"
  z="$(zone_of "$p")" || die "zone lookup failed for $p"
  if is_fenced "$p"; then
    echo "$p → $z (fenced — removed from agent worktrees)"
  else
    echo "$p → $z"
  fi
}

cmd_guard() { # pre-commit: reject agent/* commits touching hand-zone paths
  # The SUBJECT is the tree the commit is happening in ($INVOKED_ROOT: the
  # agent's worktree when the hook fires there, your checkout when it fires
  # here). The POLICY it is judged by is the main checkout's — $AGENTS_DIR and
  # every zones_py call already read from $ROOT, which is the main checkout
  # whichever tree this was invoked from. Reading the worktree's own zones.toml
  # would have let an agent widen its own zone with the file it is committing.
  local branch; branch="$(git -C "$INVOKED_ROOT" rev-parse --abbrev-ref HEAD)"
  case "$branch" in agent/*) ;; *) return 0 ;; esac
  # A fenced path is also a hand path by convention (that is what blocks a
  # commit to it), so a branch running under a fence profile must be allowed to
  # commit the paths its profile released — and nothing else in [hand].
  #
  # This runs as a pre-commit hook, INSIDE the agent's own worktree, in the
  # agent's own context. It is a seatbelt, not a lock: `--no-verify` skips it
  # outright. It reads the OPERATOR RECORD for the released set — the state
  # file outside the repo, found through the MAIN checkout's path (a linked
  # worktree resolves to the same state key), which the hook can reach because
  # it runs as the same OS user. It still checks that record against the tree
  # first. Be plain about what that check is worth: it is a CONSISTENCY CHECK,
  # and an agent that wants to satisfy it can — making the tree agree costs one
  # `git sparse-checkout disable`, and an unsandboxed agent can write $HOME
  # (KNOWN-GAPS 3). It catches a stale worktree and an honest mistake. What
  # actually decides whether released content ever reaches a provider is the
  # operator's --fence-profile flag on `loom new`, checked again on every later
  # command, and `loom land`'s check of the commits themselves.
  local prof present p tracked
  require_sane_record "${branch#agent/}"
  prof="$(state_read "${branch#agent/}" profile 2>/dev/null || true)"
  if [ -n "$prof" ]; then
    fence_profile_activate "$prof"     # dies on an unknown or unreadable profile
    present="$(zones_py fence-present-full "$INVOKED_ROOT")" || {
      echo "pre-commit: cannot tell which fenced paths are present here — refusing to guess" >&2
      exit 1; }
    while IFS= read -r p; do
      [ -n "$p" ] || continue
      is_released "$p" && continue
      echo "pre-commit: BLOCKED — this task records fence profile '$prof', but the" >&2
      echo "tree here holds fenced path '$p', which that profile does not release." >&2
      echo "The record does not match the tree; refusing to widen the guard on it." >&2
      echo "(If this is your own checkout with an agent branch checked out, it holds" >&2
      echo "every fenced path by design — commit from the agent worktree instead.)" >&2
      exit 1
    done <<< "$present"
    tracked="$(zones_py profile-tracked "$INVOKED_ROOT")" || {
      echo "pre-commit: cannot tell which released paths this tree tracks — refusing to guess" >&2
      exit 1; }
    if [ -z "$present" ] && [ -n "$tracked" ]; then
      echo "pre-commit: BLOCKED — this task records fence profile '$prof', but none of" >&2
      echo "the paths that profile releases are in this worktree. The record was not" >&2
      echo "written by the 'loom new' that built this tree; refusing to honour it." >&2
      exit 1
    fi
  fi
  local violations="" file z
  while IFS= read -r file; do
    [ -n "$file" ] || continue
    z="$(zone_of "$file")" || { echo "pre-commit: zone lookup failed — refusing to guess" >&2; exit 1; }
    if [ "$z" = hand ] && ! is_released "$file"; then
      violations="$violations
  $file"
    fi
  done < <(git -C "$INVOKED_ROOT" diff --no-ext-diff --no-textconv --cached --name-only)
  if [ -n "$violations" ]; then
    echo "BLOCKED: agent branch '$branch' touches hand-zone paths:$violations" >&2
    echo "" >&2
    if [ -n "$FENCE_PROFILE" ]; then
      echo "Fence profile '$FENCE_PROFILE' releases only: $FENCE_RELEASED" >&2
      echo "" >&2
    fi
    echo "These are yours to write. Reassign the task, or reclassify the zone" >&2
    echo "deliberately in .agents/zones.toml." >&2
    exit 1
  fi
}

# The pre-commit hook git actually runs: honours core.hooksPath and, from
# inside a linked worktree, resolves to the shared common dir. May be
# relative — fine, loom cd's to $ROOT at startup and never leaves it.
hook_path() { git rev-parse --git-path hooks/pre-commit; }

# ----------------------------------------------------------------- worktrees
# git cannot track an empty directory, so .agents/reviews/ is absent from a
# fresh worktree unless the repo happens to keep a .gitkeep in it. Every write
# into it (gate log, patch, review) would then fail on the redirect — which
# `loom run` reads as a red gate and burns all its attempts on. Create it.
#
# It is also where `loom check` and `loom diff` put the review patch, which is why
# wt_dirty excludes it and why a consuming repo should gitignore it.
reviews_dir() { mkdir -p "$1/.agents/reviews"; }

# Profiled tasks live under $WT_ROOT_PROFILED, unprofiled ones under $WT_ROOT,
# and the two roots are siblings (see the definition at the top of the file).
# Which root a command means follows the profile the OPERATOR asserted on that
# command line — never a record.
wt_path() { # wt_path <task>
  local task="$1"
  if [ -n "${FLAG_PROFILE}${FENCE_PROFILE}" ]; then echo "$WT_ROOT_PROFILED/$task"; return 0; fi
  # No flag on this command line. Prefer an existing PROFILED worktree so that
  # a command given without the flag still finds the task and dies with the
  # actual reason (require_fence_flag's rule 1), not "no worktree for <task>".
  if [ ! -d "$WT_ROOT/$task" ] && [ -d "$WT_ROOT_PROFILED/$task" ]; then
    echo "$WT_ROOT_PROFILED/$task"; return 0
  fi
  echo "$WT_ROOT/$task"
}

# The root this command did NOT choose. A worktree sitting there means the task
# exists under the other kind of fence, which is never something to reconcile.
wt_path_other() { # wt_path_other <task>
  local task="$1" wt; wt="$(wt_path "$task")"
  case "$wt" in
    "$WT_ROOT_PROFILED"/*) echo "$WT_ROOT/$task" ;;
    *)                     echo "$WT_ROOT_PROFILED/$task" ;;
  esac
}

refuse_cross_root() { # refuse_cross_root <task>
  local task="$1" other; other="$(wt_path_other "$task")"
  [ -d "$other" ] || return 0
  die "task $task already has a worktree at $other, built under a different fence
setting than this command asserts. A profile cannot be introduced after 'loom new',
and it cannot be dropped from a task either. Start clean:
  loom drop $task && loom new $task${FLAG_PROFILE:+ --fence-profile $FLAG_PROFILE}"
}

# The worktree for a task that must already have one, checked out on that
# task's own branch. Prints its path.
require_worktree() { # require_worktree <task>
  local task="$1" wt
  wt="$(wt_path "$task")"
  [ -d "$wt" ] || { refuse_cross_root "$task"; die "no worktree for $task"; }
  require_wt_on_branch "$task" "$wt"
  echo "$wt"
}

branch_of()  { echo "agent/$1"; }
branch_ref() { echo "refs/heads/agent/$1"; }

# Uncommitted work in a task worktree, EXCEPT the dispatcher's own review
# scratch: `loom check` and `loom diff` write .agents/reviews/<task>.patch and
# -review.md into the worktree themselves, so counting those would make `loom`
# refuse to land after its own review step. Consumers should gitignore
# .agents/reviews/ (README); this exclusion is what keeps the check honest in
# the repos that have not.
#
# Everything else counts, untracked files included. A tree with uncommitted
# changes is a tree whose diff is not the branch's diff: what the reviewer read
# and what a merge would carry have come apart, and the gate about to run is
# measuring files nobody reviewed.
wt_dirty() { # wt_dirty <worktree>   -> the offending `git status --porcelain` lines
  git -C "$1" status --porcelain -- . ':(exclude).agents/reviews' 2>/dev/null \
    || die "cannot read the state of the worktree $1 — refusing to guess whether it is clean"
}

# --- ONE base, and it is the operator's ------------------------------------
# There used to be two: a "security base" derived from refs, and a "review
# base" read from `branch.agent/<task>.loombase`. Both are gone, and for the
# same reason — a linked worktree shares `.git`, so branch config AND refs are
# writable from inside the agent's tree:
#
#   * one `git config branch.<br>.loombase <tip>` made `git diff <base> HEAD`
#     empty, and every history check answered "this branch touches nothing";
#   * one `git update-ref refs/remotes/origin/main <tip>` (or refs/heads/main)
#     did exactly the same to a base computed as merge-base(<trunk>, <branch>),
#     which is why merge-base is no longer a security input either. That form
#     also FALSE-REFUSED an honest task: an operator with unpushed commits on
#     main had them counted as the branch's own.
#
# So the base is the OPERATOR RECORD: the commit `$ROOT` was checked out at
# when `loom new` created the task, written by `loom new`, re-pointed by `loom rebase`
# (an operator command), and read from a file outside every repo. It is the
# base of BOTH the security checks and the review patch — there is nothing left
# to clamp, because there is no second, cheaper base to clamp against.
# --- ONE endpoint too, and it is a SHA ------------------------------------
# `refs/heads/agent/<task>` is the right endpoint, and it is also a moving
# target: the ref lives in the shared `.git`, so anything running in the
# worktree — the implementer, a hook, `.agents/gate.sh` — can `git update-ref`
# it between the check and the merge. A command that named the branch four
# times resolved it four times, and only the first three were the reviewed one.
#
# So every command resolves it EXACTLY ONCE, into $PINNED_TIP, and then uses
# that sha for all of it: the history checks, the review patch, the merge and
# the push. Whatever a worktree does to the ref afterwards, the command is
# already talking about a commit.
# See require_fence_flag: the task whose pinned git config every model launch in
# this command is judged against, and the command name the refusal names.
CONFIG_TASK=""
CONFIG_CMD=""

PINNED_TIP=""
pin_branch_tip() { # pin_branch_tip <task>   -> sets $PINNED_TIP for this command
  local task="$1" ref; ref="$(branch_ref "$task")"
  PINNED_TIP="$(git rev-parse --verify --quiet "$ref^{commit}" 2>/dev/null)" \
    || die "branch '$(branch_of "$task")' does not resolve in $ROOT — refusing to guess what it touches"
  [ -n "$PINNED_TIP" ] \
    || die "branch '$(branch_of "$task")' does not resolve in $ROOT — refusing to guess what it touches"
}

require_pinned_tip() {
  [ -n "$PINNED_TIP" ] || die "internal error: the branch tip was not pinned for this command"
}

# The operator record's existence, said in security_base's words. `loom run` needs
# the refusal without the rest of security_base, because a task that has just
# been created legitimately has nothing past its branch point.
require_record() { # require_record <task>
  [ -n "$(state_read "$1" base)" ] || die "no operator record for task $1 — created before this version, or
removed. There is no base to judge this branch's commits against, and loom will
not derive one from anything a worktree can write. Start clean:
  loom drop $1 && loom new $1"
}

security_base() { # security_base <task>  -> the recorded base commit, or dies
  local task="$1" base br
  br="$(branch_of "$task")"
  require_pinned_tip                     # the endpoint, resolved once, upstream
  require_record "$task"
  base="$(state_read "$task" base)"
  base="$(git rev-parse --verify --quiet "$base^{commit}" 2>/dev/null)" \
    || die "the base recorded for task $task does not resolve in $ROOT.
That commit is what every fence and hand history check is measured from, so
without it loom cannot tell what this branch's commits touch — and will not guess.
If the history was rewritten under it:  loom drop $task && loom new $task"
  git merge-base --is-ancestor "$base" "$PINNED_TIP" 2>/dev/null \
    || die "the base recorded for task $task ($(git rev-parse --short "$base")) is not an
ancestor of $br. This branch is not the one that record was written for — it was
rebased or reset outside 'loom rebase', or the record belongs to another task.
Inspect it, do not land it:  git log --oneline $(git rev-parse --short "$base")..$br"
  # Equal, or behind: there is nothing between the branch point and the branch.
  # An empty review is not something to hand a reviewer, and an empty history
  # check is not evidence of anything.
  ! git merge-base --is-ancestor "$PINNED_TIP" "$base" 2>/dev/null \
    || die "nothing to review/land — the branch has no commits past its branch point
($(git rev-parse --short "$base")). Run the implementer first:  loom run $task"
  printf '%s\n' "$base"
}

# A worktree `loom` produced is checked out on its own branch. A detached or
# switched one is not, and it is not a state to reconcile: what a command reads
# from that tree and what the branch's commits say have come apart, which is
# the whole trick behind `git checkout --detach HEAD~1` after a fenced commit.
require_wt_on_branch() { # require_wt_on_branch <task> <worktree>
  local task="$1" wt="$2" br head
  # FIRST, and before the branch question, because the branch question is
  # answered BY the git directory this worktree points at. A `$wt/.git`
  # rewritten to a decoy built with the same branch name answers
  # `refs/heads/agent/<task>` perfectly happily (measured), so this check used
  # to pass a directory aimed at another repository entirely — and every
  # command downstream then read that repository's filters, hooks and refs.
  # Being on the branch is only a fact once the worktree is ours.
  require_wt_is_ours "$wt"
  br="$(branch_of "$task")"
  head="$(git -C "$wt" symbolic-ref -q HEAD 2>/dev/null || true)"
  [ "$head" = "refs/heads/$br" ] || die "the worktree $wt is not on refs/heads/$br
(HEAD there is '${head:-detached}'). loom never leaves a worktree like that, and it
will not judge one: the tree and the branch's commits no longer describe the
same work. Put it back:
  git -C $wt checkout $br
or start clean:  loom drop $task"
}

# --- where a task's fence profile comes from -------------------------------
# From the operator, on the command line, every single time. `--fence-profile
# <name>` is required by `loom new`, `run`, `check`, `loop`, `diff`, `rebase` and
# `land` alike (`diff` writes the same review patch `check` does). The `profile` field of the operator record is written at `loom new` and
# is a CONSISTENCY RECORD, not an authorisation: it can refuse a command (the
# flag is missing, or names a different profile) but it can never supply one.
# `branch.agent/<task>.fenceprofile` is neither read nor written any more — it
# lived in the shared .git/config, where anything running in the worktree could
# write it, so it was a claim with the shape of a record.
#
# A `Fence-profile: <name>` line in the task file is the third form, and the
# weakest: it documents the intent of a task, and `loom new` honours it only when
# the same name is also passed on the command line. The file is written by
# whoever wrote the task — an architect agent included.
# The task file's HEADER BLOCK: the metadata paragraph under the title, where
# `Zone:` lives. Scanning the whole file would let a `Fence-profile:` line
# inside a code fence read as a declaration — and `loom loop` appends reviewer
# output, verbatim, to this very file.
#
# The title is skipped wherever it is, not only on line 1: a file that opens
# with a blank line used to have its `# title` treated as the whole header
# block, and the blank line after it ended the block before `Fence-profile:`
# was ever reached — a declaration silently ignored.
task_header() { # task_header <task>   -> the header block on stdout
  local f="$AGENTS_DIR/tasks/$1.md"
  [ -f "$f" ] || return 0
  awk '
      /^[[:space:]]*(```|~~~)/       { exit }
      /^##/                          { exit }
      /^[[:space:]]*$/               { if (started) exit; next }
      !started && !title && /^#/     { title = 1; next }
      { started = 1; print }
    ' "$f"
}

task_profile() { # task_profile <task>  -> declared profile, or "" (never fails)
  local line
  line="$(task_header "$1" | grep -m1 -i '^[[:space:]]*Fence-profile:' || true)"
  [ -n "$line" ] || return 0
  # `Fence-profile: codex   # confirm on the command line` is a comment, not
  # part of the name (the README's own example is written that way). A profile
  # name cannot contain '#', so cutting at the first whitespace-then-'#' is
  # exact rather than lenient.
  printf '%s' "${line#*:}" | sed 's/[[:space:]]#.*$//' | tr -d '[:space:]'
}

# Header-block lines that were MEANT to be a `Fence-profile:` declaration and
# are not one: `Fence-profile :`, `Fence profile:`, `Fence_profile:`. Silence
# here reads as "the declaration was honoured", which is the one thing it must
# never read as, so `loom new` says so out loud.
task_profile_nearmiss() { # task_profile_nearmiss <task>
  task_header "$1" \
    | grep -i -E '^[[:space:]]*fence[-_ ]?profile[[:space:]]*:' \
    | grep -v -i -E '^[[:space:]]*fence-profile:' || true
}

# --- the operator's flags ---------------------------------------------------
# Pulled out of any command's argv, so every command spells them the same way
# and an empty value is refused in one place. Two flags, both of them consent
# the operator gives on THIS command line and nothing infers for them:
# --fence-profile <name> and --accept-config.
FLAG_PROFILE=""        # what the OPERATOR asserted on this command line
FLAG_ACCEPT_CONFIG=""  # ... and whether they re-pinned the local git config
FLAG_ARGS=()           # argv with both removed
scan_fence_flag() { # scan_fence_flag "$@"
  FLAG_PROFILE=""; FLAG_ACCEPT_CONFIG=""; FLAG_ARGS=()
  local seen=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --accept-config)
        FLAG_ACCEPT_CONFIG=yes; shift ;;
      --fence-profile|--fence-profile=*)
        [ -z "$seen" ] || die "--fence-profile given twice"
        if [ "$1" = --fence-profile ]; then
          shift; [ $# -gt 0 ] || die "--fence-profile needs a profile name"
          FLAG_PROFILE="$1"
        else
          FLAG_PROFILE="${1#*=}"
        fi
        [ -n "$FLAG_PROFILE" ] || die "--fence-profile needs a profile name (got an empty value)"
        seen=yes; shift ;;
      *) FLAG_ARGS+=("$1"); shift ;;
    esac
  done
}

# The three fail-closed rules, applied by every command that runs a role or
# touches a task worktree. Activates the profile when the operator asserted one
# and the record agrees.
require_fence_flag() { # require_fence_flag <task> <command-name>
  local task="$1" cmd="$2" rec="" flag="$FLAG_PROFILE" br
  br="$(branch_of "$task")"
  # Which task's pinned git config `run_role` checks before each launch, and
  # what to call the command in the refusal. Every command that runs a role in
  # a task worktree comes through here first; the task-less roles (`loom plan`'s
  # architect, `loom scout`) leave it empty and are not checked, because they
  # have no record to check against.
  CONFIG_TASK="$task"; CONFIG_CMD="$cmd"
  # The record is read half a dozen times below and downstream, almost always
  # from inside `$(…)` — where a die exits the subshell and hands the caller ""
  # instead. Judge its shape once, here, as a plain statement, so that a forged
  # or malformed record refuses the COMMAND rather than reading as "no record".
  require_sane_record "$task"
  if git show-ref --verify --quiet "refs/heads/$br"; then
    rec="$(state_read "$task" profile)"
    if [ -n "$rec" ] && [ -z "$flag" ]; then
      die "this task was created under fence profile '$rec'; pass --fence-profile $rec:
  loom $cmd $task --fence-profile $rec"
    fi
    if [ -n "$rec" ] && [ "$rec" != "$flag" ]; then
      die "--fence-profile '$flag' contradicts the record for $task ('$rec').
Use '$rec', or start clean:  loom drop $task && loom new $task --fence-profile $flag"
    fi
    if [ -z "$rec" ] && [ -n "$flag" ]; then
      # Rule 3, absolute. There used to be an escape here: if the worktree
      # already held exactly what '$flag' releases, `loom` called that
      # corroboration, restored the record and ran. It is not corroboration.
      # A worktree is a directory an agent can write: `git sparse-checkout
      # disable` materialises the released paths, and so does `git checkout
      # <ref> -- core/`. The tree can only ever refuse; it can never vouch.
      # So: no record, no run. Re-creating the task is the fix, and it is an
      # OPERATOR act with the same weight as the flag — `loom` does not infer a
      # profile from a directory listing, and it does not write a record for
      # a task it did not create.
      die "task $task has no fence-profile record: the operator record for it names no
profile, or there is no record at all.
A profile cannot be introduced after 'loom new', and a worktree that happens to
hold the released paths is not evidence — anything running there can create
them. Start clean:
  loom drop $task && loom new $task --fence-profile $flag"
    fi
  fi
  # No branch yet: nothing to contradict. `loom new` (which run/loop call) applies
  # its own rules to the flag and to the task file's declaration.
  [ -n "$flag" ] && fence_profile_activate "$flag"
  refuse_cross_root "$task"
  return 0
}

# A worktree that exists without its operator record is a worktree nobody can
# reason about later — released paths on disk with no record of why, and no
# base to measure its commits from. `loom new` therefore records while the tree
# is still empty, and unwinds the whole thing if anything fails or the operator
# interrupts it.
#
# What this trap deletes, it says out loud, and it deletes a BRANCH only when
# that branch exists NOW and `loom new` observed it absent before it started.
# Both halves matter:
#   * `git worktree add -b` creates the branch and THEN fails on the path (a
#     symlink or a file at $wt is enough), so a run that never reached the
#     "branch created" line could still leave an orphan behind — which then
#     made the task id permanently unusable;
#   * setting $NEW_BR unconditionally before the add is what once deleted a
#     PRE-EXISTING branch (the state `loom drop --keep-branch` leaves on
#     purpose) when the add failed because that branch was already there.
# `loom new` refuses an existing branch up front, so anything this trap sees is
# a branch this command made.
NEW_WT=""; NEW_BR=""; NEW_STATE=""
new_abort() {
  [ -n "$NEW_WT$NEW_BR$NEW_STATE" ] || return 0
  [ -n "$NEW_WT" ] && {
    echo "loom: aborting — removing the half-built worktree $NEW_WT" >&2
    git worktree remove --force "$NEW_WT" >/dev/null 2>&1 || true
    git worktree prune >/dev/null 2>&1 || true
  }
  if [ -n "$NEW_BR" ] && git show-ref --verify --quiet "refs/heads/$NEW_BR"; then
    echo "loom: aborting — deleting the branch this command created: $NEW_BR" >&2
    git branch -D "$NEW_BR" >&2 || true
  fi
  if [ -n "$NEW_STATE" ]; then
    echo "loom: aborting — removing the operator record this command wrote: $NEW_STATE" >&2
    state_rm "$NEW_STATE" || true
  fi
  NEW_WT=""; NEW_BR=""; NEW_STATE=""
}

cmd_new() {
  local task="" prof="" decl a
  scan_fence_flag "$@"
  prof="$FLAG_PROFILE"
  for a in ${FLAG_ARGS[0]+"${FLAG_ARGS[@]}"}; do
    case "$a" in
      -*) die "loom new: unknown flag '$a' — usage: loom new <task-id> [--fence-profile <name>]" ;;
      *)  if [ -z "$task" ]; then task="$a"; else die "loom new: unexpected argument '$a'"; fi ;;
    esac
  done
  [ -n "$task" ] || die "usage: loom new <task-id> [--fence-profile <name>]"
  # `loom new` RECORDS the config; there is nothing yet to accept. Silently
  # swallowing the flag here would read as "the config was re-pinned", which is
  # the one thing it must not read as.
  [ -z "$FLAG_ACCEPT_CONFIG" ] || die "loom new: --accept-config re-records a config that has already been pinned, and
this command is the one that pins it. Drop the flag."
  local wt br
  # wt_path follows $FLAG_PROFILE, so this is the profiled root when a profile
  # was asserted and the unprofiled one otherwise. Set it before either check.
  FLAG_PROFILE="$prof"
  wt="$(wt_path "$task")"; br="$(branch_of "$task")"
  [ -d "$wt" ] && die "worktree already exists: $wt"
  refuse_cross_root "$task"
  # An existing branch is a refusal, never something to walk over. `loom drop
  # <task> --keep-branch` leaves exactly this state on purpose, and the old
  # code set $NEW_BR before the add, so the EXIT trap deleted that branch —
  # and its commits — when the add failed. Checked before anything is created
  # or any trap is armed.
  local br_existed=""
  if git show-ref --verify --quiet "refs/heads/$br"; then br_existed=yes; fi
  [ -z "$br_existed" ] || die "branch $br already exists — loom drop $task first.
(If you used 'loom drop $task --keep-branch', that branch is holding work: land it
or delete it deliberately with 'git branch -D $br' before reusing the task id.)"
  [ -f "$AGENTS_DIR/tasks/$task.md" ] || die "no task file: .agents/tasks/$task.md"
  # A key that was meant to be `Fence-profile:` and is not one is worse than no
  # key at all: it looks like a declaration and does nothing. Say so.
  local nm
  while IFS= read -r nm; do
    [ -n "$nm" ] || continue
    echo "loom: WARN: .agents/tasks/$task.md header contains '$(printf '%s' "$nm" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')'" >&2
    echo "loom: WARN: — that is NOT a fence-profile declaration and was not honoured." >&2
    echo "loom: WARN: The key is spelled exactly 'Fence-profile:' (no space before the colon)." >&2
  done <<< "$(task_profile_nearmiss "$task")"
  # The task file's declaration is intent, the flag is consent. A declaration
  # alone never opts a task in: the file is written by whoever wrote the task.
  decl="$(task_profile "$task")"
  if [ -n "$decl" ] && [ -z "$prof" ]; then
    die "loom new: .agents/tasks/$task.md declares 'Fence-profile: $decl', which releases
fenced paths into this worktree. Confirm it on the command line:
  loom new $task --fence-profile $decl"
  fi
  if [ -n "$prof" ] && [ -n "$decl" ] && [ "$prof" != "$decl" ]; then
    die "loom new: --fence-profile '$prof' contradicts 'Fence-profile: $decl' in .agents/tasks/$task.md — fix one"
  fi
  if [ -n "$prof" ]; then
    fence_profile_activate "$prof"                 # dies on an unknown profile
    # Checked BEFORE the worktree exists: a released path must never land on
    # disk for a chain that is not allowed to see it, not even briefly.
    profile_provider_guard implementer reviewer
    echo "loom: fence profile '$prof' — released into this worktree: $FENCE_RELEASED" >&2
  fi
  local wtroot; wtroot="$(root_of_wt "$wt")"
  mkdir -p "$(dirname "$wt")"
  # The root was verified at startup; verify THIS path's parent again, here,
  # immediately before anything is created under it.
  assert_wt_parent "$wt" "$wtroot"
  # The branch point, resolved ONCE and used for both the checkout and the
  # record, so that "the commit this branch was cut from" is the same fact in
  # both places rather than two lookups that could disagree.
  #
  # This one `git rev-parse HEAD` is the one ref read that IS a security input,
  # and it is acceptable for a reason worth writing down: it is $ROOT's HEAD,
  # i.e. `refs/heads/<your branch>` in YOUR checkout. An agent that moved it
  # would move the branch the operator is standing on — visible in their own
  # working tree, in their prompt, in the next `git status`. `origin/main` is
  # the opposite: a moved `refs/remotes/origin/main` shows NOWHERE, which is why
  # `loom rebase` refuses to replay onto it without checking what came with it.
  local newbase; newbase="$(git rev-parse HEAD)" \
    || die "cannot resolve HEAD in $ROOT — there is no branch point to record"
  # The remote as it is right now — the URL AND the refspec — so that a later
  # `loom rebase` / `loom land --pr` can tell that it still is. Both come out of
  # .git/config, which every linked worktree can write, and a config value can
  # carry a newline: refused HERE, before this command creates a worktree, a
  # branch or a record, rather than only when the record is written.
  local neworigin newfetch newpushurl
  neworigin="$(origin_url)"
  newfetch="$(origin_fetch)"
  # Where a push GOES, recorded separately from where a fetch comes from: a
  # `remote.origin.pushurl`, or a `url.<decoy>.pushInsteadOf` rewrite, moves the
  # first without touching the second.
  newpushurl="$(origin_pushurl)"
  require_one_line "'remote.origin.url'" "$neworigin"
  require_one_line "'remote.origin.fetch'" "$newfetch"
  require_one_line "the push URL of 'origin'" "$newpushurl"
  # The whole git config — all three scopes and the include closure — digested.
  # It is written with the rest of the record (while the tree is still empty,
  # so the worktree-task scope is empty here) and re-pinned once more at the end
  # of this command, because `loom`'s OWN worktree setup writes to it in TWO
  # scopes: the first `git sparse-checkout init` in a repository adds
  # `extensions.worktreeConfig` to the shared .git/config, and the same command
  # writes `core.sparseCheckout` into the new worktree's own config.worktree
  # (measured, git 2.34). An interrupt in between leaves the earlier digest,
  # which is a refusal, not a pass.
  local newcfgdump newconfig
  newcfgdump="$(config_snapshot "$(config_wt "$task")")"; cfg_track "$newcfgdump"
  newconfig="$(config_digest_of "$newcfgdump")"
  NEW_WT="$wt"
  # $NEW_BR before the add, on purpose: the add CREATES the branch and can then
  # fail on the path, and the check above observed that this branch did not
  # exist. new_abort deletes it only if it exists when the abort runs.
  NEW_BR="$br"
  # The dumps go with it: new_abort replaces the process-wide `cfg_cleanup`
  # trap for the length of this command, and the half-built task it unwinds is
  # exactly the run that used to leave one behind.
  trap 'new_abort; cfg_cleanup' EXIT
  trap 'new_abort; cfg_cleanup; exit 130' INT TERM
  # --no-checkout first: the operator record is written while the tree is still
  # empty, so an interrupt can never leave released content without a record.
  git worktree add --no-checkout -b "$br" "$wt" "$newbase" >&2
  assert_wt_under "$wt" "$wtroot"
  NEW_STATE="$task"
  state_put "$task" "base=$newbase" "profile=$prof" "branch=$br" \
            "created=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            "origin=$neworigin" "fetch=$newfetch" "pushurl=$newpushurl" \
            "config=$newconfig" "reviewed="
  config_write_sidecar "$task" "$newcfgdump"
  rm -f "$newcfgdump"
  if has_fence; then
    fence_apply "$wt"
    git -C "$wt" checkout >&2
    fence_verify "$wt"
  else
    git -C "$wt" checkout >&2
  fi
  # Re-pin, now that this command's own writes to the config have happened — in
  # BOTH scopes: `extensions.worktreeConfig` in the shared .git/config, and
  # `core.sparseCheckout` in the new worktree's own config.worktree.
  config_repin "$task" || die "cannot pin this repository's git config for task $task"
  # `loom new` is the command that pins, so it is the command that says what it
  # pinned. Every later command only ever compares against this. The counts and
  # the include targets first, then the keys that name a PROGRAM — because
  # those are the ones being ADOPTED, and this is the only moment an operator
  # is shown them.
  config_summary  "$(config_sidecar "$task")"
  config_programs "$(config_sidecar "$task")"
  NEW_WT=""; NEW_BR=""; NEW_STATE=""
  trap 'cfg_cleanup' EXIT       # back to the process-wide sweep, not to none
  trap - INT TERM
  echo "$wt"
}

cmd_run() {
  scan_fence_flag "$@"
  local task="${FLAG_ARGS[0]:?usage: loom run <task-id> [--fence-profile <name>]}"
  local wt br attempt=1 gate_note="" title fnote pnote
  local -a newargs=()
  # require_fence_flag first: it may activate the profile, and which worktree
  # ROOT this task lives under follows the profile (wt_path).
  require_fence_flag "$task" run
  wt="$(wt_path "$task")"; br="$(branch_of "$task")"
  profile_provider_guard implementer      # no-op without a profile
  if [ ! -d "$wt" ]; then
    [ -n "$FLAG_PROFILE" ] && newargs=(--fence-profile "$FLAG_PROFILE")
    wt="$(cmd_new "$task" ${newargs[0]+"${newargs[@]}"})"
  fi
  require_wt_on_branch "$task" "$wt"
  # No record, no run. A worktree without one is a worktree nobody can judge
  # later: no base to measure its commits from, no note of the fence it was
  # created under. It used to run a model and commit anyway, and the refusal
  # only arrived at `loom check`, with the content already on the branch.
  # security_base says this in full but also refuses a branch with nothing past
  # its branch point — which is the ordinary state of a task `loom run` is about
  # to implement — so the record's existence is checked on its own, here.
  require_record "$task"
  # BEFORE the first fence operation, which is the whole of this line's
  # placement: `fence_reconcile` -> `fence_apply` -> `git sparse-checkout set`
  # updates the WORKING TREE, and that runs planted smudge filters. See
  # require_recorded_config.
  # (It is here rather than one line above `require_fence_flag` because the
  # branch above may have just called `cmd_new`, which is the command that PINS:
  # for a task loom created a moment ago there is nothing yet to compare.)
  require_recorded_config "$task" run
  # Re-apply and verify, and refuse outright if what is on disk and what the
  # operator asserted do not line up. The tree cannot authorise anything; it
  # can only contradict the flag, and a contradiction is a dead stop.
  fence_reconcile "$wt" "$FENCE_PROFILE"
  reviews_dir "$wt"          # the implementer writes -done/-blocked there on attempt 1
  title="$(head -1 "$AGENTS_DIR/tasks/$task.md" | sed 's/^#[[:space:]]*//')"
  load_fence; fnote="$(fence_note)"; pnote="$(profile_note)"

  echo "loom: task $task  branch $br  tier $TIER${FENCE_PROFILE:+  fence-profile $FENCE_PROFILE}"
  while [ "$attempt" -le "$MAX_ATTEMPTS" ]; do
    echo "loom: attempt $attempt/$MAX_ATTEMPTS"
    run_role implementer "$wt" "Implement the task in .agents/tasks/$task.md. \
Read the plan it references first. Touch only the files it lists — check \
.agents/zones.toml and never edit hand-zone paths. Run ./.agents/gate.sh and \
fix failures until it exits 0. Write brief notes on what you did to \
.agents/reviews/$task-done.md. If you cannot proceed, write why to \
.agents/reviews/$task-blocked.md and stop.$fnote$pnote$gate_note" || true

    # The OPERATOR's gate script, with the worktree as its cwd. `.agents/gate.sh`
    # inside the worktree is a file the implementer edits (the claude leg even
    # allowlists running it), so the copy that decides "green, commit it" must
    # not be the agent's — a gate that rewrites itself to `exit 0`, or that
    # `git update-ref`s the branch on the way past, is one line of shell. The
    # implementer still runs the worktree's copy for its own iteration; this is
    # the one whose verdict `loom` acts on.
    if ( cd "$wt" && "$STATE_MAIN_ROOT/.agents/gate.sh" > "$wt/.agents/reviews/$task-gate.log" 2>&1 ); then
      echo "loom: gate green"
      # Checked explicitly: from `loom loop` this function runs under `|| rc=$?`,
      # which switches set -e off, and a failed add/commit (sparse-checkout
      # refusal, a hook, nothing to commit) would otherwise print "committed"
      # over an unchanged branch.
      ( cd "$wt" && git add -A && git commit -q -m "agent($task): $title" ) \
        || die "commit failed in $wt (nothing to commit, or git refused) — nothing landed on $br"
      echo "loom: committed on $br — review with: loom check $task && loom diff $task"
      return 0
    fi
    if [ -f "$wt/.agents/reviews/$task-blocked.md" ]; then
      echo "loom: implementer reported blocked — see .agents/reviews/$task-blocked.md"
      return 2
    fi
    gate_note=" PREVIOUS ATTEMPT FAILED THE GATE. Failing output (tail):
$(tail -40 "$wt/.agents/reviews/$task-gate.log" 2>/dev/null)"
    attempt=$((attempt + 1))
  done

  echo "loom: gate never went green after $MAX_ATTEMPTS attempts." >&2
  echo "loom: this usually means the task spec is wrong. Revisit it with the architect." >&2
  return 1
}

cmd_check() {
  scan_fence_flag "$@"
  local task="${FLAG_ARGS[0]:?usage: loom check <task-id> [--fence-profile <name>]}"
  local wt base review log pnote=""
  require_fence_flag "$task" check
  # BEFORE the first fence operation, which is the whole of this line's
  # placement: `fence_reconcile` -> `fence_apply` -> `git sparse-checkout set`
  # updates the WORKING TREE, and that runs planted smudge filters. See
  # require_recorded_config.
  require_recorded_config "$task" check
  wt="$(require_worktree "$task")"
  profile_provider_guard reviewer         # no-op without a profile
  # BEFORE the patch is written: the patch carries the content of every path in
  # the diff, so a tree the operator has not vouched for must stop the command
  # here, not one line later — and so must a HISTORY the operator has not
  # vouched for, which a re-fenced worktree no longer shows.
  fence_reconcile "$wt" "$FENCE_PROFILE"
  pin_branch_tip "$task"
  base="$(security_base "$task")"
  fence_reconcile_history "$task" "$base" "$FENCE_PROFILE"
  # BEFORE the patch, for the same reason the history check is: writing it runs
  # `git diff` in this repository, and a `diff.<d>.textconv` or a
  # `filter.<d>.clean` named by a config planted since `loom new` is a program
  # that runs while it is written. (run_role checks again before the reviewer.)
  require_recorded_config "$task" check
  # One base, one endpoint, and neither is read from the worktree: the patch
  # handed to the reviewer is exactly the range the history check just cleared,
  # cut against the SHA that range was cleared for.
  reviews_dir "$wt"
  git -C "$ROOT" diff --no-ext-diff --no-textconv "$base" "$PINNED_TIP" > "$wt/.agents/reviews/$task.patch" \
    || die "cannot write the review patch for $task"
  review="$wt/.agents/reviews/$task-review.md"
  log="$(mktemp "${TMPDIR:-/tmp}/loom-review.XXXXXX")"
  # Without this the scope check reads a released path as an "unauthorized
  # hand/fence change" and REVISEs a diff the profile explicitly authorised.
  if [ -n "$FENCE_PROFILE" ]; then
    pnote=" This task runs under fence profile '$FENCE_PROFILE': changes under \
$FENCE_RELEASED are authorised for this task and are NOT a hand/fence \
violation — judge them on correctness like any other code. Every OTHER \
hand-zone path is still out of bounds."
  fi
  run_role reviewer "$wt" "Review the diff at .agents/reviews/$task.patch \
against the task spec .agents/tasks/$task.md and the plan it references. \
Print your review to stdout: scope check, correctness concerns, test coverage, \
and end with a final line 'VERDICT: APPROVE' or 'VERDICT: REVISE — <reason>'.$pnote" "$log"
  cp "$log" "$review"
  # What was reviewed, recorded: `loom land` refuses a tip that is not this one,
  # so a commit added after the reviewer read the patch cannot ride the review
  # into the merge.
  state_update "$task" "base=$base" "branch=$(branch_of "$task")" "reviewed=$PINNED_TIP"
  echo "loom: review saved to $(relpath "$review")"
  echo "loom: reviewed tip $(git rev-parse --short "$PINNED_TIP") — loom land refuses anything else"
}

# Bounded implement -> review -> fix -> review. A reviewer that still says
# REVISE after LOOM_LOOP_ROUNDS rounds is a spec problem, not a model problem,
# so the loop escalates to you instead of burning tokens on another round.
# The REVISE text is appended to the task file INSIDE the worktree: the copy
# the implementer reads, and never your tree.
cmd_loop() {
  scan_fence_flag "$@"
  local task="${FLAG_ARGS[0]:?usage: loom loop <task-id> [--fence-profile <name>]}"
  local rounds="${LOOM_LOOP_ROUNDS:-2}"
  local wt review verdict tfile base i=1     # $base is set per round, below
  # `loom loop` calls cmd_new, cmd_run and cmd_check, and each of those re-runs
  # scan_fence_flag on ITS OWN argv — which resets $FLAG_ACCEPT_CONFIG in this
  # shell, because only cmd_run's cmd_new call happens in a subshell. Snapshot
  # the operator's flag here and put it back before this function's own config
  # check, so that a nested command cannot quietly withdraw the consent the
  # operator gave on THIS command line.
  local accept_cfg="$FLAG_ACCEPT_CONFIG"
  local -a passthru=()
  [ -n "$FLAG_PROFILE" ] && passthru=(--fence-profile "$FLAG_PROFILE")
  wt="$(wt_path "$task")"

  # cmd_run is reached through `||` below, which switches set -e off for its
  # whole body. Its preconditions are therefore checked HERE: a cmd_new that
  # dies inside cmd_run's command substitution would otherwise leave $wt empty
  # and run the implementer — and `git add -A && git commit` — in YOUR tree.
  [ -f "$AGENTS_DIR/tasks/$task.md" ] || die "no task file: .agents/tasks/$task.md"
  # Both roles run against this worktree, auto-fix rounds included, so both
  # chains are checked once here — before anything is created or called.
  require_fence_flag "$task" loop
  profile_provider_guard implementer reviewer
  refuse_cross_root "$task"
  [ -d "$wt" ] || cmd_new "$task" ${passthru[0]+"${passthru[@]}"} > /dev/null
  require_wt_on_branch "$task" "$wt"
  # require_record, NOT security_base. security_base also refuses a branch with
  # nothing past its branch point — which is the ordinary state of the fresh
  # task `loom loop` exists to implement, so `loom loop <new-task>` died on
  # "nothing to review/land" before the implementer ever ran. What must hold
  # before a model runs is the RECORD (the same rule `loom run` applies): no
  # base to judge this branch's commits against, no run. The history check
  # stays where there is a history to check — inside the loop, before each
  # review, below.
  require_record "$task"
  # cmd_run and cmd_check are reached through `||` and `$( )` below, where a die
  # of theirs surfaces as "the implementer never reached a green gate". The
  # config pin is checked here as a plain statement so the refusal is the loop's
  # own, with its own message. (Both of them check again, per launch.)
  #
  # And it is ABOVE the reconcile, for the reason every other command gives:
  # `fence_reconcile` -> `fence_apply` -> `git sparse-checkout set` updates the
  # working tree, which runs the smudge side of a planted `filter.<d>` before
  # the pin has had a chance to refuse it. It sits here rather than beside
  # `require_fence_flag` because the line above may have just called `cmd_new`,
  # the command that PINS — for a task loom created a moment ago there is
  # nothing yet to compare.
  FLAG_ACCEPT_CONFIG="$accept_cfg"
  require_recorded_config "$task" loop
  fence_reconcile "$wt" "$FENCE_PROFILE"

  implement() { # one implementer pass, with cmd_run's exit codes named
    local rc=0
    cmd_run "$task" ${passthru[0]+"${passthru[@]}"} || rc=$?
    case "$rc" in
      0) return 0 ;;
      2) die "loom loop: implementer reported blocked — read $(relpath "$wt/.agents/reviews/$task-blocked.md")" ;;
      *) die "loom loop: implementer never reached a green gate for $task — the spec is probably wrong" ;;
    esac
  }

  implement
  review="$wt/.agents/reviews/$task-review.md"
  tfile="$wt/.agents/tasks/$task.md"
  while [ "$i" -le "$rounds" ]; do
    echo "loom: [loop] review round $i/$rounds"
    # Each round: the implementer has just committed, so re-judge the history
    # before it is turned into a patch and handed to the reviewer. The base is
    # re-read rather than reused, so that a task re-pointed by `loom rebase` in
    # between is measured from the base it actually has now.
    pin_branch_tip "$task"
    base="$(security_base "$task")"
    fence_reconcile_history "$task" "$base" "$FENCE_PROFILE"
    cmd_check "$task" ${passthru[0]+"${passthru[@]}"}
    verdict="$(grep '^VERDICT:' "$review" 2>/dev/null | tail -1 || true)"
    # No verdict line at all means a truncated or derailed review, not a
    # rejection — re-implementing on it would act on nothing.
    [ -n "$verdict" ] || die "no VERDICT line in $(relpath "$review") — review truncated — re-run loom check $task"
    case "$verdict" in
      *APPROVE*) echo "loom: [loop] APPROVE after $i round(s) — next: loom diff $task && loom land $task"
                 return 0 ;;
    esac
    if [ "$i" -eq "$rounds" ]; then
      echo "loom: [loop] still REVISE after $rounds round(s) — escalating to the coordinator." >&2
      echo "loom: [loop] read $(relpath "$review"), then fix the task spec by hand." >&2
      return 1
    fi
    [ -f "$tfile" ] || die "no task file in the worktree at $tfile — is .agents/tasks/ gitignored? commit it so agent worktrees see it"
    {
      printf '\n## Auto fix round %s (loom loop — reviewer REVISE)\n\n' "$i"
      printf '%s\n' "The reviewer returned REVISE. Address every point below. Keep all existing"
      printf '%s\n' "rulings from earlier rounds; do not weaken or delete tests to satisfy the"
      printf '%s\n\n' "reviewer."
      cat "$review"
    } >> "$tfile"
    echo "loom: [loop] REVISE — fix round $i appended to $(relpath "$tfile" "$wt") in the worktree"
    implement
    i=$((i + 1))
  done
}

# `loom diff` writes the same patch file `loom check` hands to a reviewer, so it
# takes --fence-profile on the same terms as every other task command: the
# history is judged before the patch is written, not after.
cmd_diff() {
  scan_fence_flag "$@"
  local task="${FLAG_ARGS[0]:?usage: loom diff <task-id> [--fence-profile <name>]}"
  local wt base patch
  require_fence_flag "$task" diff
  # BEFORE the first fence operation, which is the whole of this line's
  # placement: `fence_reconcile` -> `fence_apply` -> `git sparse-checkout set`
  # updates the WORKING TREE, and that runs planted smudge filters. See
  # require_recorded_config.
  require_recorded_config "$task" diff
  wt="$(require_worktree "$task")"
  # Same order as `loom check`, for the same reason: the patch this writes carries
  # the content of every path in it, so the tree AND the history are judged
  # before a byte of it is written.
  fence_reconcile "$wt" "$FENCE_PROFILE"
  pin_branch_tip "$task"
  base="$(security_base "$task")"
  fence_reconcile_history "$task" "$base" "$FENCE_PROFILE"
  require_recorded_config "$task" diff       # same reason as `loom check`
  patch="$wt/.agents/reviews/$task.patch"
  reviews_dir "$wt"
  git -C "$ROOT" diff --no-ext-diff --no-textconv "$base" "$PINNED_TIP" > "$patch" \
    || die "cannot write the diff for $task"
  echo "loom: patch at $(relpath "$patch")" >&2
  # No editor is assumed. LOOM_DIFF_CMD takes the patch path as its last
  # argument (`delta`, `bat`, `less -R`, `code --wait`, `vim -R` — whatever you
  # use). Either way it is the SAME range the history check just cleared:
  # base..$PINNED_TIP, read in $ROOT.
  #
  # WITHOUT it the patch streams, unpaged. That is a deliberate loss: `core.pager`
  # names a program git runs, and it lives in the shared .git/config that every
  # linked worktree can write, so loom pins it to `cat` for every git subprocess
  # it spawns (see $GIT_CONFIG_PARAMETERS at the top of this file). `--no-pager`
  # here says the same thing on the command line rather than leaving it to a
  # variable a future edit might drop. A pager is operator-side now, and
  # LOOM_DIFF_CMD is where it goes: `export LOOM_DIFF_CMD="less -R"`.
  if [ -n "${LOOM_DIFF_CMD:-}" ]; then
    # Word-split on purpose: the value is a command line, not one filename.
    # shellcheck disable=SC2086
    set -- $LOOM_DIFF_CMD
    [ "$#" -gt 0 ] || die "LOOM_DIFF_CMD is blank — the patch is at $patch"
    have "$1" || die "LOOM_DIFF_CMD: '$1' is not on PATH — the patch is at $patch"
    "$@" "$patch"
  else
    git -C "$ROOT" --no-pager diff --no-ext-diff --no-textconv "$base" "$PINNED_TIP"
  fi
}

cmd_land() {
  local task="" force="" mode="${LOOM_LAND:-merge}" a
  local wt br base plan title
  scan_fence_flag "$@"
  for a in ${FLAG_ARGS[0]+"${FLAG_ARGS[@]}"}; do
    case "$a" in
      --force)      force=yes ;;
      --pr)         mode="pr" ;;
      --merge)      mode="merge" ;;
      -*)           die "loom land: unknown flag '$a' — usage: loom land <task-id> [--fence-profile <name>] [--pr|--merge] [--force]" ;;
      *)            if [ -z "$task" ]; then task="$a"; else die "loom land: unexpected argument '$a'"; fi ;;
    esac
  done
  [ -n "$task" ] || die "usage: loom land <task-id> [--fence-profile <name>] [--pr|--merge] [--force]"
  case "$mode" in merge|pr) ;; *) die "LOOM_LAND must be 'merge' or 'pr' (got '$mode')" ;; esac
  require_fence_flag "$task" land
  # The remote first, and only in --pr mode, because a re-aimed URL / refspec /
  # push-url has its own, clearer message and must not surface as "the config
  # changed" — every one of those settings lives in the config the next line
  # pins. (Both are checked again lower down, immediately before the push and
  # the merge; these are the copies that run before anything is touched.)
  if [ "$mode" = pr ]; then
    git remote get-url origin >/dev/null 2>&1 || die "no 'origin' remote — PR-mode landing needs one"
    require_recorded_origin "$task" "push"
  fi
  # BEFORE the first fence operation, which is the whole of this line's
  # placement: `fence_reconcile` -> `fence_apply` -> `git sparse-checkout set`
  # updates the WORKING TREE, and that runs planted smudge filters. See
  # require_recorded_config.
  require_recorded_config "$task" land
  wt="$(require_worktree "$task")"; br="$(branch_of "$task")"
  fence_reconcile "$wt" "$FENCE_PROFILE"
  # Uncommitted work in the worktree is not the branch's work: the reviewer read
  # a patch cut from the commits, and what is landing is the commits. `loom rebase`
  # has always refused a dirty tree; landing is where it matters more.
  local dirty; dirty="$(wt_dirty "$wt")"
  [ -z "$dirty" ] || die "worktree $wt has uncommitted changes:
$(printf '%s\n' "$dirty" | sed 's/^/  /')
Landing publishes the branch's COMMITS, so anything still loose here would be
lost — or, if it is the reason the gate passes, would be landing unreviewed.
Commit it in the worktree, or discard it, then re-run:  loom check $task"
  # Landing is the last gate, and it is the one that PUBLISHES: a merge puts
  # these commits in your tree, --pr puts them on origin. Both legs go through
  # here, and --force does not skip it (it skips the gate, not the boundary).
  # What is on disk is not the question — what the commits carry is.
  pin_branch_tip "$task"
  base="$(security_base "$task")"
  fence_reconcile_history "$task" "$base" "$FENCE_PROFILE"
  hand_reconcile_history "$ROOT" "$base" "$PINNED_TIP"
  # The tip a reviewer actually read. A branch that moved since — an extra
  # commit, an `update-ref` from a gate script, a force-push into the ref — is
  # not the thing that was reviewed, and `--force` does not skip this either.
  local reviewed; reviewed="$(state_read "$task" reviewed)"
  [ -n "$reviewed" ] || die "task $task has never been through 'loom check', so nothing has reviewed the
commits this would publish. Run it first:  loom check $task${FENCE_PROFILE:+ --fence-profile $FENCE_PROFILE}"
  [ "$reviewed" = "$PINNED_TIP" ] || die "the branch moved since it was reviewed:
  reviewed at loom check: $reviewed
  $br is now:      $PINNED_TIP
Landing would publish commits nobody read. Re-run the review, then land:
  loom check $task${FENCE_PROFILE:+ --fence-profile $FENCE_PROFILE}"
  [ -n "$FENCE_PROFILE" ] && echo "loom: fence profile '$FENCE_PROFILE' — this diff may touch $FENCE_RELEASED"
  if [ -z "$force" ]; then
    echo "loom: running gate in worktree before landing"
    # The OPERATOR's gate, with the worktree as its cwd — never $wt/.agents/gate.sh,
    # which is a file the implementer edits (and, under a profile, may even be
    # allowed to commit).
    ( cd "$wt" && "$STATE_MAIN_ROOT/.agents/gate.sh" ) || die "gate is red in $br — fix it or land with: loom land $task --force"
  fi

  if [ "$mode" = pr ]; then
    git remote get-url origin >/dev/null 2>&1 || die "no 'origin' remote — PR-mode landing needs one"
    require_recorded_origin "$task" "push"
    # AFTER the remote check, so that a re-aimed URL/refspec/push-url is still
    # named as the remote setting it is (that is the clearer message), and
    # BEFORE the push, which is the one transport in this system that publishes
    # an agent's commits — and which reads `credential.helper` and
    # `core.askPass`, both of which are programs AND are handed the credential.
    require_recorded_config "$task" land
    # The SHA, pushed INTO the branch's ref name. Pushing the name would publish
    # whatever the ref says at push time, which is not necessarily what the gate
    # ran on and the reviewer read.
    # `--receive-pack` is spelled out, and it is not decoration: git collects
    # `remote.<n>.receivepack` into a list and keeps the FIRST value, so the
    # config file beats the GIT_CONFIG_PARAMETERS floor loom exports ("more
    # than one receivepack given, using the first" — measured). The command
    # line is the one place that wins, and this is the command that runs a
    # program on the far side of a push.
    git push --receive-pack=git-receive-pack origin "$PINNED_TIP:refs/heads/$br" \
      || die "push of $PINNED_TIP to origin/$br failed — nothing was published"
    # loom's own write to .git/config (branch.<br>.remote / .merge). Re-pinned so
    # that a later command for this task does not refuse on a change loom made
    # itself — everything this command checks has already passed, and the push
    # has already happened.
    git branch --set-upstream-to="origin/$br" "$br" >/dev/null 2>&1 || true
    config_repin "$task" || true
    title="$(head -1 "$AGENTS_DIR/tasks/$task.md" 2>/dev/null | sed 's/^#[[:space:]]*//')"
    [ -n "$title" ] || title="$task"
    echo ""
    echo "loom: pushed $br. NOT merged — next steps are yours:"
    echo ""
    echo "    gh pr create --head $br --title \"agent($task): $title\""
    echo ""
    echo "loom: worktree kept at $wt (drop it once the PR exists: loom drop $task --keep-branch)"
    echo "loom: tick the plan checkbox for $task by hand when the PR merges."
    return 0
  fi

  # The last thing before the merge, which runs IN YOUR CHECKOUT: a merge picks
  # up `core.hooksPath` (pre-merge-commit, commit-msg, post-merge),
  # `merge.<d>.driver` on a conflict and `gpg.program` under commit.gpgsign, and
  # every one of those is a program named by the shared .git/config.
  require_recorded_config "$task" land
  # The pinned SHA, not the branch name: between the checks above and this line
  # the ref is one `git update-ref` from saying something else.
  git merge --no-ff "$PINNED_TIP" -m "land($task)"
  git worktree remove "$wt" --force
  # The merge is done and it carried $PINNED_TIP — the reviewed sha. The branch
  # is a NAME, and the ref lives in the shared .git, so it may say something
  # else by now. Delete it only when it still points at what was merged;
  # otherwise leave it standing and say so, because whatever else is on it has
  # never been reviewed and would be gone for good. (`git branch -d` would
  # refuse an unmerged branch, which under `set -e` aborts the command AFTER
  # the merge — no checkbox, no message, and the same branch left behind
  # anyway. The guard is the point; -D is what it guards.)
  local now_tip
  now_tip="$(git rev-parse --verify --quiet "$(branch_ref "$task")^{commit}" 2>/dev/null || true)"
  if [ "$now_tip" = "$PINNED_TIP" ]; then
    git branch -D "$br"
  else
    echo "loom: $br moved after the review — it is NOT deleted." >&2
    echo "loom:   merged (the reviewed tip): $PINNED_TIP" >&2
    echo "loom:   $br is now:                ${now_tip:-(gone)}" >&2
    echo "loom: the merge above is the reviewed work and it is done. Read what else" >&2
    echo "loom: is on the branch before throwing it away:" >&2
    echo "loom:   git log --oneline $PINNED_TIP..$br" >&2
    echo "loom:   git branch -D $br" >&2
  fi
  plan="$(grep -rl -- "$task" "$AGENTS_DIR/plans" 2>/dev/null | head -1 || true)"
  [ -n "$plan" ] && sedi "s/- \[ \] $task/- [x] $task/" "$plan"
  echo "loom: landed $task"
}

cmd_rebase() { # rebase agent/<task> onto origin/main and re-point its base
  # The recorded base is the commit the branch was cut from — typically the
  # operator's HEAD, which may carry the plan/task commit the branch rides on
  # and which must NOT read as an agent change. A plain `git rebase` leaves the
  # record at the OLD commit: every history check and the review patch would
  # then be measured from a commit the branch no longer descends from, which
  # security_base refuses outright ("not an ancestor").
  #
  # So a rebase is the ONE place a recorded base moves, and it is an operator
  # command: it replays the branch and re-points the record at the commit it
  # replayed onto — the replayed base commit matched by patch-id, or the new
  # merge-base. Nothing an agent runs re-points anything.
  #
  # And moving the base is not a neutral act, which is the whole of the
  # `--accept-upstream` machinery below. Everything between the old base and the
  # new one STOPS being the branch's work: it slides under the base, where no
  # fence check, no hand check and no review patch will ever look at it again.
  # `refs/remotes/origin/main` is one `git update-ref` away from naming any
  # commit an agent likes, and unlike `refs/heads/main` (which is the branch the
  # operator is standing on, and moves in front of them) a moved `origin/main`
  # shows NOWHERE. So loom reads what actually came under the base and refuses to
  # bury ANY of it without being told to.
  #
  # "Any" is round 7's correction, and it is the honest rule. The gate used to
  # be "the range touches a fenced or a hand-zone path": a range of merge
  # commits, or one touching only the assist zone, moved the base in silence.
  # But burial is not a fence question — it is a REVIEW question. What goes
  # under the base leaves the review surface entirely, and "it touches nothing
  # I check" is not the same statement as "it is nothing". So a non-empty
  # old_base..new_base needs the operator's word, whatever it contains; the
  # fenced and hand-zone hits are still named first, because they are the ones
  # that ought to stop a reader.
  scan_fence_flag "$@"
  local task="" upstream="" accept="" a
  local wt br old_base old_pid new_base mb c dirty bad_f bad_h
  for a in ${FLAG_ARGS[0]+"${FLAG_ARGS[@]}"}; do
    case "$a" in
      --accept-upstream) accept=yes ;;
      -*) die "loom rebase: unknown flag '$a' — usage: loom rebase <task-id> [<upstream>] [--fence-profile <name>] [--accept-upstream]" ;;
      *)  if   [ -z "$task" ];     then task="$a"
          elif [ -z "$upstream" ]; then upstream="$a"
          else die "loom rebase: unexpected argument '$a'"; fi ;;
    esac
  done
  [ -n "$task" ] || die "usage: loom rebase <task-id> [<upstream>] [--fence-profile <name>] [--accept-upstream]"
  upstream="${upstream:-origin/main}"
  # WHICH upstream a rebase may replay onto. The list is two entries long, and
  # it is that short for one reason: this command MOVES the recorded base, so
  # loom has to be able to REFRESH what it replays onto before it does.
  #
  #   origin/<branch>   fetched below with an explicit refspec naming BOTH ends,
  #                     so the remote's own answer overwrites whatever
  #                     refs/remotes/origin/<branch> said. Requires an 'origin':
  #                     without one that ref is refreshed by nothing at all, and
  #                     is simply a local ref an agent can `git update-ref` to
  #                     any commit it likes.
  #   <a local branch>  a ref in this repository, which a fetch does not touch
  #                     (a fetch updates refs/remotes/*, never refs/heads/*).
  #                     Allowed, because it is YOUR ref and it moves in front of
  #                     you — but loom says out loud that nothing was fetched.
  #
  # Every other remote-tracking ref is refused. `loom rebase T upstream/main`
  # used to be accepted and skip the fetch entirely — only `origin/*` ever got a
  # refspec — replaying the base onto refs/remotes/upstream/main, a ref in the
  # shared .git that loom cannot refresh and nothing else updates either.
  #
  # And the upstream is resolved to a FULLY-QUALIFIED ref here, once, because
  # `origin/main` and `main` are not ref names — they are things git RESOLVES,
  # in an order that puts an agent's forgery first. Measured with git 2.34
  # (gitrevisions "Specifying revisions", the six-step lookup):
  #   refs/<name>  beats  refs/tags/<name>  beats  refs/heads/<name>  beats
  #   refs/remotes/<name>
  # so `refs/heads/origin/main` (a local branch literally named "origin/main"),
  # and `refs/origin/main`, both outrank the refs/remotes/origin/main this
  # command fetched and means — and a TAG named `main` outranks the local
  # BRANCH `main` that the `show-ref --verify refs/heads/main` check above just
  # proved exists. Every one of those is one `git update-ref` from inside a
  # worktree. git prints "warning: refname '<x>' is ambiguous" and carries on.
  #
  # $up_ref is what every git command below is given; $upstream stays the name
  # the operator typed and is what the messages say.
  local up_kind="" fetch_br="" up_ref=""
  case "$upstream" in
    origin/?*)
      git remote get-url origin >/dev/null 2>&1 || die "loom rebase: '$upstream' names the 'origin' remote, and this repository has none.
refs/remotes/origin/${upstream#origin/} is then a purely local ref that nothing
refreshes — one 'git update-ref' inside any worktree from naming any commit —
and a rebase onto it would move task $task's base onto whatever it says. Add the
remote, or name a local branch:  loom rebase $task <branch>"
      up_kind=origin; fetch_br="${upstream#origin/}"
      up_ref="refs/remotes/origin/$fetch_br" ;;
    *)
      if git show-ref --verify --quiet "refs/heads/$upstream"; then
        up_kind=local
        up_ref="refs/heads/$upstream"
      else
        case "$upstream" in
          */*) die "loom rebase: '$upstream' is not an upstream loom can replay a base onto.
A rebase moves this task's recorded base, so loom must be able to refresh what it
replays onto first:
  only origin/<b> or a local branch; loom cannot refresh '${upstream%%/*}'." ;;
          *)   die "loom rebase: '$upstream' is neither 'origin/<branch>' nor a branch in this
repository. A rebase moves this task's recorded base, so loom must be able to
refresh what it replays onto first:
  only origin/<b> or a local branch; loom cannot refresh '$upstream'." ;;
        esac
      fi ;;
  esac
  require_fence_flag "$task" rebase   # a rebase must not silently change the fence
  # The remote first, for the reason `loom land` gives: a re-aimed URL, refspec
  # or push-url is a change to the config the next line pins, and "the remote is
  # not the one this task was created against" is the clearer of the two
  # messages. Both are checked again below, before the fetch and the replay.
  require_recorded_origin "$task" "rebase"
  # BEFORE the first fence operation, which is the whole of this line's
  # placement: `fence_reconcile` -> `fence_apply` -> `git sparse-checkout set`
  # updates the WORKING TREE, and that runs planted smudge filters. See
  # require_recorded_config.
  require_recorded_config "$task" rebase
  wt="$(require_worktree "$task")"; br="$(branch_of "$task")"
  fence_reconcile "$wt" "$FENCE_PROFILE"
  # A rebase rewrites these commits onto a new base and re-points the recorded
  # one, which is exactly when a fenced path buried in the history would stop
  # being visible. Judge it before, not after.
  pin_branch_tip "$task"
  old_base="$(security_base "$task")"
  fence_reconcile_history "$task" "$old_base" "$FENCE_PROFILE"
  dirty="$(wt_dirty "$wt")"
  [ -z "$dirty" ] || die "worktree $wt is dirty — commit or stash first:
$(printf '%s\n' "$dirty" | sed 's/^/  /')"
  # The remote a rebase replays onto must be the remote this task was created
  # against. Checked BEFORE the fetch, so a re-aimed URL is never contacted.
  require_recorded_origin "$task" "rebase"
  # AFTER the remote check (the remote settings get their own clearer message)
  # and BEFORE the fetch: a fetch reads `credential.helper` / `core.askPass`,
  # and `remote.<n>.uploadpack` is a program on the far side.
  require_recorded_config "$task" rebase
  old_pid="$(git show --no-ext-diff --no-textconv "$old_base" | git patch-id --stable | cut -d' ' -f1)"
  # A failed fetch used to be swallowed. It must not be: the whole point of the
  # fetch is that `$upstream` is current, and replaying onto a stale ref moves
  # this task's base onto commits the operator has not seen — silently, because
  # a rebase onto an old tip succeeds perfectly well.
  #
  # And for an `origin/<branch>` upstream the REFSPEC is written out here rather
  # than left to `remote.origin.fetch`. That setting lives in the shared
  # .git/config like the URL does, and a `git config remote.origin.fetch
  # +refs/heads/*:refs/remotes/decoy/*` makes a plain `git fetch origin` succeed
  # while updating nothing under refs/remotes/origin/ — so a forged
  # `refs/remotes/origin/main` survives the fetch intact and the rebase replays
  # onto it. `+refs/heads/<b>:refs/remotes/origin/<b>` names both ends, and the
  # '+' makes the remote's answer overwrite whatever is there. The recorded
  # `fetch` field (checked by require_recorded_origin above) refuses a changed
  # refspec outright; this makes the fetch not depend on it in the first place.
  #
  # `--upload-pack` is spelled out for the same reason `git push` spells out
  # `--receive-pack`: git keeps the FIRST `remote.<n>.uploadpack` it sees, so a
  # value in the shared .git/config outranks the GIT_CONFIG_PARAMETERS floor
  # loom exports, and this is the command that runs a program on the far side.
  if [ "$up_kind" = origin ]; then
    local fetch_spec="+refs/heads/$fetch_br:refs/remotes/origin/$fetch_br"
    git fetch -q --upload-pack=git-upload-pack origin "$fetch_spec" >&2 \
      || die "git fetch origin $fetch_spec failed, so '$upstream' may be stale — and a
rebase onto a stale upstream moves this task's base onto commits you have not
fetched. Fix the fetch (network, credentials, the remote URL) and re-run."
  else
    echo "loom: '$upstream' is a LOCAL branch — nothing was fetched (a fetch updates" >&2
    echo "loom: refs/remotes/*, never refs/heads/*), so it is exactly as current as your" >&2
    echo "loom: own last pull of it." >&2
  fi
  # Again, immediately before the replay. The fetch is a network round trip with
  # a worktree standing next to it, and a rebase runs checkout and commit for
  # every replayed commit — `filter.<d>.clean`/`.smudge`, `merge.<d>.driver` on
  # a conflict, and whatever `core.hooksPath` points at.
  require_recorded_config "$task" rebase
  # $up_ref, not $upstream, and $(branch_ref "$task"), not $br: every one of
  # these five reads is a REF LOOKUP, and both names resolve through the
  # ambiguous order described where $up_ref is set. `agent/<task>` has the same
  # problem — `refs/heads/agent/<task>` is what pin_branch_tip, the merge and
  # the push already use, and a tag or a `refs/agent/<task>` would otherwise
  # answer here instead.
  git -C "$wt" rebase "$up_ref" >&2 || die "rebase onto $upstream failed — resolve in $wt, then re-run"
  mb="$(git merge-base "$(branch_ref "$task")" "$up_ref")" \
    || die "$br and $upstream have no common ancestor after the rebase — inspect $wt"
  new_base=""
  if git merge-base --is-ancestor "$old_base" "$up_ref"; then
    # The old base already landed upstream (the plan/task commit was merged
    # by an earlier PR): nothing was replayed, the merge-base IS the base.
    new_base="$mb"
  elif [ -n "$old_pid" ]; then
    # The old base was replayed onto the upstream: find it by patch-id.
    for c in $(git rev-list --reverse "$mb..$(branch_ref "$task")"); do
      if [ "$(git show --no-ext-diff --no-textconv "$c" | git patch-id --stable | cut -d' ' -f1)" = "$old_pid" ]; then new_base="$c"; break; fi
    done
  fi
  if [ -z "$new_base" ]; then
    new_base="$mb"
    echo "loom: replayed base not found by patch-id; base set to the merge-base $(git rev-parse --short "$mb") — the reviewer may now see the plan/task commit as a change" >&2
  fi
  new_base="$(git rev-parse --verify --quiet "$new_base^{commit}")" \
    || die "the new base does not resolve — refusing to record it for $task"
  git merge-base --is-ancestor "$new_base" "$(branch_ref "$task")" \
    || die "the new base $(git rev-parse --short "$new_base") is not an ancestor of $br — refusing to
record a base this branch does not descend from. Inspect $wt, do not re-run."
  # WHAT CAME UNDER THE BASE. Everything in old_base..new_base is about to stop
  # being reviewable: it is upstream now. The fenced and hand-zone hits are
  # computed through the FULL [fence] and the FULL [hand] — a fence profile
  # releases paths for the TASK's own commits, and nobody consented to a release
  # for whatever arrived from upstream.
  #
  # The whole range is printed UNCONDITIONALLY whenever the base moves — on the
  # refusal and under `--accept-upstream` alike, hits or no hits — and it is
  # printed in full: the fenced list, the hand list, `git log --oneline`, and
  # every path those commits touch. Consent to bury commits is only consent if
  # the operator was shown what they are.
  #
  # And the CONSENT is required for any non-empty range, not only one with a
  # hit. In an active repo that fires often, and that is the intended shape
  # rather than a bug: your own commits merged upstream while the task ran are
  # exactly what goes under the base. `--accept-upstream` is a one-word "I have
  # read those" — not an override of a security rule, and not a fence question.
  history_paths "$ROOT" "$old_base" "$new_base"
  if [ "$new_base" != "$old_base" ]; then
    local buried
    buried="$(git rev-list --count "$old_base..$new_base" 2>/dev/null)" \
      || die "cannot count the commits between $(git rev-parse --short "$old_base") and
$(git rev-parse --short "$new_base") — refusing to move a base over a range loom
cannot read."
    bad_f="$(zones_py_full history-fence ${HIST_PATHS[0]+"${HIST_PATHS[@]}"})" \
      || die "cannot tell what the commits under the new base touch — refusing to guess"
    bad_h="$(zones_py_full history-hand ${HIST_PATHS[0]+"${HIST_PATHS[@]}"})" \
      || die "cannot tell which zones the commits under the new base touch — refusing to guess"
    {
      echo "loom: these commits go UNDER task $task's base — upstream, where no fence"
      echo "loom: check, no hand check and no review patch looks at them again:"
      echo ""
      # The hits first: they are the ones that ought to stop a reader.
      echo "  fenced paths:"
      if [ -n "$bad_f" ]; then printf '%s\n' "$bad_f" | sed 's/^/    /'; else echo "    (none)"; fi
      echo "  hand-zone paths:"
      if [ -n "$bad_h" ]; then printf '%s\n' "$bad_h" | sed 's/^/    /'; else echo "    (none)"; fi
      echo ""
      echo "  $buried commit(s), $(git rev-parse --short "$old_base")..$(git rev-parse --short "$new_base") ($upstream):"
      git log --oneline "$old_base..$new_base" 2>/dev/null | sed 's/^/    /'
      echo ""
      # ... and then everything, because a path in neither list is still a path
      # that stops being reviewable.
      echo "  every path those commits touch:"
      if [ "${#HIST_PATHS[@]}" -gt 0 ]; then
        printf '%s\n' "${HIST_PATHS[@]}" | sort -u | sed 's/^/    /'
      else
        echo "    (none)"
      fi
      echo ""
    } >&2
    if [ "${buried:-0}" -gt 0 ] && [ -z "$accept" ]; then
      # Put the branch back first. The rebase has already replayed it, and a
      # branch left sitting on the refused upstream carries those commits in
      # `old_base..tip` — so every later command, INCLUDING the
      # `--accept-upstream` re-run, would die on the branch's own history
      # instead. A refusal has to leave the task exactly as it found it. The
      # tree was verified clean above, so this discards nothing.
      git -C "$wt" reset --hard "$PINNED_TIP" >/dev/null 2>&1 \
        || echo "loom: WARNING: could not put $br back at $PINNED_TIP after refusing this
rebase — the branch is left on $upstream. Inspect $wt." >&2
      die "the $buried commit(s) listed above would go UNDER task $task's base, where no
fence check, no hand check and no review patch looks at them again. loom does not
bury commits without being told to — including commits that touch nothing fenced
and nothing in [hand], because 'it touches nothing I check' is not the same
statement as 'it is nothing'. 'origin/main' is one 'git update-ref' away from any
commit, and unlike your own 'main' a moved 'origin/main' is visible nowhere.
Nothing changed: the base was not moved and the branch is back at
$(git rev-parse --short "$PINNED_TIP"). Read those commits, then either accept
them under the base:
  loom rebase $task $upstream${FLAG_PROFILE:+ --fence-profile $FLAG_PROFILE} --accept-upstream
or throw the task away:  loom drop $task"
    fi
    [ -z "$accept" ] || echo "loom: --accept-upstream: the commits above are accepted under the base, unreviewed." >&2
  fi
  # `reviewed` is deliberately cleared: the branch has been rewritten, so the
  # sha a reviewer read no longer exists on it. `loom land` will ask for a fresh
  # `loom check`, which is the honest answer.
  state_update "$task" "base=$new_base" "branch=$br" "reviewed="
  echo "loom: $br rebased onto $upstream; base $(git rev-parse --short "$old_base") -> $(git rev-parse --short "$new_base")"
}

cmd_drop() {
  local task="" keep="" a rem=""
  local wt br
  for a in "$@"; do
    case "$a" in
      --keep-branch) keep=yes ;;
      -*)            die "loom drop: unknown flag '$a' — usage: loom drop <task-id> [--keep-branch]" ;;
      *)             if [ -z "$task" ]; then task="$a"; else die "loom drop: unexpected argument '$a'"; fi ;;
    esac
  done
  [ -n "$task" ] || die "usage: loom drop <task-id> [--keep-branch]"
  # The id, validated BEFORE anything is removed. state_file refuses '.', '..'
  # and anything with a '/' in it — and it used to be called at the END, so a
  # bad id removed a worktree, then died, and the operator saw a refusal after
  # the destruction rather than instead of it.
  state_file "$task" > /dev/null
  wt="$(wt_path "$task")"; br="$(branch_of "$task")"
  # --keep-branch asks origin whether the kept branch is already there, and that
  # `git ls-remote` is a NETWORK CALL to whatever `origin` says now. Whether that
  # is the remote the task was created against is a question only the OPERATOR
  # RECORD can answer — and `state_rm` below deletes it. So the question is asked
  # HERE, before anything is removed; the old order deleted the record and then
  # reached out to a remote nothing could vouch for.
  #
  # A remote that does not match is not a reason to refuse the DROP, though.
  # `loom drop && loom new` is the fix this whole system points at, including for
  # a re-aimed origin, so a drop that died on one would be a trap with no way
  # out. require_recorded_origin runs in a subshell: its refusal is printed and
  # the remote is simply not contacted.
  local where="" vouch=""
  if [ -n "$keep" ]; then
    if ! git remote get-url origin >/dev/null 2>&1; then
      where="(no 'origin' remote)"
    elif ! vouch="$( require_recorded_origin "$task" "ask origin about" 2>&1 )"; then
      printf '%s\n' "$vouch" | sed 's/^/loom: /' >&2
      where="(NOT asked: the 'origin' remote is not the one this task was created against)"
    elif ! rem="$(git ls-remote --upload-pack=git-upload-pack --heads origin "$br" 2>/dev/null)"; then
      where="(could not reach origin to check)"
    elif [ -n "$rem" ]; then
      where="(it is on origin)"
    else
      where="— NOT on origin yet: git push -u origin $br"
    fi
  fi
  # The worktree must be OURS before git is asked to remove it, and before the
  # record that says what it was goes away. git refuses to remove a worktree it
  # does not own, and the removal below is written `|| true` — so a `$wt/.git`
  # rewritten to point at another repository used to end in "dropped" printed
  # over a directory that was still there, with whatever a fence profile had
  # released still in it. Checked only when the directory exists: dropping a
  # task whose tree is already gone is ordinary, and it is how a half-built
  # `loom new` is cleaned up.
  if [ -d "$wt" ]; then require_wt_is_ours "$wt"; fi
  git worktree remove "$wt" --force 2>/dev/null || true
  # ... and the removal is not taken on trust either. `--force` still fails on
  # a path git cannot unlink (a permission, a mount, a file another process
  # holds), and `|| true` above swallows exactly that. A released path left on
  # disk is the thing `loom drop` exists to prevent, so say what is left and
  # stop — before the record that explains why it is there is deleted.
  if [ -e "$wt" ]; then
    { echo "loom: the worktree for $task is STILL on disk after 'git worktree remove --force':"
      echo "  $wt"
      echo "loom: what remains:"
      find "$wt" -maxdepth 2 2>/dev/null | head -20 | sed 's|^|loom:   |' || true
    } >&2
    die "nothing was dropped for $task: its worktree is still there, so its operator
record and its branch have been left alone too — the record is what says what
that directory is. Find out why git could not remove it, clear it by hand, then
re-run:  loom drop $task"
  fi
  # The operator record goes with the worktree, --keep-branch or not: it names
  # a base, a profile and a pinned git config for a task that no longer has a
  # tree, and the next `loom new <task>` writes a fresh one. A kept branch keeps
  # its commits, not its record — `loom check` on it says so and points at
  # `loom new`.
  state_rm "$task"
  if [ -n "$keep" ]; then
    echo "loom: dropped worktree for $task and its operator record — branch $br kept $where"
  else
    git branch -D "$br" 2>/dev/null || true
    echo "loom: dropped $task (worktree, branch and operator record)"
  fi
}

# The explicit operator command for the REPOSITORY's config baseline — the one
# `loom plan` and `loom scout` are judged against, and the one a repository with
# no tasks at all would otherwise never have.
#
# The grammar is the same consent shape as everywhere else in this file:
#
#   loom pin-config                  no baseline  -> record one, and say what
#                                                   was recorded
#                                    unchanged    -> say so, exit 0
#                                    changed      -> print the diff and REFUSE
#   loom pin-config --accept-config  changed      -> print the diff and re-record
#
# So the flag means what it means everywhere else: loom shows you what moved and
# you, not loom, decide it is yours. `--fence-profile` means nothing here (there
# is no task and no worktree) and is refused rather than ignored.
cmd_pin_config() {
  scan_fence_flag "$@"
  local a f now rec changed
  for a in ${FLAG_ARGS[0]+"${FLAG_ARGS[@]}"}; do
    die "loom pin-config: unexpected argument '$a' — usage: loom pin-config [--accept-config]"
  done
  [ -z "$FLAG_PROFILE" ] || die "loom pin-config: --fence-profile means nothing here. This command records the
REPOSITORY's git config baseline, which is not a task's and not a worktree's."
  repo_config_read > /dev/null            # a malformed baseline dies here
  rec="$(repo_config_read)"
  f="$(config_snapshot)"; cfg_track "$f"
  now="$(config_digest_of "$f")"
  if [ -n "$rec" ] && [ "$rec" = "$now" ]; then
    rm -f "$f"
    echo "loom: this repository's git config baseline is already current" >&2
    echo "  $(repo_config_file)"
    return 0
  fi
  if [ -n "$rec" ]; then
    changed="$(config_py diff "$(repo_config_sidecar)" "$f" 2>&1)" \
      || changed="  (the recorded list is unreadable: $(repo_config_sidecar))"
    [ -n "$changed" ] || changed="  (the digest moved but the recorded list did not)"
    if [ -z "$FLAG_ACCEPT_CONFIG" ]; then
      rm -f "$f"
      die "this repository's git config is not the one its baseline was recorded against:
$changed
Read those lines before you accept them: core.hooksPath, filter.<d>.clean/.smudge,
merge.<d>.driver, credential.helper, core.askPass, gpg.program, pager.<cmd>,
core.attributesFile and include.path/includeIf.* each name a PROGRAM git runs in
your session. Then re-record it deliberately:
  loom pin-config --accept-config"
    fi
    {
      echo "loom: --accept-config: this repository's git config is not the one its"
      echo "loom: baseline was recorded against. What changed:"
      printf '%s\n' "$changed"
      echo "loom: re-recording it as the baseline. loom vouches for none of it — you do."
    } >&2
  fi
  repo_config_write "$f"
  rm -f "$f"
  echo "loom: recorded this repository's git config baseline" >&2
  echo "  $(repo_config_file)"
  config_summary  "$(repo_config_sidecar)"
  config_programs "$(repo_config_sidecar)"
}

# Each agent worktree, annotated with the fence profile in its OPERATOR RECORD
# — a reminder of the flag every command for that task needs, not a claim about
# what is on disk (`loom run` reconciles the tree; the record only ever refuses).
cmd_ls() {
  local line br t prof bad found=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    found=yes
    br="$(printf '%s' "$line" | sed -n 's/.*\[\(.*\)\].*/\1/p')"
    prof=""; bad=""
    # The record's SHAPE, judged here rather than swallowed. This used to be
    # `state_read … 2>/dev/null || true`, which turned "this record is not one
    # loom wrote" — a duplicated field, an unknown key, a line that is not
    # <key>=<value>, the exact shapes a forged `reviewed=` takes — into a blank
    # profile column and a listing that read as normal. `loom ls` is the one
    # command whose job is to show the operator what state exists, so a record
    # it cannot read has to be the loudest line on the screen.
    #
    # In a SUBSHELL, because require_sane_record dies (exit), and the listing
    # must go on to the next worktree rather than stop at the first bad record.
    # A task with NO record at all is not an error here: state_read answers ""
    # for a missing file, and every command that needs one refuses on its own.
    case "$br" in
      agent/*)
        t="${br#agent/}"
        if ( require_sane_record "$t" ) >/dev/null 2>&1; then
          prof="$(state_read "$t" profile)"
        else
          bad=yes
        fi ;;
    esac
    if [ -n "$bad" ]; then
      printf '%s  *** OPERATOR RECORD UNREADABLE — loom will refuse every command for this task ***\n' "$line"
      printf '    %s\n' "$(state_file "${br#agent/}")"
      printf '    read it, then:  loom drop %s && loom new %s\n' "${br#agent/}" "${br#agent/}"
    elif [ -n "$prof" ]; then printf '%s  fence-profile:%s\n' "$line" "$prof"
    else                    printf '%s\n' "$line"; fi
    # Both roots: a profiled worktree is a sibling of the unprofiled root, not
    # a child of it, so one -F pattern would miss half the list.
  done < <(git worktree list | grep -F -e "$WT_ROOT/" -e "$WT_ROOT_PROFILED/" || true)
  [ -n "$found" ] || echo "(no agent worktrees)"
}

# -------------------------------------------------------------------- agents
cmd_plan() {
  local headless="" topic
  [ "${1:-}" = "-p" ] && { headless=yes; shift; }
  topic="${*:?usage: loom plan [-p] \"<topic>\"}"
  # BEFORE the architect runs, and in THIS shell so the refusal is the
  # command's own. The architect runs in $ROOT — your own checkout — and it is
  # a model launch with no task behind it, so there is no task pin to read; the
  # REPOSITORY's baseline is what it is judged against. The `claude` leg below
  # is launched directly rather than through run_role, so this cannot live only
  # in run_role.
  CONFIG_CMD="plan"
  require_recorded_config_repo plan
  mkdir -p "$AGENTS_DIR/plans" "$AGENTS_DIR/tasks" "$AGENTS_DIR/reviews" "$AGENTS_DIR/decisions"
  local prompt="Design: $topic. For codebase questions run 'loom scout \"<question>\"' \
in the shell instead of reading source files yourself, and treat uncited scout \
claims as unknown. Write a plan to .agents/plans/ (next number, kebab-slug) \
following .agents/PLAN_TEMPLATE.md, and one task file per non-HAND task in \
.agents/tasks/ following .agents/TASK_TEMPLATE.md. Respect .agents/zones.toml: \
hand-zone work becomes a tutor-mode task (doc-comment contract, signatures with \
todo!(), a failing test — never the implementation). Do not create or edit any \
file outside .agents/."
  local first; first="$(pick_model architect)"
  if [ "$first" = claude-sub ] && [ -z "$headless" ]; then
    echo "loom: architect on your Claude subscription (interactive). Ctrl-D to end."
    claude --append-system-prompt "$(cat "$PROMPTS_DIR/architect.md")" "$prompt" \
      || { echo "loom: claude exited non-zero — if rate-limited, try: eval \"\$(loom tier lean)\" && loom plan -p \"$topic\"" >&2; return 1; }
  else
    run_role architect "$ROOT" "$prompt"
  fi
}

# Scout normally reads your working tree directly. With a fence configured it
# must not, so it gets a persistent detached mirror at $WT_ROOT/_scout with the
# fenced paths removed, reset to the current HEAD on every call (cheap). It
# stays under the UNPROFILED root on purpose: the mirror is shared by every
# task and always carries the full fence, and nothing that runs against it —
# including opencode, whose external_directory grant is this workdir — may be
# given a directory that contains a profiled worktree.
# The ONE scope the repository baseline cannot cover, and the mirror's own:
# `$GITCOMMON/worktrees/_scout/config.worktree`. It is in the shared .git like
# every other worktree's, and `git -C <the mirror> config --worktree <k> <v>`
# writes it — one command from anything that has ever run with the mirror as
# its cwd, which is every scout run there has ever been.
#
# FAIL-CLOSED, and the choice is deliberate. The other option was to delete and
# recreate the scope on every call, which neutralises the plant just as well and
# tells nobody that something wrote there. loom REFUSES instead: a scout mirror
# whose private scope has grown a key is a fact about this repository the
# operator has to see, and silent self-healing is the shape that hides it.
#
# The allowlist is what git's own sparse-checkout machinery writes at worktree
# scope across the versions loom supports — `core.sparseCheckout` (measured,
# git 2.34), plus the cone and index keys newer git adds beside it. Nothing
# else; loom writes nothing else there.
scout_mirror_config_check() { # scout_mirror_config_check <mirror>
  local wt="$1" rec k bad=""
  while IFS= read -r -d '' rec; do
    k="${rec%%$'\n'*}"
    case "$k" in
      core.sparsecheckout|core.sparsecheckoutcone|index.sparse) ;;
      "") ;;
      *) bad="$bad
  $k" ;;
    esac
  done < <(git -C "$wt" config --worktree --list --null 2>/dev/null || true)
  [ -z "$bad" ] || die "the scout mirror has keys in its OWN worktree-scope config that loom
did not write:$bad
  $wt
  $GITCOMMON/worktrees/_scout/config.worktree
That scope is read for every git command run in the mirror and for nothing
else, so it is invisible to the repository config baseline — and the mirror is
where 'loom scout' does a working-tree update (sparse-checkout, clean, reset),
which is what runs a planted filter.<d>.smudge. loom writes only
core.sparseCheckout there. Read it, then clear it:
  git -C $wt config --worktree --list
  rm -f $GITCOMMON/worktrees/_scout/config.worktree
or remove the mirror entirely and let the next scout rebuild it:
  git worktree remove --force $wt"
}

scout_root() {
  local wt="$WT_ROOT/_scout" head
  # BEFORE the mirror is touched at all, and before the `has_fence` shortcut,
  # because both legs end in a model launch. `fence_apply` -> `sparse-checkout
  # set`, the `clean` and the `reset --hard`/`checkout` below are WORKING-TREE
  # UPDATES, and a working-tree update runs the SMUDGE side of whatever
  # `filter.<d>` a `.gitattributes` in the mirror selects — with the driver
  # read out of the SHARED .git/config, one `git config` from inside any
  # agent's worktree. The scout has no task, so the REPOSITORY's baseline is
  # what answers here.
  require_recorded_config_repo scout
  has_fence || { echo "$ROOT"; return 0; }
  head="$(git rev-parse HEAD)"
  mkdir -p "$(dirname "$wt")"
  if [ -d "$wt" ]; then
    require_wt_is_ours "$wt"
    scout_mirror_config_check "$wt"
    # The mirror is DISPOSABLE, and it is shared by every task and every
    # provider — which is the whole reason it must not carry anything across a
    # call. `reset --hard` does not touch an untracked file, so a previous
    # run's scratch, or a copy of a fenced file made with
    # `git show HEAD:core/lib.rs > notes.txt`, simply sat there for the next
    # provider to read. Clean first (`-x` ignored files too, `-ff` a nested
    # git dir), then reset, then re-apply the fence.
    git -C "$wt" clean -xdff >&2 \
      || die "cannot clean the scout mirror $wt — remove it and retry"
    fence_apply "$wt"
    git -C "$wt" reset --hard "$head" >&2 \
      || die "scout mirror is wedged: remove $wt and retry"
  else
    git worktree prune
    assert_wt_parent "$wt" "$WT_ROOT"
    git worktree add --detach --no-checkout "$wt" "$head" >&2
    assert_wt_under "$wt" "$WT_ROOT"
    require_wt_is_ours "$wt"
    fence_apply "$wt"
    git -C "$wt" checkout >&2
    # Creating the mirror is the one thing `loom scout` writes to the SHARED
    # config on your behalf: the first `git sparse-checkout init` in a
    # repository adds `extensions.worktreeConfig` to `.git/config` (measured,
    # git 2.34). That is a local-scope change, so without this line the very
    # next `loom scout` would refuse a change loom itself made — the same
    # re-pin, for the same reason, that `loom new` does at the end of its own
    # worktree setup.
    #
    # It is safe to sit here and nowhere else: the baseline was CHECKED at the
    # top of this function, before anything was created, so a config an agent
    # moved is refused above and never reaches this line. Only loom's own
    # writes (and, in the narrow window between the two, a concurrent process —
    # the same window `loom new` has) are re-recorded.
    repo_config_repin
  fi
  fence_verify "$wt"
  echo "$wt"
}

cmd_scout() {
  local q="${*:?usage: loom scout \"<question>\"}"
  # The scout mirror is shared by every task, so no profile ever applies to it:
  # it stays at the FULL fence, and the profile's provider rule therefore never
  # has to cover the (repo-wide, cheap) scout chain.
  FENCE_PROFILE=""; FENCE_RELEASED=""; unset LOOM_FENCE_PROFILE
  # No task, so run_role's per-attempt check is the REPOSITORY baseline's; this
  # is the name its refusal uses. scout_root reads the baseline first, before
  # it touches the mirror at all.
  CONFIG_CMD="scout"
  local wd; load_fence; wd="$(scout_root)"
  run_role scout "$wd" "$q$(fence_note)"
}

cmd_gate() { exec "$AGENTS_DIR/gate.sh"; }

cmd_tier() {
  local t="${1:?usage: loom tier lean|standard|deep}"
  case "$t" in lean|standard|deep) ;; *) die "unknown tier: $t" ;; esac
  echo "export LOOM_TIER=$t"
  echo "# apply with: eval \"\$(loom tier $t)\"" >&2
}

# -------------------------------------------------------------------- doctor
models_endpoint() {
  case "$1" in
    zai)             echo "https://api.z.ai/api/paas/v4/models" ;;
    zai-coding-plan) echo "https://api.z.ai/api/coding/paas/v4/models" ;;
    moonshotai) echo "https://api.moonshot.ai/v1/models" ;;
    deepseek)   echo "https://api.deepseek.com/models" ;;
  esac
}

all_referenced_models() {
  local t r
  for t in lean standard deep; do
    for r in architect scout implementer reviewer; do
      TIER=$t models_for "$r"
    done
  done | tr ' ' '\n' | grep -vE '^(claude|codex)-sub$' | grep . | sort -u
  # plus whatever opencode.json pins
  [ -f "$ROOT/.opencode/opencode.json" ] && have jq && \
    jq -r '.. | .model? // empty' "$ROOT/.opencode/opencode.json" | sort -u
}

cmd_doctor() {
  local ok=0 warn=0 bad=0
  say()  { printf '  %-8s %s\n' "$1" "$2"; }
  pass() { say "OK" "$1"; ok=$((ok+1)); }
  note() { say "WARN" "$1"; warn=$((warn+1)); }
  fail() { say "FAIL" "$1"; bad=$((bad+1)); }

  echo "binaries"
  for b in git python3 claude opencode; do
    have "$b" && pass "$b ($(command -v "$b"))" || fail "$b missing"
  done
  for b in tmux jq curl codex; do have "$b" && pass "$b" || note "$b missing (optional)"; done
  if python3 -c 'import tomllib' 2>/dev/null; then
    pass "python3 tomllib (>=3.11)"
  elif python3 -c 'import tomli' 2>/dev/null; then
    pass "python3 tomli backport ($(python3 -c 'import sys;print("python %d.%d"%sys.version_info[:2])'))"
  else
    fail "python >=3.11 or 'pip install tomli' required for zones"
  fi

  echo "provider keys (opencode built-ins; no ANTHROPIC_API_KEY by design)"
  if [ -f "$LOOM_ENV" ]; then
    # GNU first: BSD's -f is GNU's "file SYSTEM status", which SUCCEEDS on Linux
    # and prints a block of filesystem stats instead of a mode. GNU's -c fails
    # cleanly on BSD, so this order is the one that works on both.
    local perms; perms="$(stat -c '%a' "$LOOM_ENV" 2>/dev/null || stat -f '%Lp' "$LOOM_ENV" 2>/dev/null)"
    if [ "$perms" = "600" ]; then pass "key file $LOOM_ENV (0600)"
    else note "key file $LOOM_ENV mode is $perms — run: chmod 600 $LOOM_ENV"; fi
    grep -q 'PASTE-YOUR' "$LOOM_ENV" && note "key file still has placeholder values"
  else
    note "no key file at $LOOM_ENV (loom sources it if present)"
  fi
  [ -n "${ZHIPU_API_KEY:-}" ]    && pass "ZHIPU_API_KEY set (Z.ai)"      || note "ZHIPU_API_KEY not set (ZAI_API_KEY also accepted)"
  [ -n "${MOONSHOT_API_KEY:-}" ] && pass "MOONSHOT_API_KEY set"          || note "MOONSHOT_API_KEY not set"
  [ -n "${DEEPSEEK_API_KEY:-}" ] && pass "DEEPSEEK_API_KEY set"          || note "DEEPSEEK_API_KEY not set"
  [ -n "${ANTHROPIC_API_KEY:-}" ] && note "ANTHROPIC_API_KEY is set — this system never uses it; unset to be safe"
  if have codex; then
    local cauth="${CODEX_HOME:-$HOME/.codex}/auth.json"
    if [ -f "$cauth" ]; then
      pass "codex auth.json present ($cauth) — codex-sub usable"
      if [ -n "$(find "$cauth" -mtime +9 2>/dev/null)" ]; then
        note "codex auth.json last changed >9 days ago — the subscription token refreshes in place on use, so run 'codex login' only if codex exec fails"
      fi
    elif [ -n "${CODEX_API_KEY:-}${OPENAI_API_KEY:-}" ]; then
      pass "codex on CODEX_API_KEY/OPENAI_API_KEY (per-token, not the subscription)"
    else
      note "codex is installed but has no $cauth and no CODEX_API_KEY/OPENAI_API_KEY — run: codex login"
    fi
  fi

  echo "project"
  [ -x "$AGENTS_DIR/gate.sh" ] && pass ".agents/gate.sh executable" || fail ".agents/gate.sh missing or not executable"
  if [ -f "$AGENTS_DIR/zones.toml" ]; then
    local nfence orphan odd fpaths perr
    perr="$(zones_py parse 2>&1 >/dev/null)" || perr="${perr:-unreadable}"
    if [ -z "$perr" ]; then
      pass "zones.toml parses"
      if fpaths="$(zones_py fence-paths 2>&1)"; then
        nfence="$(printf '%s\n' "$fpaths" | grep -c . || true)"
        if [ "${nfence:-0}" -gt 0 ]; then
          pass "fence: $nfence pattern(s) removed from agent worktrees"
          while IFS= read -r orphan; do
            [ -n "$orphan" ] && note "fence pattern matches no tracked file (typo?): $orphan"
          done < <(zones_py fence-orphans 2>/dev/null || true)
          while IFS= read -r odd; do
            [ -n "$odd" ] && note "fence pattern is not the plain 'subsystem/**' form: $odd — sparse checkout reads it as gitignore, loom zone as fnmatch (ARCHITECTURE.md § 5, caveat 3)"
          done < <(zones_py fence-shape 2>/dev/null || true)
        fi
      else
        fail "${fpaths#loom: }"
      fi
      # Fence profiles: what each one releases, to whom, and whether the
      # default chains could actually run under it.
      local pname pprov prel role m mp bad
      while IFS=$'\t' read -r pname pprov prel; do
        [ -n "$pname" ] || continue
        pass "fence profile '$pname': releases ${prel//,/ } to providers ${pprov//,/ }"
        for role in implementer reviewer; do
          bad=""
          # Same `set -f` bracket as profile_provider_guard and candidates: a
          # chain is a space-separated list, and $LOOM_MODELS_<role> is data
          # that must not glob against $ROOT.
          set -f
          # shellcheck disable=SC2086  # deliberate word split; globbing is off
          for m in $(models_for "$role"); do
            mp="$(provider_of "$m")"
            case ",$pprov," in *",$mp,"*) ;; *) bad="$bad $m" ;; esac
          done
          set +f
          [ -n "$bad" ] && note "fence profile '$pname': the $role chain at tier $TIER reaches providers this profile does not allow:$bad — a task on this profile needs LOOM_MODELS_$role"
        done
      done < <(zones_py profiles 2>/dev/null || true)
    else
      fail "zones.toml unreadable (agent/* commits are BLOCKED until this is fixed): ${perr#loom: }"
    fi
  else note "no zones.toml — everything defaults to assist"; fi
  # A hook written before the aw→loom rename calls `aw guard`, and its own
  # "not on PATH" branch exits 0 — so the hand-zone guard is silently disarmed
  # rather than broken. That has to read as a failure, not a warning.
  local hookf; hookf="$(hook_path)"
  if [ -x "$hookf" ]; then
    if grep -q 'aw guard' "$hookf"; then
      fail "pre-commit hook still calls the pre-rename 'aw' dispatcher — with aw off PATH the hand-zone guard skips silently. Fix with: loom install-hooks"
    else
      pass "pre-commit hook installed"
    fi
  else
    note "pre-commit hook not installed (loom install-hooks)"
  fi
  if [ -x "$hookf.pre-loom" ]; then
    pass "pre-existing pre-commit hook chained (pre-commit.pre-loom)"
  fi
  # install.sh never overwrites these, so a pre-rename repo keeps `aw` in them;
  # the VS Code tasks and the AGENTS.md scout line actually invoke it.
  local stale_f stale_list=""
  for stale_f in .vscode/tasks.json AGENTS.md .opencode/opencode.json .agents/zones.toml; do
    if [ -f "$ROOT/$stale_f" ] && grep -qw aw "$ROOT/$stale_f"; then stale_list="$stale_list $stale_f"; fi
  done
  if [ -n "$stale_list" ]; then note "still say the pre-rename 'aw' command — edit by hand:$stale_list"; fi
  if [ "${LOOM_LAND:-merge}" = pr ]; then
    have gh && pass "LOOM_LAND=pr — gh on PATH ($(command -v gh)); loom prints the command, never runs it" \
             || note "LOOM_LAND=pr — gh not on PATH; open the PR from the printed branch by hand"
  fi

  echo "model IDs (chains + opencode.json)"
  local oc_models=""
  have opencode && oc_models="$(cd "$ROOT" && opencode models 2>/dev/null || true)"
  local catalog="${XDG_CACHE_HOME:-$HOME/.cache}/loom/models-dev.json"
  mkdir -p "$(dirname "$catalog")"
  if [ ! -s "$catalog" ] || [ -n "$(find "$catalog" -mtime +7 2>/dev/null)" ]; then
    curl -sS --max-time 20 https://models.dev/api.json -o "$catalog" 2>/dev/null || true
  fi
  local m prov id key ep live
  for m in $(all_referenced_models | sort -u); do
    prov="${m%%/*}"; id="${m#*/}"
    key="$(key_for_provider "$prov")"
    if [ -n "$key" ] && [ -n "$oc_models" ] && ! echo "$oc_models" | grep -qx "$m"; then
      fail "$m unknown to YOUR opencode — declare it under provider.$prov.models in .opencode/opencode.json, or update opencode"
      continue
    fi
    ep="$(models_endpoint "$prov")"
    if [ -n "$key" ] && [ -n "$ep" ] && have jq; then
      live="$(curl -sS --max-time 15 -H "Authorization: Bearer $key" "$ep" 2>/dev/null | jq -r '.data[].id' 2>/dev/null || true)"
      if [ -n "$live" ]; then
        echo "$live" | grep -qx "$id" && pass "$m (live: your account can call it)" \
          || fail "$m NOT in $prov's live /models — pick from: $(echo "$live" | tr '\n' ' ' | cut -c1-120)..."
        continue
      fi
    fi
    if [ -s "$catalog" ] && have jq; then
      jq -e --arg p "$prov" --arg i "$id" '.[$p].models[$i] // empty' "$catalog" >/dev/null 2>&1 \
        && pass "$m (models.dev catalog; set a key for the live check)" \
        || fail "$m not in models.dev catalog — stale ID?"
    else
      note "$m unverified (no key, no catalog) — run: opencode models"
    fi
  done

  echo ""
  echo "loom doctor: $ok ok, $warn warnings, $bad failures"
  [ "$bad" -eq 0 ]
}

cmd_install_hooks() {
  local hook prev; hook="$(hook_path)"; prev="$hook.pre-loom"
  # Under core.hooksPath the hook may live in a tracked directory (.githooks/):
  # that file is the team's, and rewriting it would ride into the next commit.
  # Refuse and say what to add by hand. A RELATIVE hooksPath is also
  # per-worktree, so agent worktrees only see a hook that is committed.
  if git ls-files --error-unmatch "$hook" >/dev/null 2>&1; then
    die "$hook is tracked by git (core.hooksPath) — add this line to it by hand instead: loom guard || exit \$?"
  fi
  case "$(git config core.hooksPath 2>/dev/null || true)" in
    "") ;;
    /*) echo "loom: note — core.hooksPath is set; installing the guard at $hook" >&2 ;;
    *)  echo "loom: note — core.hooksPath is relative, so agent worktrees will only run this hook once it is committed: $hook" >&2 ;;
  esac
  mkdir -p "$(dirname "$hook")"
  # Never silently eat somebody else's hook: move it aside and chain to it.
  # Re-running is a no-op because our own hook carries the marker string.
  if [ -e "$hook" ] && ! grep -q 'Loom hand-zone guard' "$hook"; then
    [ -e "$prev" ] && die "$hook is not Loom's and $prev already exists — merge them by hand, then re-run"
    mv "$hook" "$prev"
    echo "loom: existing pre-commit hook moved to $prev (it still runs, after the guard)"
    [ -x "$prev" ] || echo "loom: note — $prev is not executable, so it stays inert (as it was)"
  fi
  cat > "$hook" << 'HOOK'
#!/usr/bin/env bash
# Loom hand-zone guard. Logic lives in `loom guard` so it stays in one place.
# Any hook that was here before is preserved as pre-commit.pre-loom and runs
# after the guard, so installing Loom never disables an existing hook.
if command -v loom >/dev/null 2>&1; then
  loom guard || exit $?
else
  echo "pre-commit: loom not on PATH — hand-zone guard skipped" >&2
fi
prev="$(dirname "$0")/pre-commit.pre-loom"
[ -x "$prev" ] && exec "$prev" "$@"
exit 0
HOOK
  chmod +x "$hook"
  echo "loom: installed $hook"
}

# ------------------------------------------------------------------ dispatch
case "${1:-}" in
  new)    shift; cmd_new "$@" ;;
  run)    shift; cmd_run "$@" ;;
  check)  shift; cmd_check "$@" ;;
  loop)   shift; cmd_loop "$@" ;;
  diff)   shift; cmd_diff "$@" ;;
  land)   shift; cmd_land "$@" ;;
  drop)   shift; cmd_drop "$@" ;;
  rebase) shift; cmd_rebase "$@" ;;
  ls)     shift; cmd_ls "$@" ;;
  plan)   shift; cmd_plan "$@" ;;
  scout)  shift; cmd_scout "$@" ;;
  gate)   shift; cmd_gate "$@" ;;
  zone)   shift; cmd_zone "$@" ;;
  pin-config) shift; cmd_pin_config "$@" ;;
  tier)   shift; cmd_tier "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  guard)  shift; cmd_guard "$@" ;;
  install-hooks) shift; cmd_install_hooks "$@" ;;
  ""|-h|--help|help) awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$SELF" ;;
  *) die "unknown command '$1' — try: loom help" ;;
esac
